pkgname=ps4-homebrew-libsodium
pkgver=1.0.19
pkgrel=1
pkgdesc='A modern, portable, easy to use crypto library'
arch=('any')
url='https://libsodium.org'
license=('custom:ISC')
options=(!strip !libtool staticlibs)
source=("https://download.libsodium.org/libsodium/releases/libsodium-$pkgver.tar.gz")
sha256sums=('018d79fe0a045cca07331d37bd0cb57b2e838c51bc48fd837a1472e50068bbea')
makedepends=('ps4-homebrew-sdk')
groups=('ps4-homebrew-dev')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd libsodium-stable

    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--enable-static --disable-shared
    ${MAKE}
}


package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd libsodium-stable

    export DESTDIR="${pkgdir}/${SYSROOT}"
    make install
}
