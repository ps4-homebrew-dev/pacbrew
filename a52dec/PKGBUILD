pkgname=ps4-homebrew-a52dec
pkgver=0.8.0
pkgrel=1
pkgdesc='Library for decoding ATSC A/52 (AC-3) audio streams'
arch=('any')
url='https://git.adelielinux.org/community/a52dec/'
license=('GPL-2.0-or-later')
source=("https://distfiles.adelielinux.org/source/a52dec/a52dec-$pkgver.tar.gz")
sha256sums=('03c181ce9c3fe0d2f5130de18dab9bd8bc63c354071515aa56983c74a9cffcc9')
options=(!strip !libtool staticlibs)
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-openlibm')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi

    cd a52dec-$pkgver
    autoreconf -fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd a52dec-$pkgver

    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--enable-static --disable-shared \
		--disable-oss
    ${MAKE}
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd a52dec-$pkgver

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} install
    install -Dm644 -t "${DESTDIR}/${PREFIX}/include/a52dec/" liba52/a52_internal.h

}
