+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef __PS4__
+
+#include <dlfcn.h>
+
+#include "SDL_error.h"
+
+#include "SDL_ps4.h"
+
+#define PS4_USER_SERVICE_ERROR_ALREADY_INITIALIZED 0x80960003
+
+extern int sceSysmoduleLoadModule(Uint16 id);
+extern int sceSysmoduleLoadModuleInternal(Uint32 id);
+extern int scePadInit(void);
+
+/* The SDK links a program against stubs of the system libraries it calls,
+   and the program's crt loads them when it starts. Libraries the SDK has no
+   stubs for (audio out, the keyboard, the IME dialog) are loaded here, as
+   the crt would: libSceSysmodule loads the module and what it needs, and
+   dlopen() finds the module that is then loaded, by its file name, to give
+   a handle to look its functions up in. */
+void *PS4_LoadSystemModule(Uint32 sysmodule_id, const char *filename)
+{
+    void *handle;
+    int err;
+
+    if (sysmodule_id & 0x80000000) {
+        err = sceSysmoduleLoadModuleInternal(sysmodule_id);
+    } else {
+        err = sceSysmoduleLoadModule((Uint16)sysmodule_id);
+    }
+    if (err < 0) {
+        SDL_SetError("Couldn't load %s: sceSysmoduleLoadModule: 0x%08x",
+                     filename, (unsigned)err);
+        return NULL;
+    }
+
+    handle = dlopen(filename, RTLD_NOW | RTLD_LOCAL);
+    if (!handle) {
+        const char *reason = dlerror();
+        SDL_SetError("Couldn't load %s: %s", filename,
+                     reason ? reason : "dlopen() failed");
+        return NULL;
+    }
+
+    return handle;
+}
+
+void *PS4_LoadFunction(void *module, const char *name)
+{
+    void *symbol;
+
+    if (!module) {
+        SDL_SetError("Couldn't find %s: the library is not loaded", name);
+        return NULL;
+    }
+
+    symbol = dlsym(module, name);
+    if (!symbol) {
+        SDL_SetError("Couldn't find %s", name);
+    }
+    return symbol;
+}
+
+int PS4_InitUserService(void)
+{
+    int err = sceUserServiceInitialize(NULL);
+
+    if (err != 0 && (unsigned)err != PS4_USER_SERVICE_ERROR_ALREADY_INITIALIZED) {
+        return SDL_SetError("sceUserServiceInitialize: 0x%08x", (unsigned)err);
+    }
+    return 0;
+}
+
+int PS4_GetForegroundUser(void)
+{
+    PS4_LoginUserIdList users;
+    int user_id = PS4_USER_ID_INVALID;
+    int i;
+
+    if (PS4_InitUserService() < 0) {
+        return PS4_USER_ID_INVALID;
+    }
+
+    if (sceUserServiceGetForegroundUser(&user_id) == 0 && user_id != PS4_USER_ID_INVALID) {
+        return user_id;
+    }
+    if (sceUserServiceGetInitialUser(&user_id) == 0 && user_id != PS4_USER_ID_INVALID) {
+        return user_id;
+    }
+    if (sceUserServiceGetLoginUserIdList(&users) == 0) {
+        for (i = 0; i < PS4_MAX_LOGIN_USERS; i++) {
+            if (users.user_id[i] != PS4_USER_ID_INVALID) {
+                return users.user_id[i];
+            }
+        }
+    }
+
+    return PS4_USER_ID_INVALID;
+}
+
+int PS4_InitPad(void)
+{
+    static SDL_bool initialized = SDL_FALSE;
+    int err;
+
+    if (initialized) {
+        return 0;
+    }
+
+    if (PS4_InitUserService() < 0) {
+        return -1;
+    }
+
+    err = scePadInit();
+    if (err != 0) {
+        return SDL_SetError("scePadInit: 0x%08x", (unsigned)err);
+    }
+    initialized = SDL_TRUE;
+    return 0;
+}
+
+#endif /* __PS4__ */
+
