diff --git a/src/main/ps4/SDL_ps4_main.c b/src/main/ps4/SDL_ps4_main.c
new file mode 100644
index 000000000..2732760f8
--- /dev/null
+++ b/src/main/ps4/SDL_ps4_main.c
@@ -0,0 +1,168 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2025 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_config.h"
+
+#ifdef __PS4__
+
+#include "SDL_main.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#ifdef main
+#undef main
+#endif
+
+/* If the application's main() is redefined as SDL_main, and SDL2main is
+   linked, this main() sets up the XDG base directories before the program
+   starts (SDL_GetPrefPath() is in XDG_DATA_HOME, and Mesa's shader cache in
+   XDG_CACHE_HOME), and the program goes back to the home screen when it
+   exits.
+
+   If you provide your own main(), you may define SDL_MAIN_HANDLED; then you
+   set the XDG base directories yourself, or SDL_GetPrefPath() fails. */
+
+/* libkernel */
+extern int sceKernelDebugOutText(int channel, const char *text);
+extern int sceKernelIsInSandbox(void);
+extern const char *sceKernelGetFsSandboxRandomWord(void);
+
+/* libSceSysmodule */
+extern int sceSysmoduleLoadModule(unsigned short id);
+#define PS4_SYSMODULE_APP_CONTENT 0x00b4
+
+/* libSceSystemService */
+extern int sceSystemServiceLoadExec(const char *path, char *const argv[]);
+
+/* libSceAppContent */
+typedef struct
+{
+    unsigned char reserved[32];
+} PS4_AppContentInitParam;
+
+typedef struct
+{
+    unsigned char reserved1[4];
+    unsigned int attr;
+    unsigned char reserved2[32];
+} PS4_AppContentBootParam;
+
+typedef struct
+{
+    unsigned char data[16];
+} PS4_AppContentMountPoint;
+
+extern int sceAppContentInitialize(const PS4_AppContentInitParam *init, PS4_AppContentBootParam *boot);
+extern int sceAppContentTemporaryDataMount2(unsigned int option, PS4_AppContentMountPoint *mount_point);
+
+#define PS4_TEMP_DATA_FOLDER "/temp0"
+
+static PS4_AppContentMountPoint PS4_temp_data;
+
+/* Sets the XDG base directories that are not set already, to folders in
+   dir, and creates the folders. */
+static void PS4_SetXdgDirs(const char *dir)
+{
+    static const char *const vars[][2] = {
+        { "XDG_CACHE_HOME", ".cache" },
+        { "XDG_CONFIG_HOME", ".config" },
+        { "XDG_DATA_HOME", ".data" },
+        { "XDG_STATE_HOME", ".state" },
+    };
+    char path[256];
+    size_t i;
+
+    for (i = 0; i < sizeof(vars) / sizeof(vars[0]); i++) {
+        if (getenv(vars[i][0])) {
+            continue;
+        }
+        snprintf(path, sizeof(path), "%s/%s", dir, vars[i][1]);
+        mkdir(path, 0755);
+        setenv(vars[i][0], path, 0);
+    }
+}
+
+/* Mounts the title's temporary data, which only a game application (SFO
+   category "gd") has. Returns 0 on success. */
+static int PS4_MountTempData(void)
+{
+    PS4_AppContentInitParam init;
+    PS4_AppContentBootParam boot;
+    char msg[96];
+    int err;
+
+    memset(&init, 0, sizeof(init));
+    memset(&boot, 0, sizeof(boot));
+
+    sceSysmoduleLoadModule(PS4_SYSMODULE_APP_CONTENT);
+    sceAppContentInitialize(&init, &boot);
+
+    err = sceAppContentTemporaryDataMount2(0, &PS4_temp_data);
+    if (err) {
+        snprintf(msg, sizeof(msg), "<118>[SDL] sceAppContentTemporaryDataMount2: 0x%08x\n", (unsigned)err);
+        sceKernelDebugOutText(0, msg);
+    }
+    return err;
+}
+
+/* The XDG base directories are in the title's temporary data when it can be
+   mounted, otherwise in common_temp, which all homebrew shares. /data is
+   not always mounted. */
+static void PS4_InitXdgDirs(void)
+{
+    char dir[128];
+
+    if (!sceKernelIsInSandbox()) {
+        PS4_SetXdgDirs("/user/temp/common_temp");
+    } else if (PS4_MountTempData() == 0) {
+        PS4_SetXdgDirs(PS4_TEMP_DATA_FOLDER);
+    } else {
+        snprintf(dir, sizeof(dir), "/%s/common_temp", sceKernelGetFsSandboxRandomWord());
+        PS4_SetXdgDirs(dir);
+    }
+}
+
+/* Goes back to the home screen, however the program exits. It is registered
+   before the program starts, so it runs after the atexit() handlers of the
+   program and of the libraries it loads (e.g. Mesa). Handlers registered
+   before main() (the crt's, and the destructors of C++ globals) do not run
+   if the system ends the process here. */
+static void PS4_ExitToHomeScreen(void)
+{
+    fflush(NULL);
+    sceSystemServiceLoadExec("exit", NULL);
+}
+
+int main(int argc, char *argv[])
+{
+    atexit(PS4_ExitToHomeScreen);
+    PS4_InitXdgDirs();
+
+    SDL_SetMainReady();
+
+    return SDL_main(argc, argv);
+}
+
+#endif /* __PS4__ */
+
