+extern int sceSystemServiceLaunchWebBrowser(const char *uri, const void *param);
+
+int SDL_SYS_OpenURL(const char *url)
+{
+    int err;
+
+    if (PS4_InitUserService() < 0) {
+        return -1;
+    }
+
+    err = sceSystemServiceLaunchWebBrowser(url, NULL);
+    if (err < 0) {
+        return SDL_SetError("sceSystemServiceLaunchWebBrowser: 0x%08x", (unsigned)err);
+    }
+    return 0;
+}
