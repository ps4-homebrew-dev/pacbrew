+/* The system language the user picked in the PS4's settings */
+
+#define PS4_SYSTEM_SERVICE_PARAM_ID_LANG 1
+
+/* libSceSystemService */
+extern int sceSystemServiceParamGetInt(int param_id, int *value);
+
+void SDL_SYS_GetPreferredLocales(char *buf, size_t buflen)
+{
+    /* Indexed by the system's language ids */
+    static const char *const ps4_locales[] = {
+        "ja_JP", /* Japanese */
+        "en_US", /* English (United States) */
+        "fr_FR", /* French */
+        "es_ES", /* Spanish */
+        "de_DE", /* German */
+        "it_IT", /* Italian */
+        "nl_NL", /* Dutch */
+        "pt_PT", /* Portuguese (Portugal) */
+        "ru_RU", /* Russian */
+        "ko_KR", /* Korean */
+        "zh_TW", /* Chinese (traditional) */
+        "zh_CN", /* Chinese (simplified) */
+        "fi_FI", /* Finnish */
+        "sv_SE", /* Swedish */
+        "da_DK", /* Danish */
+        "nb_NO", /* Norwegian */
+        "pl_PL", /* Polish */
+        "pt_BR", /* Portuguese (Brazil) */
+        "en_GB", /* English (United Kingdom) */
+        "tr_TR", /* Turkish */
+        "es_419", /* Spanish (Latin America) */
+        "ar", /* Arabic */
+        "fr_CA", /* French (Canada) */
+        "cs_CZ", /* Czech */
+        "hu_HU", /* Hungarian */
+        "el_GR", /* Greek */
+        "ro_RO", /* Romanian */
+        "th_TH", /* Thai */
+        "vi_VN", /* Vietnamese */
+        "id_ID", /* Indonesian */
+    };
+    int language = 1;
+
+    if (sceSystemServiceParamGetInt(PS4_SYSTEM_SERVICE_PARAM_ID_LANG, &language) != 0 ||
+        language < 0 || language >= (int)SDL_arraysize(ps4_locales)) {
+        language = 1; /* English (United States) */
+    }
+
+    SDL_strlcpy(buf, ps4_locales[language], buflen);
+}
