         list(APPEND EXTRA_LIBS m)
       endif()
     endif()
@@ -1468,6 +1474,54 @@ elseif(EMSCRIPTEN)
   CheckPTHREAD()
   CheckLibUnwind()
 
+elseif(PS4)
+  # The PS4 (Orbis OS, FreeBSD 9 underneath) with the ps4-homebrew-dev SDK:
+  # libkernel and libSceLibcInternal are its libc, libm and pthreads.
+  # Graphics are the GPU's alone, through Mesa: OpenGL and OpenGL ES through
+  # EGL (zink), and Vulkan (RADV) on VK_KHR_display.
+  if(NOT SDL_LOADSO)
+    message(FATAL_ERROR "SDL_LOADSO is required on the PS4")
+  endif()
+
+  file(GLOB PS4_CORE_SOURCES ${SDL2_SOURCE_DIR}/src/core/ps4/*.c)
+  list(APPEND SOURCE_FILES ${PS4_CORE_SOURCES})
+  file(GLOB PS4_MAIN_SOURCES ${SDL2_SOURCE_DIR}/src/main/ps4/*.c)
+  list(APPEND SDLMAIN_SOURCES ${PS4_MAIN_SOURCES})
+  # The system libraries SDL links (libSceAppContent is for SDL2main); the
+  # others are loaded when used.
+  list(APPEND EXTRA_LIBS ScePad SceUserService SceSystemService SceSysmodule SceAppContent)
+  if(NOT SDL2_DISABLE_SDL2MAIN)
+    list(INSERT SDL_LIBS 0 "-lSDL2main")
+  endif()
+
+  if(SDL_FILESYSTEM)
+    set(SDL_FILESYSTEM_PS4 1)
+    file(GLOB PS4_FILESYSTEM_SOURCES ${SDL2_SOURCE_DIR}/src/filesystem/ps4/*.c)
