+#include "../../SDL_internal.h"
+
+#ifdef SDL_FILESYSTEM_PS4
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+/* System dependent filesystem routines                                */
+
+/* The base path is the folder of the program: the one its path was given
+   in, or a package's /app0/. The preference path is in $XDG_DATA_HOME,
+   which SDL2main sets up before main() (/data is not always mounted). */
+
+#include <errno.h>
+#include <limits.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+#include "SDL_error.h"
+#include "SDL_stdinc.h"
+#include "SDL_filesystem.h"
+
+#define PS4_APP_FOLDER  "/app0/"
+
+/* libkernel: the arguments the program was started with */
+extern const char **getargv(void);
+
+static char *PS4_GetCurrentFolder(void)
+{
+    char cwd[PATH_MAX];
+    size_t len;
+    char *retval;
+
+    if (!getcwd(cwd, sizeof(cwd)) || !cwd[0]) {
+        return NULL;
+    }
+
+    len = SDL_strlen(cwd);
+    retval = (char *)SDL_malloc(len + 2);
+    if (!retval) {
+        SDL_OutOfMemory();
+        return NULL;
+    }
+    SDL_memcpy(retval, cwd, len + 1);
+    if (retval[len - 1] != '/') {
+        retval[len] = '/';
+        retval[len + 1] = '\0';
+    }
+    return retval;
+}
+
+char *SDL_GetBasePath(void)
+{
+    const char **argv = getargv();
+    struct stat st;
+    char *retval;
+    char *slash;
+
+    if (argv && argv[0] && SDL_strchr(argv[0], '/')) {
+        if (argv[0][0] == '/') {
+            retval = SDL_strdup(argv[0]);
+        } else {
+            char *cwd = PS4_GetCurrentFolder();
+            size_t len;
+
+            if (!cwd) {
+                return NULL;
+            }
+            len = SDL_strlen(cwd) + SDL_strlen(argv[0]) + 1;
+            retval = (char *)SDL_malloc(len);
+            if (retval) {
+                SDL_snprintf(retval, len, "%s%s", cwd, argv[0]);
+            }
+            SDL_free(cwd);
+        }
+        if (!retval) {
+            SDL_OutOfMemory();
+            return NULL;
+        }
+
+        slash = SDL_strrchr(retval, '/');
+        slash[1] = '\0';
+        return retval;
+    }
+
+    if (stat(PS4_APP_FOLDER, &st) == 0 && S_ISDIR(st.st_mode)) {
+        return SDL_strdup(PS4_APP_FOLDER);
+    }
+
+    retval = PS4_GetCurrentFolder();
+    if (!retval) {
+        SDL_SetError("Couldn't find the program's folder");
+    }
+    return retval;
+}
+
+char *SDL_GetPrefPath(const char *org, const char *app)
+{
+    /* As on Unix: $XDG_DATA_HOME, or else $HOME/.local/share. */
+    const char *envr = SDL_getenv("XDG_DATA_HOME");
+    const char *append = "/";
+    char *retval;
+    char *ptr;
+    size_t len;
+
+    if (!app) {
+        SDL_InvalidParamError("app");
+        return NULL;
+    }
+    if (!org) {
+        org = "";
+    }
+
+    if (!envr || !*envr) {
+        envr = SDL_getenv("HOME");
+        if (!envr || !*envr) {
+            SDL_SetError("neither XDG_DATA_HOME nor HOME environment is set");
+            return NULL;
+        }
+        append = "/.local/share/";
+    }
+    if (envr[SDL_strlen(envr) - 1] == '/') {
+        append += 1;
+    }
+
+    len = SDL_strlen(envr) + SDL_strlen(append) + SDL_strlen(org) + SDL_strlen(app) + 3;
+    retval = (char *)SDL_malloc(len);
+    if (!retval) {
+        SDL_OutOfMemory();
+        return NULL;
+    }
+
+    if (*org) {
+        SDL_snprintf(retval, len, "%s%s%s/%s/", envr, append, org, app);
+    } else {
+        SDL_snprintf(retval, len, "%s%s%s/", envr, append, app);
+    }
+
+    for (ptr = retval + 1; *ptr; ptr++) {
+        if (*ptr == '/') {
+            struct stat st;
+            int err;
+
+            *ptr = '\0';
+            if (mkdir(retval, 0777) != 0 && (err = errno) != EEXIST &&
+                (stat(retval, &st) != 0 || !S_ISDIR(st.st_mode))) {
+                SDL_SetError("Couldn't create directory '%s': %s", retval, strerror(err));
+                SDL_free(retval);
+                return NULL;
+            }
+            *ptr = '/';
+        }
+    }
+
+    return retval;
+}
+
+#endif /* SDL_FILESYSTEM_PS4 */
+
