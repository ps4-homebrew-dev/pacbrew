+#define PS4_PAD_BUTTON_R3        0x00000004
+#define PS4_PAD_BUTTON_OPTIONS   0x00000008
+#define PS4_PAD_BUTTON_UP        0x00000010
+#define PS4_PAD_BUTTON_RIGHT     0x00000020
