+#include "../../SDL_internal.h"
+
+#ifdef SDL_JOYSTICK_PS4
+
+/* The DualShock 4 of each user logged in to the PS4 (libScePad), one
+   joystick per user, in the user's login slot (the player index).
+
+   Buttons, axes and hat are laid out as SDL's HIDAPI driver lays out a
+   DualShock 4 on a PC, and the game controller mapping comes from the
+   driver. The PS and SHARE buttons belong to the system, so there is no
+   guide and no back button; the touch pad click is the touchpad button.
+   The touch pad, the accelerometer and the gyroscope are reported too. */
+
+#include "SDL_events.h"
+#include "../SDL_sysjoystick.h"
+#include "../SDL_joystick_c.h"
+#include "../usb_ids.h"
+#include "../../core/ps4/SDL_ps4.h"
+
+#include "SDL_ps4joystick.h"
+
+SDL_COMPILE_TIME_ASSERT(PS4_PadData, sizeof(PS4_PadData) == 120);
+SDL_COMPILE_TIME_ASSERT(PS4_PadControllerInformation, sizeof(PS4_PadControllerInformation) == 28);
+
+#define PS4_JOYSTICK_NAME "PS4 Controller"
+
+enum
+{
+    PS4_AXIS_LEFTX,
+    PS4_AXIS_LEFTY,
+    PS4_AXIS_RIGHTX,
+    PS4_AXIS_RIGHTY,
+    PS4_AXIS_LEFT_TRIGGER,
+    PS4_AXIS_RIGHT_TRIGGER,
+    PS4_AXIS_MAX
+};
+
+/* Joystick button index -> libScePad button, 0 for a button the system
+   keeps to itself: SDL's game controller button order, then the touch pad
+   click, as the HIDAPI driver has them. */
+static const Uint32 ps4_button_map[] = {
+    PS4_PAD_BUTTON_CROSS,     /* a */
+    PS4_PAD_BUTTON_CIRCLE,    /* b */
+    PS4_PAD_BUTTON_SQUARE,    /* x */
+    PS4_PAD_BUTTON_TRIANGLE,  /* y */
+    0,                        /* back: SHARE belongs to the system */
+    0,                        /* guide: PS belongs to the system */
+    PS4_PAD_BUTTON_OPTIONS,   /* start */
+    PS4_PAD_BUTTON_L3,        /* leftstick */
+    PS4_PAD_BUTTON_R3,        /* rightstick */
+    PS4_PAD_BUTTON_L1,        /* leftshoulder */
+    PS4_PAD_BUTTON_R1,        /* rightshoulder */
+    PS4_PAD_BUTTON_UP,        /* dpup */
+    PS4_PAD_BUTTON_DOWN,      /* dpdown */
+    PS4_PAD_BUTTON_LEFT,      /* dpleft */
+    PS4_PAD_BUTTON_RIGHT,     /* dpright */
+    PS4_PAD_BUTTON_TOUCH_PAD, /* touchpad */
+};
+
+#define PS4_BUTTON_TOUCHPAD 15
+
+typedef struct PS4_PadContext
+{
+    int user_id;                /* PS4_USER_ID_INVALID when nobody is there */
+    SDL_JoystickID instance_id;
+    char name[64];
+    int handle;                 /* -1 when the joystick is not open */
+    SDL_bool sensors_enabled;
+    float touch_width;
+    float touch_height;
+    PS4_PadData pad;
+} PS4_PadContext;
+
+static PS4_PadContext ps4_pads[PS4_MAX_LOGIN_USERS];
+static SDL_JoystickGUID ps4_guid;
+
+/* 0 .. 255 -> -32768 .. 32767, as the HIDAPI driver does */
+static Sint16 PS4_AxisValue(Uint8 value)
+{
+    return (Sint16)(((int)value * 257) - 32768);
+}
+
+static PS4_PadContext *PS4_GetPadForDeviceIndex(int device_index)
+{
+    int i;
+
+    for (i = 0; i < PS4_MAX_LOGIN_USERS; i++) {
+        if (ps4_pads[i].user_id == PS4_USER_ID_INVALID) {
+            continue;
+        }
+        if (device_index == 0) {
+            return &ps4_pads[i];
+        }
+        device_index--;
+    }
+    return NULL;
+}
+
+/* NULL once the joystick's user has logged out: the slot may be someone
+   else's by then. */
+static PS4_PadContext *PS4_GetPadForJoystick(SDL_Joystick *joystick)
+{
+    PS4_PadContext *ctx = (PS4_PadContext *)joystick->hwdata;
+
+    if (!ctx || ctx->instance_id != joystick->instance_id) {
+        return NULL;
+    }
+    return ctx;
+}
+
+static void PS4_ClosePad(PS4_PadContext *ctx)
+{
+    if (ctx->handle >= 0) {
+        const PS4_PadVibration stop = { 0, 0 };
+
+        scePadSetVibration(ctx->handle, &stop);
+        scePadResetLightBar(ctx->handle);
+        if (ctx->sensors_enabled) {
+            scePadSetMotionSensorState(ctx->handle, SDL_FALSE);
+        }
+        scePadClose(ctx->handle);
+        ctx->handle = -1;
+    }
+    ctx->sensors_enabled = SDL_FALSE;
+}
+
+static void PS4_JoystickDetect(void)
+{
+    PS4_LoginUserIdList users;
+    int i;
+
+    if (sceUserServiceGetLoginUserIdList(&users) != 0) {
+        return;
+    }
+
+    for (i = 0; i < PS4_MAX_LOGIN_USERS; i++) {
+        PS4_PadContext *ctx = &ps4_pads[i];
+
+        if (users.user_id[i] == ctx->user_id) {
+            continue;
+        }
+
+        /* Whoever was in this slot logged out. */
+        if (ctx->user_id != PS4_USER_ID_INVALID) {
+            PS4_ClosePad(ctx);
+            ctx->user_id = PS4_USER_ID_INVALID;
+            SDL_PrivateJoystickRemoved(ctx->instance_id);
+            ctx->instance_id = -1;
+        }
+
+        /* Someone logged in to it. */
+        if (users.user_id[i] != PS4_USER_ID_INVALID) {
+            ctx->user_id = users.user_id[i];
+            ctx->instance_id = SDL_GetNextJoystickInstanceID();
+            if (sceUserServiceGetUserName(ctx->user_id, ctx->name, sizeof(ctx->name)) != 0 ||
+                !ctx->name[0]) {
+                SDL_snprintf(ctx->name, sizeof(ctx->name), "%s %d", PS4_JOYSTICK_NAME, i + 1);
+            }
+            SDL_PrivateJoystickAdded(ctx->instance_id);
+        }
+    }
+}
+
+static int PS4_JoystickInit(void)
+{
+    int i;
+
+    for (i = 0; i < PS4_MAX_LOGIN_USERS; i++) {
+        SDL_zero(ps4_pads[i]);
+        ps4_pads[i].user_id = PS4_USER_ID_INVALID;
+        ps4_pads[i].instance_id = -1;
+        ps4_pads[i].handle = -1;
+    }
+
+    /* A DualShock 4 to SDL, so that games see a PS4 controller. */
+    ps4_guid = SDL_CreateJoystickGUID(SDL_HARDWARE_BUS_USB, USB_VENDOR_SONY, USB_PRODUCT_SONY_DS4_SLIM, 0,
+                                      NULL, PS4_JOYSTICK_NAME, 0, 0);
+
+    if (PS4_InitPad() < 0) {
+        return -1;
+    }
+
+    PS4_JoystickDetect();
+
+    return 0;
+}
+
+static int PS4_JoystickGetCount(void)
+{
+    int count = 0;
+    int i;
+
+    for (i = 0; i < PS4_MAX_LOGIN_USERS; i++) {
+        if (ps4_pads[i].user_id != PS4_USER_ID_INVALID) {
+            count++;
+        }
+    }
+    return count;
+}
+
+static const char *PS4_JoystickGetDeviceName(int device_index)
+{
+    PS4_PadContext *ctx = PS4_GetPadForDeviceIndex(device_index);
+
+    return ctx ? ctx->name : NULL;
+}
+
+static const char *PS4_JoystickGetDevicePath(int device_index)
+{
+    return NULL;
+}
+
+static int PS4_JoystickGetDeviceSteamVirtualGamepadSlot(int device_index)
+{
+    return -1;
+}
+
+static int PS4_JoystickGetDevicePlayerIndex(int device_index)
+{
+    PS4_PadContext *ctx = PS4_GetPadForDeviceIndex(device_index);
+
+    return ctx ? (int)(ctx - ps4_pads) : -1;
+}
+
+static void PS4_JoystickSetDevicePlayerIndex(int device_index, int player_index)
+{
+}
+
+static SDL_JoystickGUID PS4_JoystickGetDeviceGUID(int device_index)
+{
+    return ps4_guid;
+}
+
+static SDL_JoystickID PS4_JoystickGetDeviceInstanceID(int device_index)
+{
+    PS4_PadContext *ctx = PS4_GetPadForDeviceIndex(device_index);
+
+    return ctx ? ctx->instance_id : -1;
+}
+
+static int PS4_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    PS4_PadContext *ctx = PS4_GetPadForDeviceIndex(device_index);
+    PS4_PadControllerInformation info;
+    int handle;
+
+    if (!ctx) {
+        return SDL_SetError("No joystick at device index %d", device_index);
+    }
+
+    handle = scePadOpen(ctx->user_id, PS4_PAD_PORT_TYPE_STANDARD, 0, NULL);
+    if ((unsigned)handle == PS4_PAD_ERROR_ALREADY_OPENED) {
+        handle = scePadGetHandle(ctx->user_id, PS4_PAD_PORT_TYPE_STANDARD, 0);
+    }
+    if (handle < 0) {
+        return SDL_SetError("scePadOpen: 0x%08x", (unsigned)handle);
+    }
+
+    ctx->handle = handle;
+    ctx->sensors_enabled = SDL_FALSE;
+    SDL_zero(ctx->pad);
+
+    ctx->touch_width = PS4_PAD_TOUCHPAD_WIDTH;
+    ctx->touch_height = PS4_PAD_TOUCHPAD_HEIGHT;
+    SDL_zero(info);
+    if (scePadGetControllerInformation(handle, &info) == 0 &&
+        info.touchPadResolutionX > 1 && info.touchPadResolutionY > 1) {
+        ctx->touch_width = info.touchPadResolutionX;
+        ctx->touch_height = info.touchPadResolutionY;
+    }
+
+    joystick->hwdata = (struct joystick_hwdata *)ctx;
+    joystick->instance_id = ctx->instance_id;
+    joystick->nbuttons = SDL_arraysize(ps4_button_map);
+    joystick->naxes = PS4_AXIS_MAX;
+    joystick->nhats = 1;
+    joystick->epowerlevel = SDL_JOYSTICK_POWER_UNKNOWN;
+
+    SDL_PrivateJoystickAddTouchpad(joystick, PS4_PAD_MAX_TOUCH_NUM);
+    SDL_PrivateJoystickAddSensor(joystick, SDL_SENSOR_GYRO, 0.0f);
+    SDL_PrivateJoystickAddSensor(joystick, SDL_SENSOR_ACCEL, 0.0f);
+
+    return 0;
+}
+
+static int PS4_JoystickRumble(SDL_Joystick *joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+    PS4_PadContext *ctx = PS4_GetPadForJoystick(joystick);
+    PS4_PadVibration vibration;
+    int err;
+
+    if (!ctx || ctx->handle < 0) {
+        return SDL_SetError("Joystick not open");
+    }
+
+    /* The large motor is the low frequency one. */
+    vibration.largeMotor = (Uint8)(low_frequency_rumble >> 8);
+    vibration.smallMotor = (Uint8)(high_frequency_rumble >> 8);
+
+    err = scePadSetVibration(ctx->handle, &vibration);
+    if (err != 0) {
+        return SDL_SetError("scePadSetVibration: 0x%08x", (unsigned)err);
+    }
+    return 0;
+}
+
+static int PS4_JoystickRumbleTriggers(SDL_Joystick *joystick, Uint16 left_rumble, Uint16 right_rumble)
+{
+    return SDL_Unsupported();
+}
+
+static Uint32 PS4_JoystickGetCapabilities(SDL_Joystick *joystick)
+{
+    return SDL_JOYCAP_LED | SDL_JOYCAP_RUMBLE;
+}
+
+static int PS4_JoystickSetLED(SDL_Joystick *joystick, Uint8 red, Uint8 green, Uint8 blue)
+{
+    PS4_PadContext *ctx = PS4_GetPadForJoystick(joystick);
+    PS4_PadColor color;
+    int err;
+
+    if (!ctx || ctx->handle < 0) {
+        return SDL_SetError("Joystick not open");
+    }
+
+    color.r = red;
+    color.g = green;
+    color.b = blue;
+    color.reserve = 0;
+
+    err = scePadSetLightBar(ctx->handle, &color);
+    if (err != 0) {
+        return SDL_SetError("scePadSetLightBar: 0x%08x", (unsigned)err);
+    }
+    return 0;
+}
+
+static int PS4_JoystickSendEffect(SDL_Joystick *joystick, const void *data, int size)
+{
+    return SDL_Unsupported();
+}
+
+static int PS4_JoystickSetSensorsEnabled(SDL_Joystick *joystick, SDL_bool enabled)
+{
+    PS4_PadContext *ctx = PS4_GetPadForJoystick(joystick);
+    int err;
+
+    if (!ctx || ctx->handle < 0) {
+        return SDL_SetError("Joystick not open");
+    }
+
+    err = scePadSetMotionSensorState(ctx->handle, enabled);
+    if (err != 0) {
+        return SDL_SetError("scePadSetMotionSensorState: 0x%08x", (unsigned)err);
+    }
+    ctx->sensors_enabled = enabled;
+    return 0;
+}
+
+static void PS4_UpdateTouchpad(SDL_Joystick *joystick, PS4_PadContext *ctx, const PS4_PadData *pad)
+{
+    const PS4_PadTouchData *touch = &pad->touchData;
+    int i;
+
+    /* One finger per slot: a slot's finger is down while the pad reports
+       it, and lifted when it no longer does. */
+    for (i = 0; i < PS4_PAD_MAX_TOUCH_NUM; i++) {
+        if (i < touch->touchNum) {
+            float x = touch->touch[i].x / ctx->touch_width;
+            float y = touch->touch[i].y / ctx->touch_height;
+
+            SDL_PrivateJoystickTouchpad(joystick, 0, i, SDL_PRESSED,
+                                        SDL_clamp(x, 0.0f, 1.0f),
+                                        SDL_clamp(y, 0.0f, 1.0f), 1.0f);
+        } else {
+            SDL_PrivateJoystickTouchpad(joystick, 0, i, SDL_RELEASED, 0.0f, 0.0f, 0.0f);
+        }
+    }
+}
+
+static void PS4_UpdateSensors(SDL_Joystick *joystick, const PS4_PadData *pad)
+{
+    float data[3];
+
+    /* libScePad has the axes SDL has for a game controller held in front
+       of you: X to the right, Y up, Z toward you. */
+    data[0] = pad->angularVelocity.x;
+    data[1] = pad->angularVelocity.y;
+    data[2] = pad->angularVelocity.z;
+    SDL_PrivateJoystickSensor(joystick, SDL_SENSOR_GYRO, pad->timestamp, data, 3);
+
+    data[0] = pad->acceleration.x * SDL_STANDARD_GRAVITY;
+    data[1] = pad->acceleration.y * SDL_STANDARD_GRAVITY;
+    data[2] = pad->acceleration.z * SDL_STANDARD_GRAVITY;
+    SDL_PrivateJoystickSensor(joystick, SDL_SENSOR_ACCEL, pad->timestamp, data, 3);
+}
+
+static void PS4_JoystickUpdate(SDL_Joystick *joystick)
+{
+    PS4_PadContext *ctx = PS4_GetPadForJoystick(joystick);
+    PS4_PadData pad;
+    Uint32 changed;
+    Uint8 hat = SDL_HAT_CENTERED;
+    int i;
+
+    if (!ctx || ctx->handle < 0) {
+        return;
+    }
+
+    SDL_zero(pad);
+    if (scePadReadState(ctx->handle, &pad) != 0) {
+        return;
+    }
+
+    if (!pad.connected) {
+        /* Its controller went away (it turned off, or the user switched
+           to another one): let go of everything until it is back. */
+        if (ctx->pad.connected) {
+            SDL_PrivateJoystickForceRecentering(joystick);
+            for (i = 0; i < PS4_PAD_MAX_TOUCH_NUM; i++) {
+                SDL_PrivateJoystickTouchpad(joystick, 0, i, SDL_RELEASED, 0.0f, 0.0f, 0.0f);
+            }
+            SDL_zero(ctx->pad);
+        }
+        return;
+    }
+
+    if (pad.leftStick.x != ctx->pad.leftStick.x || !ctx->pad.connected) {
+        SDL_PrivateJoystickAxis(joystick, PS4_AXIS_LEFTX, PS4_AxisValue(pad.leftStick.x));
+    }
+    if (pad.leftStick.y != ctx->pad.leftStick.y || !ctx->pad.connected) {
+        SDL_PrivateJoystickAxis(joystick, PS4_AXIS_LEFTY, PS4_AxisValue(pad.leftStick.y));
+    }
+    if (pad.rightStick.x != ctx->pad.rightStick.x || !ctx->pad.connected) {
+        SDL_PrivateJoystickAxis(joystick, PS4_AXIS_RIGHTX, PS4_AxisValue(pad.rightStick.x));
+    }
+    if (pad.rightStick.y != ctx->pad.rightStick.y || !ctx->pad.connected) {
+        SDL_PrivateJoystickAxis(joystick, PS4_AXIS_RIGHTY, PS4_AxisValue(pad.rightStick.y));
+    }
+    if (pad.analogButtons.l2 != ctx->pad.analogButtons.l2 || !ctx->pad.connected) {
+        SDL_PrivateJoystickAxis(joystick, PS4_AXIS_LEFT_TRIGGER, PS4_AxisValue(pad.analogButtons.l2));
+    }
+    if (pad.analogButtons.r2 != ctx->pad.analogButtons.r2 || !ctx->pad.connected) {
+        SDL_PrivateJoystickAxis(joystick, PS4_AXIS_RIGHT_TRIGGER, PS4_AxisValue(pad.analogButtons.r2));
+    }
+
+    changed = pad.buttons ^ ctx->pad.buttons;
+    if (changed) {
+        for (i = 0; i < (int)SDL_arraysize(ps4_button_map); i++) {
+            if (ps4_button_map[i] && (changed & ps4_button_map[i])) {
+                SDL_PrivateJoystickButton(joystick, (Uint8)i,
+                                          (pad.buttons & ps4_button_map[i]) ? SDL_PRESSED : SDL_RELEASED);
+            }
+        }
+
+        if (pad.buttons & PS4_PAD_BUTTON_UP) {
+            hat |= SDL_HAT_UP;
+        }
+        if (pad.buttons & PS4_PAD_BUTTON_DOWN) {
+            hat |= SDL_HAT_DOWN;
+        }
+        if (pad.buttons & PS4_PAD_BUTTON_LEFT) {
+            hat |= SDL_HAT_LEFT;
+        }
+        if (pad.buttons & PS4_PAD_BUTTON_RIGHT) {
+            hat |= SDL_HAT_RIGHT;
+        }
+        SDL_PrivateJoystickHat(joystick, 0, hat);
+    }
+
+    PS4_UpdateTouchpad(joystick, ctx, &pad);
+
+    if (ctx->sensors_enabled) {
+        PS4_UpdateSensors(joystick, &pad);
+    }
+
+    SDL_memcpy(&ctx->pad, &pad, sizeof(pad));
+}
+
+static void PS4_JoystickClose(SDL_Joystick *joystick)
+{
+    PS4_PadContext *ctx = PS4_GetPadForJoystick(joystick);
+
+    if (ctx) {
+        PS4_ClosePad(ctx);
+    }
+    joystick->hwdata = NULL;
+}
+
+static void PS4_JoystickQuit(void)
+{
+    int i;
+
+    for (i = 0; i < PS4_MAX_LOGIN_USERS; i++) {
+        PS4_ClosePad(&ps4_pads[i]);
+        ps4_pads[i].user_id = PS4_USER_ID_INVALID;
+        ps4_pads[i].instance_id = -1;
+    }
+}
+
+static SDL_bool PS4_JoystickGetGamepadMapping(int device_index, SDL_GamepadMapping *out)
+{
+    if (!PS4_GetPadForDeviceIndex(device_index)) {
+        return SDL_FALSE;
+    }
+
+#define PS4_MAP_BUTTON(binding, index) \
+    out->binding.kind = EMappingKind_Button; \
+    out->binding.target = index
+#define PS4_MAP_AXIS(binding, index) \
+    out->binding.kind = EMappingKind_Axis; \
+    out->binding.target = index
+
+    PS4_MAP_BUTTON(a, SDL_CONTROLLER_BUTTON_A);
+    PS4_MAP_BUTTON(b, SDL_CONTROLLER_BUTTON_B);
+    PS4_MAP_BUTTON(x, SDL_CONTROLLER_BUTTON_X);
+    PS4_MAP_BUTTON(y, SDL_CONTROLLER_BUTTON_Y);
+    PS4_MAP_BUTTON(start, SDL_CONTROLLER_BUTTON_START);
+    PS4_MAP_BUTTON(leftstick, SDL_CONTROLLER_BUTTON_LEFTSTICK);
+    PS4_MAP_BUTTON(rightstick, SDL_CONTROLLER_BUTTON_RIGHTSTICK);
+    PS4_MAP_BUTTON(leftshoulder, SDL_CONTROLLER_BUTTON_LEFTSHOULDER);
+    PS4_MAP_BUTTON(rightshoulder, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER);
+    PS4_MAP_BUTTON(dpup, SDL_CONTROLLER_BUTTON_DPAD_UP);
+    PS4_MAP_BUTTON(dpdown, SDL_CONTROLLER_BUTTON_DPAD_DOWN);
+    PS4_MAP_BUTTON(dpleft, SDL_CONTROLLER_BUTTON_DPAD_LEFT);
+    PS4_MAP_BUTTON(dpright, SDL_CONTROLLER_BUTTON_DPAD_RIGHT);
+    PS4_MAP_BUTTON(touchpad, PS4_BUTTON_TOUCHPAD);
+    PS4_MAP_AXIS(leftx, PS4_AXIS_LEFTX);
+    PS4_MAP_AXIS(lefty, PS4_AXIS_LEFTY);
+    PS4_MAP_AXIS(rightx, PS4_AXIS_RIGHTX);
+    PS4_MAP_AXIS(righty, PS4_AXIS_RIGHTY);
+    PS4_MAP_AXIS(lefttrigger, PS4_AXIS_LEFT_TRIGGER);
+    PS4_MAP_AXIS(righttrigger, PS4_AXIS_RIGHT_TRIGGER);
+
+#undef PS4_MAP_BUTTON
+#undef PS4_MAP_AXIS
+
+    return SDL_TRUE;
+}
+
+SDL_JoystickDriver SDL_PS4_JoystickDriver = {
+    PS4_JoystickInit,
+    PS4_JoystickGetCount,
+    PS4_JoystickDetect,
+    PS4_JoystickGetDeviceName,
+    PS4_JoystickGetDevicePath,
+    PS4_JoystickGetDeviceSteamVirtualGamepadSlot,
+    PS4_JoystickGetDevicePlayerIndex,
+    PS4_JoystickSetDevicePlayerIndex,
+    PS4_JoystickGetDeviceGUID,
+    PS4_JoystickGetDeviceInstanceID,
+    PS4_JoystickOpen,
+    PS4_JoystickRumble,
+    PS4_JoystickRumbleTriggers,
+    PS4_JoystickGetCapabilities,
+    PS4_JoystickSetLED,
+    PS4_JoystickSendEffect,
+    PS4_JoystickSetSensorsEnabled,
+    PS4_JoystickUpdate,
+    PS4_JoystickClose,
+    PS4_JoystickQuit,
+    PS4_JoystickGetGamepadMapping
+};
+
+#endif /* SDL_JOYSTICK_PS4 */
