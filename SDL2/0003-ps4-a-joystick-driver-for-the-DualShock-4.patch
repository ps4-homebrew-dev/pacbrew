+#define PS4_PAD_BUTTON_R1        0x00000800
+#define PS4_PAD_BUTTON_TRIANGLE  0x00001000
+#define PS4_PAD_BUTTON_CIRCLE    0x00002000
+#define PS4_PAD_BUTTON_CROSS     0x00004000
+#define PS4_PAD_BUTTON_SQUARE    0x00008000
+#define PS4_PAD_BUTTON_TOUCH_PAD 0x00100000
+
+#define PS4_PAD_MAX_TOUCH_NUM 2
+
+/* The DualShock 4's touch pad, when the controller does not say. */
+#define PS4_PAD_TOUCHPAD_WIDTH  1920
+#define PS4_PAD_TOUCHPAD_HEIGHT 943
+
+typedef struct PS4_PadTouch
+{
+    Uint16 x;
+    Uint16 y;
+    Uint8 id;
+    Uint8 reserve[3];
+} PS4_PadTouch;
+
+typedef struct PS4_PadTouchData
+{
+    Uint8 touchNum;
+    Uint8 reserve[3];
+    Uint32 reserve1;
+    PS4_PadTouch touch[PS4_PAD_MAX_TOUCH_NUM];
+} PS4_PadTouchData;
+
+typedef struct PS4_PadData
+{
+    Uint32 buttons;
+    struct
+    {
+        Uint8 x;
+        Uint8 y;
+    } leftStick, rightStick;
+    struct
+    {
+        Uint8 l2;
+        Uint8 r2;
+        Uint8 padding[2];
+    } analogButtons;
+    struct
+    {
+        float x, y, z, w;
+    } orientation;
+    struct
+    {
+        float x, y, z;
+    } acceleration;      /* in G */
+    struct
+    {
+        float x, y, z;
+    } angularVelocity;   /* in radians per second */
+    PS4_PadTouchData touchData;
+    Uint8 connected;
+    Uint64 timestamp;    /* in microseconds */
+    Uint8 extensionUnitData[16];
+    Uint8 connectedCount;
+    Uint8 reserve[2];
+    Uint8 deviceUniqueDataLen;
+    Uint8 deviceUniqueData[12];
+} PS4_PadData;
+
+typedef struct PS4_PadControllerInformation
+{
+    float touchPadPixelDensity;
+    Uint16 touchPadResolutionX;
+    Uint16 touchPadResolutionY;
+    Uint8 stickDeadZoneLeft;
+    Uint8 stickDeadZoneRight;
+    Uint8 connectionType;
+    Uint8 connectedCount;
+    Uint8 connected;
+    int deviceClass;
+    Uint8 reserve[8];
+} PS4_PadControllerInformation;
+
+typedef struct PS4_PadColor
+{
+    Uint8 r;
+    Uint8 g;
+    Uint8 b;
+    Uint8 reserve;
+} PS4_PadColor;
+
+typedef struct PS4_PadVibration
