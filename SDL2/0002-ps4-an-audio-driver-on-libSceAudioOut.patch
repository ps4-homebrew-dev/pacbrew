+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "../../SDL_internal.h"
+
+#ifndef SDL_ps4audio_h_
+#define SDL_ps4audio_h_
+
+#include "../SDL_sysaudio.h"
+
+/* Two buffers: sceAudioOutOutput() returns once the previous one has been
+   played, while the one it was given is still playing. */
+#define PS4AUDIO_NUM_BUFFERS 2
+
+struct SDL_PrivateAudioData
+{
+    int handle;
+    Uint8 *rawbuf;
+    Uint8 *mixbufs[PS4AUDIO_NUM_BUFFERS];
+    int next_buffer;
+};
+
+#endif /* SDL_ps4audio_h_ */
+
