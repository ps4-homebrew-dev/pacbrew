pkgname=ps4-homebrew-sdl2
pkgver=2.32.10
pkgrel=2
pkgdesc='A library for portable low-level access to video, audio, joysticks... (PS4: OpenGL, OpenGL ES and Vulkan on Mesa)'
arch=('any')
url='https://libsdl.org'
license=('zlib')
options=(!strip !libtool staticlibs)
source=("SDL::git+https://github.com/libsdl-org/SDL.git#tag=release-${pkgver}"
	'0001-ps4-the-PlayStation-4-platform-with-the-ps4-homebrew.patch'
	'0002-ps4-an-audio-driver-on-libSceAudioOut.patch'
	'0003-ps4-a-joystick-driver-for-the-DualShock-4.patch'
	'0004-ps4-a-video-driver-on-Mesa-OpenGL-OpenGL-ES-and-Vulk.patch'
	'0005-ps4-HDMI-CEC-remote-keys-as-on-the-PS5.patch')
sha256sums=('SKIP'
	    '140e8a1c6a70d558be6b541302f5af22e17fd3e30cb5812e9eef0f938da3bd00'
	    '3474441b9b99dabb977d1308ec31dfeacefdb8f0840f93d6e92e2f67edc2ebd4'
	    '469486a6ca90b1bcf050878f961da2dcc2a4f54022089529d2551eb7f9e57d78'
	    'cc3c77d11ab678de1dd7c81ab396ec442a8b2b7e6aaf1fd852a3794f5693d553'
	    '9d4733a2407682be7842e3656397a10c31f88fdcfcd210166411cb90d0f69952')
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk')
# OpenGL, OpenGL ES and Vulkan are Mesa's libEGL.so.1, libGLESv2.so.2 and
# libvulkan.so.1, which SDL loads when a program asks for them.
optdepends=('ps4-homebrew-mesa: OpenGL, OpenGL ES and Vulkan')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi

    cd SDL
    local p
    for p in "${srcdir}"/[0-9][0-9][0-9][0-9]-*.patch; do
	patch -Np1 -i "$p"
    done
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd SDL

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release -B build -S .
    ${MAKE} -C build
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd SDL

    ${MAKE} -C build install DESTDIR="${pkgdir}/${SYSROOT}"
}
