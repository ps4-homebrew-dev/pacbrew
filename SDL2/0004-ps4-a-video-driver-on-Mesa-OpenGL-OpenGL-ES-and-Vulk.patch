diff --git a/src/video/ps4/SDL_ps4video.c b/src/video/ps4/SDL_ps4video.c
new file mode 100644
index 000000000..a1bdbcf53
--- /dev/null
+++ b/src/video/ps4/SDL_ps4video.c
@@ -0,0 +1,227 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2025 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_PS4
+
+/* The PS4's display, drawn on with the GPU only: OpenGL and OpenGL ES
+   through EGL, or Vulkan through VK_KHR_display, all of them Mesa's (zink
+   and RADV), which owns VideoOut.
+
+   A window is the screen: it is always the display's size, the way windows
+   are on Linux without a window system (KMSDRM). There is no software
+   framebuffer: windows drawn in software (SDL_GetWindowSurface(), the
+   software renderer) are presented by SDL itself through its OpenGL or
+   OpenGL ES renderer. */
+
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../events/SDL_windowevents_c.h"
+#include "../../core/ps4/SDL_ps4.h"
+
+#include "SDL_ps4video.h"
+#include "SDL_ps4keyboard.h"
+#include "SDL_ps4remote.h"
+#include "SDL_ps4vulkan.h"
+
+static int PS4_VideoInit(_THIS)
+{
+    SDL_DisplayMode mode;
+
+    /* A program started from its package shows the splash screen until it
+       has something on the screen to show instead. */
+    sceSystemServiceHideSplashScreen();
+
+    SDL_zero(mode);
+    mode.format = SDL_PIXELFORMAT_ARGB8888; /* VideoOut's B8G8R8A8 */
+    mode.w = PS4_DISPLAY_WIDTH;
+    mode.h = PS4_DISPLAY_HEIGHT;
+    mode.refresh_rate = PS4_DISPLAY_REFRESH_RATE;
+
+    if (SDL_AddBasicVideoDisplay(&mode) < 0) {
+        return -1;
+    }
+
+    /* Input that comes through the video driver, as keys. Neither a
+       keyboard nor a remote needs to be there. */
+    if (PS4_Keyboard_Init() < 0) {
+        SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "ps4: no keyboard: %s", SDL_GetError());
+    }
+    if (PS4_Remote_Init() < 0) {
+        SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "ps4: no remote: %s", SDL_GetError());
+    }
+    SDL_ClearError();
+
+    return 0;
+}
+
+static void PS4_VideoQuit(_THIS)
+{
+    PS4_ImeDialog_Quit();
+    PS4_Remote_Quit();
+    PS4_Keyboard_Quit();
+}
+
+static void PS4_GetDisplayModes(_THIS, SDL_VideoDisplay *display)
+{
+    SDL_AddDisplayMode(display, &display->desktop_mode);
+}
+
+static int PS4_SetDisplayMode(_THIS, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    return 0;
+}
+
+/* Whatever size a program asks for, its window is the screen. */
+static void PS4_FillScreen(SDL_Window *window)
+{
+    window->x = 0;
+    window->y = 0;
+    SDL_SendWindowEvent(window, SDL_WINDOWEVENT_RESIZED,
+                        PS4_DISPLAY_WIDTH, PS4_DISPLAY_HEIGHT);
+}
+
+static int PS4_CreateWindow(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data;
+
+    data = (SDL_WindowData *)SDL_calloc(1, sizeof(SDL_WindowData));
+    if (!data) {
+        return SDL_OutOfMemory();
+    }
+    window->driverdata = data;
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+    data->egl_surface = EGL_NO_SURFACE;
+    if (window->flags & SDL_WINDOW_OPENGL) {
+        if (PS4_GLES_CreateSurface(_this, window) < 0) {
+            SDL_free(data);
+            window->driverdata = NULL;
+            return -1;
+        }
+    }
+#endif
+
+    PS4_FillScreen(window);
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+
+    return 0;
+}
+
+static void PS4_SetWindowSize(_THIS, SDL_Window *window)
+{
+    PS4_FillScreen(window);
+}
+
+static void PS4_SetWindowFullscreen(_THIS, SDL_Window *window,
+                                    SDL_VideoDisplay *display,
+                                    SDL_bool fullscreen)
+{
+    PS4_FillScreen(window);
+}
+
+static void PS4_DestroyWindow(_THIS, SDL_Window *window)
+{
+    if (!window->driverdata) {
+        return;
+    }
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+    PS4_GLES_DestroySurface(_this, window);
+#endif
+
+    SDL_free(window->driverdata);
+    window->driverdata = NULL;
+}
+
+static void PS4_PumpEvents(_THIS)
+{
+    PS4_Keyboard_PumpEvents();
+    PS4_ImeDialog_PumpEvents();
+    PS4_Remote_PumpEvents();
+}
+
+static void PS4_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *PS4_CreateDevice(void)
+{
+    SDL_VideoDevice *device;
+
+    device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        SDL_OutOfMemory();
+        return NULL;
+    }
+
+    device->VideoInit = PS4_VideoInit;
+    device->VideoQuit = PS4_VideoQuit;
+    device->GetDisplayModes = PS4_GetDisplayModes;
+    device->SetDisplayMode = PS4_SetDisplayMode;
+    device->PumpEvents = PS4_PumpEvents;
+    device->CreateSDLWindow = PS4_CreateWindow;
+    device->SetWindowSize = PS4_SetWindowSize;
+    device->SetWindowFullscreen = PS4_SetWindowFullscreen;
+    device->DestroyWindow = PS4_DestroyWindow;
+    device->HasScreenKeyboardSupport = PS4_HasScreenKeyboardSupport;
+    device->ShowScreenKeyboard = PS4_ShowScreenKeyboard;
+    device->HideScreenKeyboard = PS4_HideScreenKeyboard;
+    device->IsScreenKeyboardShown = PS4_IsScreenKeyboardShown;
+    device->free = PS4_DeleteDevice;
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+    device->GL_LoadLibrary = PS4_GLES_LoadLibrary;
+    device->GL_GetProcAddress = SDL_EGL_GetProcAddress;
+    device->GL_UnloadLibrary = PS4_GLES_UnloadLibrary;
+    device->GL_CreateContext = PS4_GLES_CreateContext;
+    device->GL_MakeCurrent = PS4_GLES_MakeCurrent;
+    device->GL_SetSwapInterval = SDL_EGL_SetSwapInterval;
+    device->GL_GetSwapInterval = SDL_EGL_GetSwapInterval;
+    device->GL_SwapWindow = PS4_GLES_SwapWindow;
+    device->GL_DeleteContext = SDL_EGL_DeleteContext;
+#endif
+
+#ifdef SDL_VIDEO_VULKAN
+    device->Vulkan_LoadLibrary = PS4_Vulkan_LoadLibrary;
+    device->Vulkan_UnloadLibrary = PS4_Vulkan_UnloadLibrary;
+    device->Vulkan_GetInstanceExtensions = PS4_Vulkan_GetInstanceExtensions;
+    device->Vulkan_CreateSurface = PS4_Vulkan_CreateSurface;
+#endif
+
+    /* One display, in one mode, which every window fills. */
+    device->quirk_flags = VIDEO_DEVICE_QUIRK_FULLSCREEN_ONLY |
+                          VIDEO_DEVICE_QUIRK_DISABLE_DISPLAY_MODE_SWITCHING;
+
+    return device;
+}
+
+VideoBootStrap PS4_bootstrap = {
+    "ps4", "Sony PS4 Video Driver",
+    PS4_CreateDevice,
+    NULL /* no ShowMessageBox implementation */
+};
+
+#endif /* SDL_VIDEO_DRIVER_PS4 */
