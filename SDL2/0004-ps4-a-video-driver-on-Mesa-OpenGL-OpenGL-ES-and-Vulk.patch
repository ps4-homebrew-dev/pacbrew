+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_PS4
+
+/* Keyboards on the PS4.
+
+   A USB or Bluetooth keyboard is read with libSceKeyboard, which reports
+   the keys held down as USB HID usages, the same numbers as SDL's
+   scancodes. While text input is on, the keys also give text, as on a US
+   keyboard.
+
+   The on-screen keyboard is the system's IME dialog (libSceImeDialog): the
+   text it returns is sent as text input, followed by a press of Return.
+
+   The SDK has no link stubs for either library, so they are loaded when the
+   video driver starts. */
+
+#include "SDL_events.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../core/ps4/SDL_ps4.h"
+
+#include "SDL_ps4keyboard.h"
+
+/* libSceKeyboard */
+
+#define PS4_KEYBOARD_MAX_KEYCODES 16
+
+#define PS4_KEYBOARD_LOCK_NUM    0x01
+#define PS4_KEYBOARD_LOCK_CAPS   0x02
+#define PS4_KEYBOARD_LOCK_SCROLL 0x04
+
+typedef struct PS4_KeyboardData
+{
+    Uint64 timestamp;
+    Uint64 reserve0;
+    Uint8 connected;
+    Uint8 reserve1[3];
+    int length;                 /* how many keys are down */
+    Uint32 locks;
+    Uint32 modifiers;           /* as in a USB HID keyboard report */
+    Uint16 keycodes[PS4_KEYBOARD_MAX_KEYCODES];
+    Uint8 reserve2[32];
+} PS4_KeyboardData;
+
+SDL_COMPILE_TIME_ASSERT(PS4_KeyboardData, sizeof(PS4_KeyboardData) == 96);
+
+static void *keyboard_module = NULL;
+static int (*PS4_sceKeyboardInit)(void);
+static int (*PS4_sceKeyboardOpen)(int user_id, int type, int index, const void *param);
+static int (*PS4_sceKeyboardClose)(int handle);
+static int (*PS4_sceKeyboardReadState)(int handle, PS4_KeyboardData *data);
+
+static int keyboard_handle = -1;
+static Uint8 keyboard_keys[SDL_NUM_SCANCODES];
+static Uint32 keyboard_modifiers;
+static Uint32 keyboard_locks;
+
+/* Modifier bits, from the least significant one, as a USB keyboard has them */
+static const SDL_Scancode modifier_scancodes[8] = {
+    SDL_SCANCODE_LCTRL, SDL_SCANCODE_LSHIFT, SDL_SCANCODE_LALT, SDL_SCANCODE_LGUI,
+    SDL_SCANCODE_RCTRL, SDL_SCANCODE_RSHIFT, SDL_SCANCODE_RALT, SDL_SCANCODE_RGUI
+};
+
+int PS4_Keyboard_Init(void)
+{
+    int user_id;
+    int err;
+
+    if (keyboard_handle >= 0) {
+        return 0;
+    }
+
+    SDL_zeroa(keyboard_keys);
+    keyboard_modifiers = 0;
+    keyboard_locks = 0;
+
+    if (!keyboard_module) {
+        keyboard_module = PS4_LoadSystemModule(PS4_SYSMODULE_KEYBOARD, "libSceKeyboard.sprx");
+        if (!keyboard_module) {
+            return -1;
+        }
+    }
+
+    PS4_sceKeyboardInit = PS4_LoadFunction(keyboard_module, "sceKeyboardInit");
+    PS4_sceKeyboardOpen = PS4_LoadFunction(keyboard_module, "sceKeyboardOpen");
+    PS4_sceKeyboardClose = PS4_LoadFunction(keyboard_module, "sceKeyboardClose");
+    PS4_sceKeyboardReadState = PS4_LoadFunction(keyboard_module, "sceKeyboardReadState");
+    if (!PS4_sceKeyboardInit || !PS4_sceKeyboardOpen ||
+        !PS4_sceKeyboardClose || !PS4_sceKeyboardReadState) {
+        return -1;
+    }
+
+    err = PS4_sceKeyboardInit();
+    if (err < 0) {
+        return SDL_SetError("sceKeyboardInit: 0x%08x", (unsigned)err);
+    }
+
+    user_id = PS4_GetForegroundUser();
+    if (user_id == PS4_USER_ID_INVALID) {
+        return SDL_SetError("No user to open the keyboard for");
+    }
+
+    err = PS4_sceKeyboardOpen(user_id, 0, 0, NULL);
+    if (err < 0) {
+        return SDL_SetError("sceKeyboardOpen: 0x%08x", (unsigned)err);
+    }
+    keyboard_handle = err;
+
+    return 0;
+}
+
+/* The text a key gives on a US keyboard, or 0 for none. */
+static char PS4_Keyboard_KeyText(SDL_Scancode scancode, SDL_bool shift, SDL_bool caps, SDL_bool num)
+{
+    static const char shifted_digits[] = "!@#$%^&*()";
+    static const struct
+    {
+        SDL_Scancode scancode;
+        char normal;
+        char shifted;
+    } punctuation[] = {
+        { SDL_SCANCODE_SPACE, ' ', ' ' },
+        { SDL_SCANCODE_MINUS, '-', '_' },
+        { SDL_SCANCODE_EQUALS, '=', '+' },
+        { SDL_SCANCODE_LEFTBRACKET, '[', '{' },
+        { SDL_SCANCODE_RIGHTBRACKET, ']', '}' },
+        { SDL_SCANCODE_BACKSLASH, '\\', '|' },
+        { SDL_SCANCODE_NONUSHASH, '#', '~' },
+        { SDL_SCANCODE_SEMICOLON, ';', ':' },
+        { SDL_SCANCODE_APOSTROPHE, '\'', '"' },
+        { SDL_SCANCODE_GRAVE, '`', '~' },
+        { SDL_SCANCODE_COMMA, ',', '<' },
+        { SDL_SCANCODE_PERIOD, '.', '>' },
+        { SDL_SCANCODE_SLASH, '/', '?' },
+        { SDL_SCANCODE_NONUSBACKSLASH, '\\', '|' },
+        { SDL_SCANCODE_KP_DIVIDE, '/', '/' },
+        { SDL_SCANCODE_KP_MULTIPLY, '*', '*' },
+        { SDL_SCANCODE_KP_MINUS, '-', '-' },
+        { SDL_SCANCODE_KP_PLUS, '+', '+' },
+    };
+    int i;
+
+    if (scancode >= SDL_SCANCODE_A && scancode <= SDL_SCANCODE_Z) {
+        char c = (char)('a' + (scancode - SDL_SCANCODE_A));
+        return (shift != caps) ? (char)(c - 'a' + 'A') : c;
+    }
+    if (scancode >= SDL_SCANCODE_1 && scancode <= SDL_SCANCODE_0) {
+        if (shift) {
+            return shifted_digits[scancode - SDL_SCANCODE_1];
+        }
+        return (scancode == SDL_SCANCODE_0) ? '0' : (char)('1' + (scancode - SDL_SCANCODE_1));
+    }
+    if (num && scancode >= SDL_SCANCODE_KP_1 && scancode <= SDL_SCANCODE_KP_0) {
+        return (scancode == SDL_SCANCODE_KP_0) ? '0' : (char)('1' + (scancode - SDL_SCANCODE_KP_1));
+    }
+    if (num && scancode == SDL_SCANCODE_KP_PERIOD) {
+        return '.';
+    }
+    for (i = 0; i < (int)SDL_arraysize(punctuation); i++) {
+        if (punctuation[i].scancode == scancode) {
+            return shift ? punctuation[i].shifted : punctuation[i].normal;
+        }
+    }
+    return 0;
+}
+
+static void PS4_Keyboard_SetKeys(const Uint8 *keys, Uint32 modifiers)
+{
+    const SDL_bool shift = (modifiers & 0x22) ? SDL_TRUE : SDL_FALSE;
+    const SDL_bool ctrl_alt_gui = (modifiers & 0xdd) ? SDL_TRUE : SDL_FALSE;
+    const SDL_bool caps = (keyboard_locks & PS4_KEYBOARD_LOCK_CAPS) ? SDL_TRUE : SDL_FALSE;
+    const SDL_bool num = (keyboard_locks & PS4_KEYBOARD_LOCK_NUM) ? SDL_TRUE : SDL_FALSE;
+    Uint32 changed = keyboard_modifiers ^ modifiers;
+    char text[2];
+    int i;
+
+    for (i = 0; i < 8; i++) {
+        if (changed & (1u << i)) {
+            SDL_SendKeyboardKey((modifiers & (1u << i)) ? SDL_PRESSED : SDL_RELEASED,
+                                modifier_scancodes[i]);
+        }
+    }
+    keyboard_modifiers = modifiers;
+
+    for (i = 0; i < SDL_NUM_SCANCODES; i++) {
+        if (keys[i] == keyboard_keys[i]) {
+            continue;
+        }
+        keyboard_keys[i] = keys[i];
+        SDL_SendKeyboardKey(keys[i] ? SDL_PRESSED : SDL_RELEASED, (SDL_Scancode)i);
+
+        if (keys[i] && !ctrl_alt_gui && SDL_IsTextInputActive()) {
+            text[0] = PS4_Keyboard_KeyText((SDL_Scancode)i, shift, caps, num);
+            text[1] = '\0';
+            if (text[0]) {
+                SDL_SendKeyboardText(text);
+            }
+        }
+    }
+}
+
+void PS4_Keyboard_PumpEvents(void)
+{
+    Uint8 keys[SDL_NUM_SCANCODES];
+    PS4_KeyboardData data;
+    Uint32 modifiers = 0;
+    int i;
+
+    if (keyboard_handle < 0) {
+        return;
+    }
+
+    SDL_zero(data);
+    SDL_zeroa(keys);
+
+    /* On a read error or with no keyboard, everything is let go of. */
+    if (PS4_sceKeyboardReadState(keyboard_handle, &data) == 0 && data.connected) {
+        int length = SDL_clamp(data.length, 0, PS4_KEYBOARD_MAX_KEYCODES);
+
+        for (i = 0; i < length; i++) {
+            /* 0 is no key, 1 to 3 are the keyboard's errors, and the
+               modifiers come from their own bits */
+            if (data.keycodes[i] > 3 && data.keycodes[i] < SDL_NUM_SCANCODES &&
+                (data.keycodes[i] < SDL_SCANCODE_LCTRL || data.keycodes[i] > SDL_SCANCODE_RGUI)) {
+                keys[data.keycodes[i]] = 1;
+            }
+        }
+        modifiers = data.modifiers & 0xff;
+
+        if (data.locks != keyboard_locks) {
+            keyboard_locks = data.locks;
+            SDL_ToggleModState(KMOD_NUM, (keyboard_locks & PS4_KEYBOARD_LOCK_NUM) ? SDL_TRUE : SDL_FALSE);
+            SDL_ToggleModState(KMOD_CAPS, (keyboard_locks & PS4_KEYBOARD_LOCK_CAPS) ? SDL_TRUE : SDL_FALSE);
+            SDL_ToggleModState(KMOD_SCROLL, (keyboard_locks & PS4_KEYBOARD_LOCK_SCROLL) ? SDL_TRUE : SDL_FALSE);
+        }
+    }
+
+    PS4_Keyboard_SetKeys(keys, modifiers);
+}
+
+void PS4_Keyboard_Quit(void)
+{
+    if (keyboard_handle >= 0) {
+        PS4_sceKeyboardClose(keyboard_handle);
+        keyboard_handle = -1;
+    }
+}
+
+/* libSceImeDialog */
+
+typedef enum
+{
+    PS4_IME_DIALOG_STATUS_NONE = 0,
+    PS4_IME_DIALOG_STATUS_RUNNING = 1,
+    PS4_IME_DIALOG_STATUS_FINISHED = 2
+} PS4_ImeDialogStatus;
+
+typedef enum
+{
+    PS4_IME_DIALOG_END_STATUS_OK = 0,
+    PS4_IME_DIALOG_END_STATUS_USER_CANCELED = 1,
+    PS4_IME_DIALOG_END_STATUS_ABORTED = 2
+} PS4_ImeDialogEndStatus;
+
+typedef struct PS4_ImeDialogParam
+{
+    int userId;
+    int type;                   /* 0: default */
+    Uint64 supportedLanguages;  /* 0: all */
+    int enterLabel;             /* 0: default */
+    int inputMethod;            /* 0: default */
+    void *filter;
+    Uint32 option;
+    Uint32 maxTextLength;
+    Uint16 *inputTextBuffer;    /* UTF-16 */
+    float posx;
+    float posy;
+    int horizontalAlignment;
+    int verticalAlignment;
+    const Uint16 *placeholder;
+    const Uint16 *title;
+    Sint8 reserved[16];
+} PS4_ImeDialogParam;
+
+typedef struct PS4_ImeDialogResult
+{
+    int endstatus;
+    Sint8 reserved[12];
+} PS4_ImeDialogResult;
+
+SDL_COMPILE_TIME_ASSERT(PS4_ImeDialogParam, sizeof(PS4_ImeDialogParam) == 96);
+
+#define PS4_IME_DIALOG_MAX_TEXT_LENGTH 2048
+
+/* Where the dialog goes: the middle of the 1920x1080 screen the system
+   draws it on. */
+#define PS4_IME_DIALOG_POS_X       960.0f
+#define PS4_IME_DIALOG_POS_Y       540.0f
+#define PS4_IME_HALIGN_CENTER      1
+#define PS4_IME_VALIGN_CENTER      1
+
+static void *ime_dialog_module = NULL;
+static int (*PS4_sceImeDialogInit)(const PS4_ImeDialogParam *param, const void *extended);
+static int (*PS4_sceImeDialogGetStatus)(void);
+static int (*PS4_sceImeDialogGetResult)(PS4_ImeDialogResult *result);
+static int (*PS4_sceImeDialogTerm)(void);
+
+static SDL_bool ime_dialog_shown = SDL_FALSE;
+static Uint16 ime_dialog_text[PS4_IME_DIALOG_MAX_TEXT_LENGTH + 1];
+static Uint16 ime_dialog_title[1];
+
+static SDL_bool PS4_ImeDialog_Load(void)
+{
+    void *common_dialog;
+
+    if (ime_dialog_module) {
+        return SDL_TRUE;
+    }
+
+    /* The dialog is one of the system's common dialogs. */
+    common_dialog = PS4_LoadSystemModule(PS4_SYSMODULE_INTERNAL_COMMON_DIALOG, "libSceCommonDialog.sprx");
+    if (common_dialog) {
+        int (*PS4_sceCommonDialogInitialize)(void) =
+            PS4_LoadFunction(common_dialog, "sceCommonDialogInitialize");
+        if (PS4_sceCommonDialogInitialize) {
+            PS4_sceCommonDialogInitialize(); /* fails harmlessly if already done */
+        }
+    }
+
+    ime_dialog_module = PS4_LoadSystemModule(PS4_SYSMODULE_IME_DIALOG, "libSceImeDialog.sprx");
+    if (!ime_dialog_module) {
+        return SDL_FALSE;
+    }
+
+    PS4_sceImeDialogInit = PS4_LoadFunction(ime_dialog_module, "sceImeDialogInit");
+    PS4_sceImeDialogGetStatus = PS4_LoadFunction(ime_dialog_module, "sceImeDialogGetStatus");
+    PS4_sceImeDialogGetResult = PS4_LoadFunction(ime_dialog_module, "sceImeDialogGetResult");
+    PS4_sceImeDialogTerm = PS4_LoadFunction(ime_dialog_module, "sceImeDialogTerm");
+    if (!PS4_sceImeDialogInit || !PS4_sceImeDialogGetStatus ||
+        !PS4_sceImeDialogGetResult || !PS4_sceImeDialogTerm) {
+        ime_dialog_module = NULL;
+        return SDL_FALSE;
+    }
+
+    return SDL_TRUE;
+}
+
+static void PS4_ImeDialog_SendText(void)
+{
+    size_t length = 0;
+    char *utf8;
+
+    while (length < PS4_IME_DIALOG_MAX_TEXT_LENGTH && ime_dialog_text[length]) {
+        length++;
+    }
+    if (!length) {
+        return;
+    }
+
+    utf8 = SDL_iconv_string("UTF-8", "UTF-16LE", (const char *)ime_dialog_text,
+                            length * sizeof(Uint16));
+    if (utf8) {
+        SDL_SendKeyboardText(utf8);
+        SDL_free(utf8);
+    }
+}
+
+void PS4_ImeDialog_PumpEvents(void)
+{
+    PS4_ImeDialogResult result;
+
+    if (!ime_dialog_shown) {
+        return;
+    }
+
+    switch (PS4_sceImeDialogGetStatus()) {
+    case PS4_IME_DIALOG_STATUS_RUNNING:
+        return;
+
+    case PS4_IME_DIALOG_STATUS_FINISHED:
+        SDL_zero(result);
+        if (PS4_sceImeDialogGetResult(&result) == 0 &&
+            result.endstatus == PS4_IME_DIALOG_END_STATUS_OK) {
+            PS4_ImeDialog_SendText();
+            SDL_SendKeyboardKeyAutoRelease(SDL_SCANCODE_RETURN);
+        }
+        break;
+
+    default:
+        break;
+    }
+
+    PS4_sceImeDialogTerm();
+    ime_dialog_shown = SDL_FALSE;
+}
+
+void PS4_ImeDialog_Quit(void)
+{
+    if (ime_dialog_shown) {
+        PS4_sceImeDialogTerm();
+        ime_dialog_shown = SDL_FALSE;
+    }
+}
+
+SDL_bool PS4_HasScreenKeyboardSupport(_THIS)
+{
+    return SDL_TRUE;
+}
+
+void PS4_ShowScreenKeyboard(_THIS, SDL_Window *window)
+{
+    PS4_ImeDialogParam param;
+    int err;
+
+    if (ime_dialog_shown || !PS4_ImeDialog_Load()) {
+        return;
+    }
+
+    SDL_zeroa(ime_dialog_text);
+    SDL_zeroa(ime_dialog_title);
+
+    SDL_zero(param);
+    param.userId = PS4_GetForegroundUser();
+    param.maxTextLength = PS4_IME_DIALOG_MAX_TEXT_LENGTH;
+    param.inputTextBuffer = ime_dialog_text;
+    param.title = ime_dialog_title;
+    param.posx = PS4_IME_DIALOG_POS_X;
+    param.posy = PS4_IME_DIALOG_POS_Y;
+    param.horizontalAlignment = PS4_IME_HALIGN_CENTER;
+    param.verticalAlignment = PS4_IME_VALIGN_CENTER;
+
+    err = PS4_sceImeDialogInit(&param, NULL);
+    if (err < 0) {
+        SDL_SetError("sceImeDialogInit: 0x%08x", (unsigned)err);
+        return;
+    }
+    ime_dialog_shown = SDL_TRUE;
+}
+
+void PS4_HideScreenKeyboard(_THIS, SDL_Window *window)
+{
+    PS4_ImeDialog_Quit();
+}
+
+SDL_bool PS4_IsScreenKeyboardShown(_THIS, SDL_Window *window)
+{
+    return ime_dialog_shown;
+}
+
+#endif /* SDL_VIDEO_DRIVER_PS4 */
+
+/* vi: set ts=4 sw=4 expandtab: */
