new file mode 100644
index 000000000..51e201edb
--- /dev/null
+++ b/src/video/ps4/SDL_ps4opengles.c
@@ -0,0 +1,86 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2025 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "../../SDL_internal.h"
+
+#if defined(SDL_VIDEO_DRIVER_PS4) && defined(SDL_VIDEO_OPENGL_EGL)
+
+#include "SDL_ps4video.h"
+
+/* OpenGL and OpenGL ES through EGL, as on Linux without a window system:
+   Mesa's libEGL.so.1 (zink on RADV, and its "videoout" EGL platform) and
+   libGLESv2.so.2, loaded when a program first asks for a GL window. Mesa
+   has no libGL on the PS4: OpenGL functions come from eglGetProcAddress().
+   The display is EGL_DEFAULT_DISPLAY, and any non-zero native window is the
+   screen. */
+
+#define PS4_EGL_NATIVE_WINDOW ((NativeWindowType)1)
+
+int PS4_GLES_LoadLibrary(_THIS, const char *path)
+{
+    return SDL_EGL_LoadLibrary(_this, path, EGL_DEFAULT_DISPLAY, 0);
+}
+
+/* The EGL display is terminated, but Mesa's libraries stay loaded: they
+   register atexit() handlers, which must still be there when the program
+   exits, and keep VideoOut for the whole process. Loading them again just
+   takes another reference. */
+void PS4_GLES_UnloadLibrary(_THIS)
+{
+    if (_this->egl_data) {
+        _this->egl_data->egl_dll_handle = NULL;
+        _this->egl_data->opengl_dll_handle = NULL;
+    }
+    SDL_EGL_UnloadLibrary(_this);
+}
+
+int PS4_GLES_CreateSurface(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data = (SDL_WindowData *)window->driverdata;
+
+    if (!_this->egl_data && SDL_GL_LoadLibrary(NULL) < 0) {
+        return -1;
+    }
+
+    data->egl_surface = SDL_EGL_CreateSurface(_this, PS4_EGL_NATIVE_WINDOW);
+    if (data->egl_surface == EGL_NO_SURFACE) {
+        return SDL_SetError("Could not create the EGL window surface");
+    }
+    return 0;
+}
+
+void PS4_GLES_DestroySurface(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data = (SDL_WindowData *)window->driverdata;
+
+    if (data->egl_surface != EGL_NO_SURFACE) {
+        SDL_EGL_MakeCurrent(_this, EGL_NO_SURFACE, NULL);
+        SDL_EGL_DestroySurface(_this, data->egl_surface);
+        data->egl_surface = EGL_NO_SURFACE;
+    }
+}
+
+SDL_EGL_CreateContext_impl(PS4)
+SDL_EGL_MakeCurrent_impl(PS4)
+SDL_EGL_SwapWindow_impl(PS4)
+
+#endif /* SDL_VIDEO_DRIVER_PS4 && SDL_VIDEO_OPENGL_EGL */
+
+/* vi: set ts=4 sw=4 expandtab: */
diff --git a/src/video/ps4/SDL_ps4remote.c b/src/video/ps4/SDL_ps4remote.c
new file mode 100644
index 000000000..39bb3ca7a
--- /dev/null
+++ b/src/video/ps4/SDL_ps4remote.c
@@ -0,0 +1,128 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2025 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_PS4
+
+/* A media remote, on libScePad's remote control port, as keys.
+
+   The PS4 has no HDMI-CEC remote, and its media remotes are not the
+   PS5's: only what a remote reports as the controller's buttons is used
+   (the arrows, X, O and OPTIONS), not the PS5's table of CEC key codes. When
+   the port cannot be opened, there is simply no remote. */
+
+#include "SDL_events.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../core/ps4/SDL_ps4.h"
+#include "../../joystick/ps4/SDL_ps4joystick.h"
+
+#include "SDL_ps4remote.h"
+
+static const struct
+{
+    Uint32 button;
+    SDL_Scancode scancode;
+} remote_button_map[] = {
+    { PS4_PAD_BUTTON_UP, SDL_SCANCODE_UP },
+    { PS4_PAD_BUTTON_DOWN, SDL_SCANCODE_DOWN },
+    { PS4_PAD_BUTTON_LEFT, SDL_SCANCODE_LEFT },
+    { PS4_PAD_BUTTON_RIGHT, SDL_SCANCODE_RIGHT },
+    { PS4_PAD_BUTTON_CROSS, SDL_SCANCODE_RETURN },  /* "enter" */
+    { PS4_PAD_BUTTON_CIRCLE, SDL_SCANCODE_ESCAPE }, /* "back" */
+    { PS4_PAD_BUTTON_OPTIONS, SDL_SCANCODE_MENU },
+};
+
+static int remote_handle = -1;
+static Uint32 remote_buttons = 0;
+
+static void PS4_Remote_SetButtons(Uint32 buttons)
+{
+    Uint32 changed = remote_buttons ^ buttons;
+    int i;
+
+    remote_buttons = buttons;
+    for (i = 0; i < (int)SDL_arraysize(remote_button_map); i++) {
+        if (changed & remote_button_map[i].button) {
+            SDL_SendVirtualKeyboardKey((buttons & remote_button_map[i].button) ? SDL_PRESSED : SDL_RELEASED,
+                                       remote_button_map[i].scancode);
+        }
+    }
+}
+
+int PS4_Remote_Init(void)
+{
+    int handle;
+
+    if (remote_handle >= 0) {
+        return 0;
+    }
+    remote_buttons = 0;
+
+    if (PS4_InitPad() < 0) {
+        return -1;
+    }
+
+    handle = scePadOpen(PS4_USER_ID_SYSTEM, PS4_PAD_PORT_TYPE_REMOTE_CONTROL, 0, NULL);
+    if ((unsigned)handle == PS4_PAD_ERROR_ALREADY_OPENED) {
+        handle = scePadGetHandle(PS4_USER_ID_SYSTEM, PS4_PAD_PORT_TYPE_REMOTE_CONTROL, 0);
+    }
+    if (handle < 0) {
+        return SDL_SetError("scePadOpen: 0x%08x", (unsigned)handle);
+    }
+    remote_handle = handle;
+
+    return 0;
+}
+
+void PS4_Remote_PumpEvents(void)
+{
+    PS4_PadData pad;
+    Uint32 buttons = 0;
+    int i;
+
+    if (remote_handle < 0) {
+        return;
+    }
+
+    /* On a read error or with no remote, everything is let go of. */
+    SDL_zero(pad);
+    if (scePadReadState(remote_handle, &pad) == 0 && pad.connected) {
+        for (i = 0; i < (int)SDL_arraysize(remote_button_map); i++) {
+            buttons |= pad.buttons & remote_button_map[i].button;
+        }
+    }
+
+    PS4_Remote_SetButtons(buttons);
+}
+
+void PS4_Remote_Quit(void)
+{
+    PS4_Remote_SetButtons(0);
+
+    if (remote_handle >= 0) {
+        scePadClose(remote_handle);
+        remote_handle = -1;
+    }
+}
+
+#endif /* SDL_VIDEO_DRIVER_PS4 */
+
+/* vi: set ts=4 sw=4 expandtab: */
