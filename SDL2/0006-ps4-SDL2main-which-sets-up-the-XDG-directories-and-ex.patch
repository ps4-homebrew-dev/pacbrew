diff --git a/src/main/ps4/SDL_ps4_main.c b/src/main/ps4/SDL_ps4_main.c
new file mode 100644
index 000000000..39266c8df
--- /dev/null
+++ b/src/main/ps4/SDL_ps4_main.c
@@ -0,0 +1,140 @@
+/*
+    SDL_ps4_main.c, the entry point of a PS4 program that links SDL2main.
+    Placed in the public domain.
+*/
+#include "SDL_config.h"
+
+#ifdef __PS4__
+
+#include "SDL_main.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#ifdef main
+#undef main
+#endif
+
+/* libkernel */
+extern int sceKernelDebugOutText(int channel, const char *text);
+extern int sceKernelIsInSandbox(void);
+extern const char *sceKernelGetFsSandboxRandomWord(void);
+
+/* libSceSysmodule */
+extern int sceSysmoduleLoadModule(unsigned short id);
+
+/* libSceSystemService */
+extern int sceSystemServiceLoadExec(const char *path, char *const argv[]);
+
+/* libSceAppContent */
+extern int sceAppContentInitialize(const void *init, void *boot);
+extern int sceAppContentTemporaryDataMount2(unsigned int type, void *mount);
+
+#define PS4_SYSMODULE_APP_CONTENT 0x00b4
+
+typedef struct
+{
+    unsigned char reserved[32];
+} PS4_AppContentInitParam;
+
+typedef struct
+{
+    unsigned char reserved1[4];
+    unsigned int attr;
+    unsigned char reserved2[32];
+} PS4_AppContentBootParam;
+
+typedef struct
+{
+    unsigned char data[16];
+} PS4_AppContentMountParam;
+
+static PS4_AppContentMountParam PS4_temp0_mount;
+
+/* Points the XDG base directories at folders in dir, unless the program was
+   started with them set. */
+static void PS4_SetXdgDirs(const char *dir)
+{
+    static const char *const names[][2] = {
+        { "XDG_CACHE_HOME", ".cache" },
+        { "XDG_CONFIG_HOME", ".config" },
+        { "XDG_DATA_HOME", ".data" },
+        { "XDG_STATE_HOME", ".state" },
+    };
+    char path[256];
+    size_t i;
+
+    for (i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+        snprintf(path, sizeof(path), "%s/%s", dir, names[i][1]);
+        setenv(names[i][0], path, 0);
+        mkdir(path, 0755);
+    }
+}
+
+/* Mounts the title's temporary data at /temp0. Returns 0 on success. */
+static int PS4_MountTemp0(void)
+{
+    PS4_AppContentInitParam init;
+    PS4_AppContentBootParam boot;
+    int err;
+
+    memset(&init, 0, sizeof(init));
+    memset(&boot, 0, sizeof(boot));
+
+    sceSysmoduleLoadModule(PS4_SYSMODULE_APP_CONTENT);
+    sceAppContentInitialize(&init, &boot);
+
+    err = sceAppContentTemporaryDataMount2(0, &PS4_temp0_mount);
+    if (err) {
+        char msg[96];
+        snprintf(msg, sizeof(msg), "<118>[SDL2main] sceAppContentTemporaryDataMount2: 0x%08x\n", (unsigned)err);
+        sceKernelDebugOutText(0, msg);
+    }
+    return err;
+}
+
+/* The XDG base directories, for the files of the program: in the temporary
+   data of the title when it can be mounted (only a game can), otherwise in
+   the folder all homebrew shares. /data is not always mounted. */
+static void PS4_InitXdgDirs(void)
+{
+    char dir[128];
+
+    if (!sceKernelIsInSandbox()) {
+        PS4_SetXdgDirs("/user/temp/common_temp");
+    } else if (!PS4_MountTemp0()) {
+        PS4_SetXdgDirs("/temp0");
+    } else {
+        snprintf(dir, sizeof(dir), "/%s/common_temp", sceKernelGetFsSandboxRandomWord());
+        PS4_SetXdgDirs(dir);
+    }
+}
+
+/* If the application's main() is redefined as SDL_main, and SDL2main is
+   linked, this sets up the XDG base directories (SDL_GetPrefPath() is in
+   XDG_DATA_HOME, and Mesa's shader cache in XDG_CACHE_HOME), and, when the
+   program is finished, exits back to the home screen.
+
+   If you provide your own main(), you may define SDL_MAIN_HANDLED; then you
+   set up the XDG base directories yourself, or SDL_GetPrefPath() fails.
+*/
+int main(int argc, char *argv[])
+{
+    int ret;
+
+    PS4_InitXdgDirs();
+
+    SDL_SetMainReady();
+
+    ret = SDL_main(argc, argv);
+
+    fflush(NULL);
+    sceSystemServiceLoadExec("exit", NULL);
+    return ret;
+}
+
+#endif /* __PS4__ */
+
+/* vi: set ts=4 sw=4 expandtab: */
