 CMakeLists.txt                         |  13 ++-
 docs/README-ps4.md                     |  31 +++++-
 include/SDL_main.h                     |   9 ++
 src/filesystem/ps4/SDL_sysfilesystem.c |   2 +-
 src/main/ps4/SDL_ps4_main.c            | 140 +++++++++++++++++++++++++
 5 files changed, 189 insertions(+), 6 deletions(-)
 create mode 100644 src/main/ps4/SDL_ps4_main.c

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f308f49e0..9fe8febde 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1485,8 +1485,14 @@ elseif(PS4)
 
   file(GLOB PS4_CORE_SOURCES ${SDL2_SOURCE_DIR}/src/core/ps4/*.c)
   list(APPEND SOURCE_FILES ${PS4_CORE_SOURCES})
-  # The system libraries SDL links; the others are loaded when used.
-  list(APPEND EXTRA_LIBS ScePad SceUserService SceSystemService SceSysmodule)
+  file(GLOB PS4_MAIN_SOURCES ${SDL2_SOURCE_DIR}/src/main/ps4/*.c)
+  list(APPEND SDLMAIN_SOURCES ${PS4_MAIN_SOURCES})
+  # The system libraries SDL links (libSceAppContent is for SDL2main); the
+  # others are loaded when used.
+  list(APPEND EXTRA_LIBS ScePad SceUserService SceSystemService SceSysmodule SceAppContent)
+  if(NOT SDL2_DISABLE_SDL2MAIN)
+    list(INSERT SDL_LIBS 0 "-lSDL2main")
+  endif()
 
   if(SDL_AUDIO)
     set(SDL_AUDIO_DRIVER_PS4 1)
@@ -3479,6 +3485,9 @@ if(NOT WINDOWS_STORE AND NOT SDL2_DISABLE_SDL2MAIN)
   # Build SDLmain
   add_library(SDL2main STATIC ${SDLMAIN_SOURCES})
   add_dependencies(SDL2main sdl_headers_copy)
+  if(PS4)
+    target_link_libraries(SDL2main PUBLIC SceAppContent SceSystemService SceSysmodule)
+  endif()
   # alias target for in-tree builds
   add_library(SDL2::SDL2main ALIAS SDL2main)
   target_include_directories(SDL2main BEFORE
