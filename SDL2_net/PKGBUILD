pkgname=ps4-homebrew-sdl2_net
pkgver=2.2.0
pkgrel=1
pkgdesc="A small sample cross-platform networking library (Version 2)"
arch=('any')
url="https://github.com/libsdl-org/SDL_net"
license=('MIT')
options=(!strip !libtool staticlibs)
source=("https://github.com/libsdl-org/SDL_net/releases/download/release-${pkgver}/SDL2_net-${pkgver}.tar.gz")
sha256sums=('4e4a891988316271974ff4e9585ed1ef729a123d22c08bd473129179dc857feb')
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk')
depends=('ps4-homebrew-sdl2')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd SDL2_net-$pkgver

    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--enable-static --disable-shared
    ${MAKE}
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd SDL2_net-$pkgver

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} install
}
