pkgname=ps4-homebrew-libmad
pkgver=0.16.4
pkgrel=1
pkgdesc="A high-quality MPEG audio decoder"
arch=('any')
url="https://www.underbit.com/products/mad/"
license=('GPL')
source=("https://codeberg.org/tenacityteam/libmad/releases/download/${pkgver}/libmad-${pkgver}.tar.gz")
sha256sums=('0f6bfb36c554075494b5fc2c646d08de7364819540f23bab30ae73fa1b5cfe65')
options=(!strip !libtool staticlibs)
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-libcxx')


prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd libmad

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
	    -B build \
        -S .
    ${MAKE} -C build
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd libmad

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} -C build install
}
