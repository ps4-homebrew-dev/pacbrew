pkgname=ps4-homebrew-dav1d
pkgver=1.5.1
pkgrel=1
pkgdesc='AV1 cross-platform decoder focused on speed and correctness'
url='https://code.videolan.org/videolan/dav1d'
arch=('any')
license=('BSD-2-Clause')
options=(!strip !libtool staticlibs)
source=("https://code.videolan.org/videolan/dav1d/-/archive/${pkgver}/dav1d-${pkgver}.tar.gz"
	'0001-thread.h-let-pthread_np.h-include-sys-param.h-on-FreeBSD.patch')
sha256sums=('fa635e2bdb25147b1384007c83e15de44c589582bb3b9a53fc1579cb9d74b695'
	    '31f60ef9efe36462d2e057417663ac4b4feeff1496bfa67d5557c7ef50ad1427')
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi

    cd dav1d-${pkgver}
    local p
    for p in "${srcdir}"/[0-9][0-9][0-9][0-9]-*.patch; do
	patch -Np1 -i "$p"
    done
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd dav1d-${pkgver}

    # The x86 assembly (SSSE3/AVX) is what makes software AV1 usable on
    # the PS4's Jaguar cores; it needs nasm on the build host.
    ${MESON} setup builddir \
	     -Denable_asm=true \
	     -Denable_tools=false \
	     -Denable_tests=false \
	     -Denable_examples=false
    ${MESON} compile -C builddir
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd dav1d-${pkgver}

    ${MESON} install -C builddir --destdir "${pkgdir}/${SYSROOT}"
}
