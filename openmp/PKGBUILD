pkgname=ps4-homebrew-openmp
pkgver=15.0.7
pkgrel=1
pkgdesc="LLVM OpenMP Runtime Library"
arch=(any)
url="https://openmp.llvm.org/"
license=('Apache2')
options=(!strip staticlibs)
source=("https://github.com/llvm/llvm-project/releases/download/llvmorg-${pkgver}/llvm-project-${pkgver}.src.tar.xz")
sha256sums=('8b5fcb24b4128cf04df1b0b9410ce8b1a729cb3c544e6da885d234280dedeac6')
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-libcxx')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd llvm-project-$pkgver.src

    ${CMAKE} -S runtimes -B build \
	     -DCMAKE_INSTALL_PREFIX="${PS4_HOMEBREW_SDK}/target" \
	     -DCMAKE_BUILD_TYPE=Release \
	     -DLLVM_ENABLE_RUNTIMES="openmp" \
	     -DLIBOMP_ENABLE_SHARED=NO \
	     -DOPENMP_STANDALONE_BUILD=YES \
	     -DOPENMP_ENABLE_LIBOMPTARGET=NO \
	     -DOPENMP_ENABLE_OMPT_TOOLS=NO
    ${MAKE} -C build
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd llvm-project-$pkgver.src

    ${MAKE} -C build install DESTDIR="${pkgdir}"
}
