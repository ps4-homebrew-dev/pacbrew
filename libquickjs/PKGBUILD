pkgname=ps4-homebrew-libquickjs
pkgver=2026.06.04
pkgrel=1
pkgdesc='A small and embeddable Javascript engine'
arch=('any')
url='https://bellard.org/quickjs/'
license=('MIT')
options=(!strip !libtool staticlibs)
source=('https://bellard.org/quickjs/quickjs-2026-06-04.tar.xz')
sha256sums=('b376e839b322978313d929fd20663b11ba58b75df5a46c126dd19ea2fa70ad2a')
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-openlibm')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}


build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd quickjs-2026-06-04

    ${MAKE} CC="${CC}" AR="${AR}" libquickjs.a
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd quickjs-2026-06-04

    mkdir -p "${pkgdir}/${SYSROOT}${PREFIX}/lib/quickjs"
    mkdir -p "${pkgdir}/${SYSROOT}${PREFIX}/include/quickjs"

    install -m644 libquickjs.a "${pkgdir}/${SYSROOT}${PREFIX}/lib/quickjs"
    install -m644 quickjs.h quickjs-libc.h "${pkgdir}/${SYSROOT}${PREFIX}/include/quickjs"
}
