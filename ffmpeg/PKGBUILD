pkgname=ps4-homebrew-ffmpeg
pkgver=8.1.3
pkgrel=2
pkgdesc='Complete solution to record, convert and stream audio and video'
arch=('any')
url='https://ffmpeg.org'
license=('LGPL' 'GPL')
options=(!strip !libtool staticlibs)
source=("https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n$pkgver.tar.gz")
sha256sums=('SKIP')
groups=('ps4-homebrew-dev')
depends=('ps4-homebrew-zlib' 'ps4-homebrew-openssl' 'ps4-homebrew-freetype'
	 'ps4-homebrew-libfribidi' 'ps4-homebrew-harfbuzz' 'ps4-homebrew-libass'
	 'ps4-homebrew-dav1d')
makedepends=('ps4-homebrew-sdk')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd FFmpeg-n$pkgver

    ./configure \
	--prefix="${PREFIX}" --enable-cross-compile \
	--cross-prefix="${PS4_HOMEBREW_SDK}/bin/orbis-" \
	--enable-static --disable-shared \
	--arch=x86_64 --target-os=freebsd \
	--enable-openssl --enable-version3 \
	--enable-libfreetype --enable-libfribidi --enable-libharfbuzz \
	--enable-gpl \
	--disable-debug --disable-doc --disable-programs \
	--enable-libass \
	--enable-libdav1d \
	--cc="${CC}" --cxx="${CXX}" --nm="${NM}" --strip="${STRIP}" \
	--ar="${AR}" --ranlib="${RANLIB}" --pkg-config="${PKG_CONFIG}"
    ${MAKE}
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd FFmpeg-n$pkgver

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} install
}
