From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?John=20T=C3=B6rnblom?= <john.tornblom@gmail.com>
Date: Sat, 17 Oct 2026 15:35:01 +0000
Subject: [PATCH 09/13] radv: pipeline representations that were not recorded

ACO's IR is printed through a memstream, which may not exist (a platform
without open_memstream whose tmpfile() fails), and there is no
disassembly without LLVM. A representation that was not recorded reads
as empty text, and the assembly is counted only when there is some.

Co-authored-by: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01R3DbSodVLhQVcvZSazbPue
---
 src/amd/vulkan/radv_pipeline.c | 24 ++++++++++++++++--------
 1 file changed, 16 insertions(+), 8 deletions(-)

diff --git a/src/amd/vulkan/radv_pipeline.c b/src/amd/vulkan/radv_pipeline.c
index 6e48fa1..4f3a065 100644
--- a/src/amd/vulkan/radv_pipeline.c
+++ b/src/amd/vulkan/radv_pipeline.c
@@ -1000,6 +1000,12 @@ radv_GetPipelineExecutableStatisticsKHR(VkDevice _device, const VkPipelineExecut
 static VkResult
 radv_copy_representation(void *data, size_t *data_size, const char *src)
 {
+   /* A representation that was not recorded (ACO's IR and disassembly are
+    * printed through open_memstream, which a platform may lack) reads as
+    * empty text. */
+   if (!src)
+      src = "";
+
    size_t total_size = strlen(src) + 1;
 
    if (!data) {
@@ -1056,15 +1062,17 @@ radv_GetPipelineExecutableInternalRepresentationsKHR(
    }
    ++p;
 
-   /* Disassembler */
-   if (p < end && shader->dbg.disasm_string) {
-      p->isText = true;
-      VK_COPY_STR(p->name, "Assembly");
-      VK_COPY_STR(p->description, "Final Assembly");
-      if (radv_copy_representation(p->pData, &p->dataSize, shader->dbg.disasm_string) != VK_SUCCESS)
-         result = VK_INCOMPLETE;
+   /* Disassembler: only when there is one (ACO disassembles through LLVM). */
+   if (shader->dbg.disasm_string) {
+      if (p < end) {
+         p->isText = true;
+         VK_COPY_STR(p->name, "Assembly");
+         VK_COPY_STR(p->description, "Final Assembly");
+         if (radv_copy_representation(p->pData, &p->dataSize, shader->dbg.disasm_string) != VK_SUCCESS)
+            result = VK_INCOMPLETE;
+      }
+      ++p;
    }
-   ++p;
 
    if (!pInternalRepresentations)
       *pInternalRepresentationCount = p - pInternalRepresentations;
