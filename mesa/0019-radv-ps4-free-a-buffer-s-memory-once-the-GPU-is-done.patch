diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.h b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.h
index 9a63083..3d382fd 100644
--- a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.h
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.h
@@ -64,8 +64,26 @@ struct radv_ps4_queue {
    /* Waiters for a sync object to be submitted for signalling. */
    mtx_t sync_lock;
    cnd_t sync_cond;
+
+   /* Memory of destroyed buffers that submissions made before the destroy
+    * may still use (struct radv_ps4_release), oldest first. */
+   simple_mtx_t release_lock;
+   struct util_dynarray releases;
+};
+
+/* Memory freed once the GPU has run the submission seq. */
+struct radv_ps4_release {
+   uint64_t seq;
+   struct radv_ps4_memory memory;
 };
 
+/* Gives memory back when every submission so far has run: at once if they
+ * have, otherwise later (radv_ps4_queue_release_retired). */
+void radv_ps4_queue_release(struct radv_ps4_queue *queue, struct radv_ps4_memory *memory);
+/* Frees the released memory the GPU is done with; with wait, waits for the GPU
+ * to finish with all of it first. Returns whether anything was freed. */
+bool radv_ps4_queue_release_retired(struct radv_ps4_queue *queue, bool wait);
+
 /* The process's queue, created by the first winsys; NULL if it cannot be. */
 struct radv_ps4_queue *radv_ps4_queue_get(void);
 
