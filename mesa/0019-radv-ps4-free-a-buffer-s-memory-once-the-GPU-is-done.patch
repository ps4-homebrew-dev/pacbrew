+/* --------------------------------------------------------- released memory */
+
+/* A buffer's memory outlives the buffer until the GPU is done with it. RADV
+ * destroys buffers that submitted work still uses -- the queue's scratch and
+ * ring buffers when it grows them, upload buffers, and an application's
+ * memory freed right after its last submission was made -- and relies on the
+ * amdgpu kernel holding a buffer until every submission that names it has
+ * run. Here a buffer is direct memory the GPU reaches at its address, and
+ * once given back the next allocation may take it: the GPU's late writes then
+ * land in somebody else's data, or fault once the range is unmapped.
+ *
+ * Each destroyed buffer's memory waits for the submission that was the last
+ * when it was destroyed. The list is in the order of those submissions, since
+ * the sequence is read under the list's lock. */
+
+void
+radv_ps4_queue_release(struct radv_ps4_queue *queue, struct radv_ps4_memory *memory)
+{
+   simple_mtx_lock(&queue->release_lock);
+   const uint64_t seq = p_atomic_read(&queue->submitted_seq);
+   if (radv_ps4_queue_poll(queue) >= seq && !util_dynarray_num_elements(&queue->releases, struct radv_ps4_release)) {
+      simple_mtx_unlock(&queue->release_lock);
+      radv_ps4_memory_free(memory);
+      return;
+   }
+   struct radv_ps4_release *const release = util_dynarray_grow(&queue->releases, struct radv_ps4_release, 1);
+   if (!release) {
+      /* Out of host memory to remember it: wait for the GPU instead. */
+      simple_mtx_unlock(&queue->release_lock);
+      radv_ps4_queue_wait_seq(queue, seq, OS_TIMEOUT_INFINITE);
+      radv_ps4_memory_free(memory);
+      return;
+   }
+   *release = (struct radv_ps4_release){.seq = seq, .memory = *memory};
+   simple_mtx_unlock(&queue->release_lock);
+   radv_ps4_queue_release_retired(queue, false);
+}
+
+bool
+radv_ps4_queue_release_retired(struct radv_ps4_queue *queue, bool wait)
+{
+   simple_mtx_lock(&queue->release_lock);
+   struct radv_ps4_release *const releases = queue->releases.data;
+   const unsigned count = util_dynarray_num_elements(&queue->releases, struct radv_ps4_release);
+   if (!count) {
+      simple_mtx_unlock(&queue->release_lock);
+      return false;
+   }
+   if (wait)
+      radv_ps4_queue_wait_seq(queue, releases[count - 1].seq, OS_TIMEOUT_INFINITE);
+   const uint64_t completed = radv_ps4_queue_poll(queue);
+   unsigned freed = 0;
+   while (freed < count && releases[freed].seq <= completed) {
+      radv_ps4_memory_free(&releases[freed].memory);
+      freed++;
+   }
+   if (freed) {
+      memmove(releases, releases + freed, (size_t)(count - freed) * sizeof(*releases));
+      queue->releases.size -= (unsigned)freed * sizeof(*releases);
+   }
+   simple_mtx_unlock(&queue->release_lock);
+   return freed != 0;
+}
+
 /* ----------------------------------------------------------- the GPU itself */
 
