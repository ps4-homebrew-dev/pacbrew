diff --git a/src/egl/drivers/dri2/platform_videoout.c b/src/egl/drivers/dri2/platform_videoout.c
new file mode 100644
index 0000000..2c39c77
--- /dev/null
+++ b/src/egl/drivers/dri2/platform_videoout.c
@@ -0,0 +1,323 @@
+/*
+ * Copyright © 2026 John Törnblom
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * EGL on the PS4's display: zink on RADV, presenting through kopper to a
+ * VK_KHR_display surface (wsi_common_videoout.c).
+ *
+ * The display is the only window: any non-zero EGLNativeWindowType names it,
+ * and window surfaces with the same value share a swapchain. Pbuffers are
+ * zink's own images, as on the surfaceless platform.
+ */
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "pipe/p_screen.h"
+#include "util/format/u_formats.h"
+#include "util/u_debug.h"
+
+#include "egl_dri2.h"
+#include "eglglobals.h"
+#include "kopper_interface.h"
+#include "dri_screen.h"
+#include "dri_util.h"
+
+#define VIDEOOUT_DISPLAY_INDEX 0
+
+static_assert(sizeof(struct kopper_display_surface_create_info) <=
+                 sizeof(struct kopper_vk_surface_create_storage),
+              "kopper's storage holds a display surface");
+
+/* The formats VideoOut scans out. */
+static const enum pipe_format videoout_window_formats[] = {
+   PIPE_FORMAT_BGRA8888_UNORM,
+   PIPE_FORMAT_BGRX8888_UNORM,
+   PIPE_FORMAT_BGRA8888_SRGB,
+   PIPE_FORMAT_BGRX8888_SRGB,
+};
+
+static bool
+videoout_is_window_format(enum pipe_format format)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(videoout_window_formats); i++) {
+      if (videoout_window_formats[i] == format)
+         return true;
+   }
+   return false;
+}
+
+static void
+videoout_kopper_set_surface_create_info(void *draw, struct kopper_loader_info *out)
+{
+   struct dri2_egl_surface *dri2_surf = draw;
+
+   if (dri2_surf->base.Type != EGL_WINDOW_BIT)
+      return;
+
+   struct kopper_display_surface_create_info *dsci =
+      (struct kopper_display_surface_create_info *)&out->bos;
+   memset(&out->bos, 0, sizeof(out->bos));
+   dsci->sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+   dsci->pNext = NULL;
+   dsci->window = (uintptr_t)dri2_surf->base.NativeSurface;
+   dsci->display_index = VIDEOOUT_DISPLAY_INDEX;
+
+   out->present_opaque = dri2_surf->base.PresentOpaque;
+}
+
+static void
+videoout_kopper_get_drawable_info(struct dri_drawable *draw, int *w, int *h,
+                                  void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+   *w = dri2_surf->base.Width;
+   *h = dri2_surf->base.Height;
+}
+
+static const __DRIkopperLoaderExtension videoout_kopper_loader_extension = {
+   .base = {__DRI_KOPPER_LOADER, 1},
+
+   .SetSurfaceCreateInfo = videoout_kopper_set_surface_create_info,
+   .GetDrawableInfo = videoout_kopper_get_drawable_info,
+};
+
+static const __DRIextension *videoout_loader_extensions[] = {
+   &videoout_kopper_loader_extension.base,
+   &image_lookup_extension.base,
+   NULL,
+};
+
+static _EGLSurface *
+videoout_create_surface(_EGLDisplay *disp, EGLint type, _EGLConfig *conf,
+                        void *native_window, const EGLint *attrib_list)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   struct dri2_egl_config *dri2_conf = dri2_egl_config(conf);
+   const char *func = type == EGL_WINDOW_BIT ? "eglCreateWindowSurface"
+                                             : "eglCreatePbufferSurface";
+   struct dri2_egl_surface *dri2_surf;
+   const struct dri_config *config;
+
+   dri2_surf = calloc(1, sizeof *dri2_surf);
+   if (!dri2_surf) {
+      _eglError(EGL_BAD_ALLOC, func);
+      return NULL;
+   }
+
+   if (!dri2_init_surface(&dri2_surf->base, disp, type, conf, attrib_list,
+                          false, native_window))
+      goto cleanup_surface;
+
+   config = dri2_get_dri_config(dri2_conf, type, dri2_surf->base.GLColorspace);
+   if (!config) {
+      _eglError(EGL_BAD_MATCH, "Unsupported surfacetype/colorspace configuration");
+      goto cleanup_surface;
+   }
+
+   if (type == EGL_WINDOW_BIT) {
+      int width, height;
+      if (!kopperQueryDisplayExtent(dri2_dpy->dri_screen_render_gpu,
+                                    VIDEOOUT_DISPLAY_INDEX, &width, &height)) {
+         _eglError(EGL_BAD_NATIVE_WINDOW, "videoout: no display to show the window");
+         goto cleanup_surface;
+      }
+      dri2_surf->base.Width = width;
+      dri2_surf->base.Height = height;
+   } else {
+      dri2_surf->visual = dri2_image_format_for_pbuffer_config(dri2_dpy, config);
+      if (dri2_surf->visual == PIPE_FORMAT_NONE)
+         goto cleanup_surface;
+   }
+
+   if (!dri2_create_drawable(dri2_dpy, config, dri2_surf, dri2_surf))
+      goto cleanup_surface;
+
+   if (type == EGL_WINDOW_BIT) {
+      dri2_surf->base.SwapInterval = dri2_dpy->default_swap_interval;
+      kopperSetSwapInterval(dri2_surf->dri_drawable, dri2_dpy->default_swap_interval);
+   }
+
+   return &dri2_surf->base;
+
+cleanup_surface:
+   free(dri2_surf);
+   return NULL;
+}
+
+static _EGLSurface *
+videoout_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                               void *native_window, const EGLint *attrib_list)
+{
+   return videoout_create_surface(disp, EGL_WINDOW_BIT, conf, native_window,
+                                  attrib_list);
+}
+
+static _EGLSurface *
+videoout_create_pbuffer_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                                const EGLint *attrib_list)
+{
+   return videoout_create_surface(disp, EGL_PBUFFER_BIT, conf, NULL,
+                                  attrib_list);
+}
+
+static EGLBoolean
+videoout_destroy_surface(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   driDestroyDrawable(dri2_surf->dri_drawable);
+
+   dri2_fini_surface(surf);
+   free(dri2_surf);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+videoout_swap_interval(_EGLDisplay *disp, _EGLSurface *surf, EGLint interval)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   kopperSetSwapInterval(dri2_surf->dri_drawable, interval);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+videoout_swap_buffers_with_damage(_EGLDisplay *disp, _EGLSurface *draw,
+                                  const EGLint *rects, EGLint n_rects)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+
+   if (draw->Type != EGL_WINDOW_BIT)
+      return EGL_TRUE;
+
+   if (n_rects)
+      kopperSwapBuffersWithDamage(dri2_surf->dri_drawable,
+                                  __DRI2_FLUSH_CONTEXT | __DRI2_FLUSH_INVALIDATE_ANCILLARY,
+                                  n_rects, rects);
+   else
+      kopperSwapBuffers(dri2_surf->dri_drawable,
+                        __DRI2_FLUSH_CONTEXT | __DRI2_FLUSH_INVALIDATE_ANCILLARY);
+
+   kopperQuerySurfaceSize(dri2_surf->dri_drawable, &dri2_surf->base.Width,
+                          &dri2_surf->base.Height);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+videoout_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
+{
+   return videoout_swap_buffers_with_damage(disp, draw, NULL, 0);
+}
+
+static EGLint
+videoout_query_buffer_age(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   return kopperQueryBufferAge(dri2_surf->dri_drawable);
+}
+
+static const struct dri2_egl_display_vtbl dri2_videoout_display_vtbl = {
+   .create_window_surface = videoout_create_window_surface,
+   .create_pbuffer_surface = videoout_create_pbuffer_surface,
+   .destroy_surface = videoout_destroy_surface,
+   .create_image = dri2_create_image_khr,
+   .swap_interval = videoout_swap_interval,
+   .swap_buffers = videoout_swap_buffers,
+   .swap_buffers_with_damage = videoout_swap_buffers_with_damage,
+   .query_buffer_age = videoout_query_buffer_age,
+   .get_dri_drawable = dri2_surface_get_dri_drawable,
+};
+
+static void
+videoout_add_configs(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   unsigned window_configs = 0;
+
+   /* Window configs first, so that matching pbuffer configs are merged into them. */
+   for (unsigned pass = 0; pass < 2; pass++) {
+      for (unsigned i = 0; dri2_dpy->driver_configs[i] != NULL; i++) {
+         const struct gl_config *gl_config =
+            (const struct gl_config *)dri2_dpy->driver_configs[i];
+         const bool window = videoout_is_window_format(gl_config->color_format);
+
+         if (window != (pass == 0))
+            continue;
+
+         struct dri2_egl_config *dri2_conf =
+            dri2_add_config(disp, dri2_dpy->driver_configs[i],
+                            window ? EGL_WINDOW_BIT | EGL_PBUFFER_BIT : EGL_PBUFFER_BIT,
+                            NULL);
+         if (dri2_conf && window)
+            window_configs++;
+      }
+   }
+
+   if (!window_configs)
+      _eglLog(_EGL_WARNING, "videoout: no config the display can show");
+}
+
+EGLBoolean
+dri2_initialize_videoout(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   const char *err;
+
+   dri2_dpy->fd_render_gpu = -1;
+   dri2_dpy->fd_display_gpu = -1;
+
+   disp->Device = _eglFindDevice(-1, true);
+   if (!disp->Device) {
+      err = "videoout: no EGL device";
+      goto cleanup;
+   }
+
+   dri2_dpy->driver_name = strdup("zink");
+   if (!dri2_dpy->driver_name) {
+      err = "videoout: out of memory";
+      goto cleanup;
+   }
+
+   dri2_detect_swrast_kopper(disp);
+   if (!dri2_dpy->kopper) {
+      err = "videoout: the display is drawn to by zink through kopper";
+      goto cleanup;
+   }
+   dri2_dpy->loader_extensions = videoout_loader_extensions;
+
+   if (!dri2_create_screen(disp)) {
+      err = "videoout: failed to create the zink screen";
+      goto cleanup;
+   }
+
+   if (!dri2_dpy->dri_screen_render_gpu->base.screen->caps.graphics) {
+      err = "videoout: zink found no Vulkan device that draws";
+      goto cleanup;
+   }
+
+   dri2_setup_screen(disp);
+   /* FIFO only. */
+   dri2_setup_swap_interval(disp, 1);
+
+   disp->Extensions.EXT_buffer_age = EGL_TRUE;
+   disp->Extensions.EXT_swap_buffers_with_damage = EGL_TRUE;
+
+   videoout_add_configs(disp);
+
+   /* Fill vtbl last to prevent accidentally calling virtual function during
+    * initialization.
+    */
+   dri2_dpy->vtbl = &dri2_videoout_display_vtbl;
+
+   return EGL_TRUE;
+
+cleanup:
+   return _eglError(EGL_NOT_INITIALIZED, err);
+}
