+/* --- The interface ------------------------------------------------------- */
+
+VkResult
+wsi_display_init_wsi(struct wsi_device *wsi_device, const VkAllocationCallbacks *alloc, int display_fd)
+{
+   struct wsi_interface *wsi = vk_zalloc(alloc, sizeof(*wsi), 8, VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!wsi) {
+      wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY] = NULL;
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   call_once(&videoout_once, videoout_output_init_once);
+
+   wsi->get_support = videoout_surface_get_support;
+   wsi->get_capabilities2 = videoout_surface_get_capabilities2;
+   wsi->get_formats = videoout_surface_get_formats;
+   wsi->get_formats2 = videoout_surface_get_formats2;
+   wsi->get_present_modes = videoout_surface_get_present_modes;
+   wsi->get_present_rectangles = videoout_surface_get_present_rectangles;
+   wsi->create_swapchain = videoout_surface_create_swapchain;
+
+   wsi_device->wsi[VK_ICD_WSI_PLATFORM_DISPLAY] = wsi;
+   return VK_SUCCESS;
+}
