From 64a2b020c3a5dc3fefda8fa37645582d2c37019c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?John=20T=C3=B6rnblom?= <john.tornblom@gmail.com>
Date: Wed, 4 Nov 2026 23:28:24 +0000
Subject: [PATCH 15/15] radv/ps4: set up the GPU like the GNM driver does in NEO mode

With only libSceGnmDriverForNeoMode loaded, the PS4 Pro still hangs
in NEO mode on the first 3D frames (PA, SC, DB and CB busy, no shader
waves). Two things differ from the base PS4 in what the NEO mode GNM
driver writes, per shadPS4's copies of its init sequences:

- After CLEAR_STATE, it sets two undocumented context registers,
  0x283AC = 0xff00ff00 and 0x283B0 = 0xff00.
- It writes IA_MULTI_VGT_PARAM with SET_UCONFIG_REG to 0x30960
  (index 4), as on GFX9, rather than to the GFX7 context register,
  with EN_INST_OPT_BASIC and EN_INST_OPT_ADV set.

Do the same when the winsys says the GPU is in NEO mode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EVpxQm2qgi1H2nU3iig9Gg
---
 src/amd/common/ac_cmdbuf.c                  | 8 ++++++++
 src/amd/common/ac_gpu_info.h                | 5 +++++
 src/amd/vulkan/radv_cmd_buffer.c            | 3 +++
 src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c | 1 +
 4 files changed, 17 insertions(+)

diff --git a/src/amd/common/ac_cmdbuf.c b/src/amd/common/ac_cmdbuf.c
index a76c447..678da09 100644
--- a/src/amd/common/ac_cmdbuf.c
+++ b/src/amd/common/ac_cmdbuf.c
@@ -260,6 +260,14 @@ gfx6_init_graphics_preamble_state(const struct ac_preamble_state *state,
     */
    ac_pm4_set_reg(pm4, R_028820_PA_CL_NANINF_CNTL, 0);
 
+   /* The PS4 Pro's GNM driver sets these context registers (undocumented, 0x283AC and 0x283B0)
+    * after CLEAR_STATE in NEO mode, in its default context state.
+    */
+   if (info->is_ps4_neo) {
+      ac_pm4_set_reg(pm4, 0x283AC, 0xff00ff00);
+      ac_pm4_set_reg(pm4, 0x283B0, 0xff00);
+   }
+
    if (!info->has_clear_state) {
       ac_pm4_set_reg(pm4, R_028AC0_DB_SRESULTS_COMPARE_STATE0, 0x0);
       ac_pm4_set_reg(pm4, R_028AC4_DB_SRESULTS_COMPARE_STATE1, 0x0);
diff --git a/src/amd/common/ac_gpu_info.h b/src/amd/common/ac_gpu_info.h
index eb574c8..c784a89 100644
--- a/src/amd/common/ac_gpu_info.h
+++ b/src/amd/common/ac_gpu_info.h
@@ -460,6 +460,11 @@ struct radeon_info {
    bool spi_cu_en_has_effect;
    uint32_t spi_cu_en;
 
+   /* The PS4 Pro in NEO mode: IA_MULTI_VGT_PARAM is a uconfig register, as on GFX9, and two
+    * context registers that CLEAR_STATE leaves wrong must be set (as its GNM driver does).
+    */
+   bool is_ps4_neo;
+
    /* Raster config. */
    /* PA_SC_RASTER_CONFIG is set by the kernel and must not be written. */
    bool has_kernel_raster_config;
diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index efb4073..a7420be 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -7347,6 +7347,9 @@ radv_emit_ia_multi_vgt_param(struct radv_cmd_buffer *cmd_buffer, bool instanced_
 
       if (gpu_info->gfx_level == GFX9) {
          radeon_set_uconfig_reg_idx(&pdev->info, R_030960_IA_MULTI_VGT_PARAM, 4, ia_multi_vgt_param);
+      } else if (gpu_info->is_ps4_neo) {
+         /* Like the PS4 Pro's GNM driver in NEO mode, with EN_INST_OPT_BASIC and EN_INST_OPT_ADV. */
+         radeon_set_uconfig_reg_idx(&pdev->info, R_030960_IA_MULTI_VGT_PARAM, 4, ia_multi_vgt_param | 0x600000);
       } else if (gpu_info->gfx_level >= GFX7) {
          radeon_set_context_reg_idx(R_028AA8_IA_MULTI_VGT_PARAM, 1, ia_multi_vgt_param);
       } else {
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
index 58a0a1e..6e1935d 100644
--- a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
@@ -351,6 +351,7 @@ radv_ps4_describe_gpu(struct radeon_info *info, bool compiler_compat_mode)
 
    /* What the system does differently from the amdgpu kernel. */
    info->has_kernel_raster_config = true;
+   info->is_ps4_neo = neo;
    /* SH_MEM_CONFIG.ALIGNMENT_MODE isn't UNALIGNED: misaligned typed fetches return wrong data. */
    info->compiler_info.has_unaligned_typed_vtx_fetch = false;
    info->fixed_gs_ring_size = RADV_PS4_GS_RING_BYTES;
-- 
