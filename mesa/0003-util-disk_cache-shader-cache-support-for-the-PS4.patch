+#if defined(__ORBIS__)
+   if (ret == 0 && stat(path, &sb) == 0 && (sb.st_mode & 0777) != DISK_CACHE_DIR_MODE)
+      chmod(path, DISK_CACHE_DIR_MODE);
+#endif
    if (ret == 0 || (ret == -1 && errno == EEXIST))
      return 0;
 
