diff --git a/src/amd/common/ac_gpu_info.c b/src/amd/common/ac_gpu_info.c
index b9ca325..c416a63 100644
--- a/src/amd/common/ac_gpu_info.c
+++ b/src/amd/common/ac_gpu_info.c
@@ -370,6 +370,7 @@ ac_fill_compiler_info(struct radeon_info *info, const struct drm_amdgpu_info_dev
    out->has_gfx6_mrt_export_bug =
       info->family == CHIP_TAHITI || info->family == CHIP_PITCAIRN || info->family == CHIP_VERDE;
    out->has_vtx_format_alpha_adjust_bug = info->gfx_level <= GFX8 && info->family != CHIP_STONEY;
+   out->has_unaligned_typed_vtx_fetch = info->gfx_level >= GFX7 && info->gfx_level <= GFX9;
 
    /* On GFX6-7, SMEM instructions access memory when num_records == 0 or offset >= num_records,
     * which causes VM faults when reading a page that isn't mapped. To prevent the VM faults:
@@ -2130,6 +2131,7 @@ void ac_print_gpu_info(FILE *f, const struct radeon_info *info, int fd)
    fprintf(f, "    smaller_tcs_workgroups = %i\n", info->compiler_info.smaller_tcs_workgroups);
    fprintf(f, "    has_gfx6_mrt_export_bug = %i\n", info->compiler_info.has_gfx6_mrt_export_bug);
    fprintf(f, "    has_vtx_format_alpha_adjust_bug = %i\n", info->compiler_info.has_vtx_format_alpha_adjust_bug);
+   fprintf(f, "    has_unaligned_typed_vtx_fetch = %i\n", info->compiler_info.has_unaligned_typed_vtx_fetch);
    fprintf(f, "    has_smem_oob_access_bug = %i\n", info->compiler_info.has_smem_oob_access_bug);
    fprintf(f, "    has_image_load_dcc_bug = %i\n", info->compiler_info.has_image_load_dcc_bug);
    fprintf(f, "    has_ls_vgpr_init_bug = %i\n", info->compiler_info.has_ls_vgpr_init_bug);
diff --git a/src/amd/common/ac_gpu_info.h b/src/amd/common/ac_gpu_info.h
index 6ee1be1..0efe68f 100644
--- a/src/amd/common/ac_gpu_info.h
+++ b/src/amd/common/ac_gpu_info.h
@@ -184,6 +184,11 @@ struct ac_compiler_info {
    uint32_t has_gfx6_mrt_export_bug : 1;
    /* Pre-GFX9: A bug where the alpha component of 10_10_10_2 formats is always unsigned.*/
    uint32_t has_vtx_format_alpha_adjust_bug : 1;
+   /* GFX7-9: a typed buffer load (MTBUF) may read an element from an address that is not a
+    * multiple of its size, as the amdgpu kernel sets SH_MEM_CONFIG.ALIGNMENT_MODE to UNALIGNED.
+    * Where the kernel does not (the PS4), such a load reads the wrong bytes, silently.
+    */
+   uint32_t has_unaligned_typed_vtx_fetch : 1;
    /* GFX6-7: SMEM accesses memory even when it's out of bounds */
    uint32_t has_smem_oob_access_bug : 1;
    /* GFX10.3: WRITE_COMPRESS_ENABLE must be 0 for all image loads. */
