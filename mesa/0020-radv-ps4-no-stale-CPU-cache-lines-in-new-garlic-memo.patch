From: =?UTF-8?q?John=20T=C3=B6rnblom?= <john.tornblom@gmail.com>
Date: Wed, 21 Oct 2026 20:35:10 +0000
Subject: [PATCH 20/28] radv/ps4: no stale CPU cache lines in new garlic memory

Direct memory changes hands between onion allocations, which the CPU
caches, and garlic ones, which it writes combined past the caches. A
dirty line an onion owner left in the CPU's caches can be evicted after
the memory became garlic, over what the CPU or the GPU wrote there since.
The DolphinPS4/Crema RADV port found this on the console (Crema v01.84,
Donkey Kong Country: Tropical Freeze): a new VRAM ring table took the
memory of the old GTT one, got the old ring addresses back from the
cache, and the GPU wrote to the freed ring.

A new garlic allocation writes back and drops the CPU's lines of its
range (CLFLUSH, which reaches the physically tagged lines through any
mapping) before anything is written through it. Onion allocations need
nothing: they are coherent with whatever lines there are, and GTT is
zeroed anyway.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Bb93U7uY5qVNuEcHDggEfE
---
 src/amd/vulkan/winsys/ps4/radv_ps4_platform.c | 19 +++++++++++++++++++
 src/amd/vulkan/winsys/ps4/radv_ps4_platform.h |  4 +++-
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c
index 02e033c..0e3b0e0 100644
--- a/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c
@@ -274,6 +274,23 @@ radv_ps4_memory_available_bytes(void)
    return available;
 }
 
+/* Writes back and drops the CPU's cache lines of a range, through any mapping
+ * of it: the caches are physically tagged. Direct memory changes hands between
+ * onion owners, which the CPU caches, and garlic ones, which it writes
+ * combined past the caches; a dirty line an onion owner left behind can be
+ * evicted later over what was written through the new garlic mapping, by the
+ * CPU or by the GPU. The DolphinPS4/Crema RADV port saw exactly that (Crema
+ * v01.84): a new ring table in garlic memory that had been an onion one got
+ * the old ring addresses back, and the GPU wrote to the freed ring. */
+static void
+radv_ps4_cpu_drop_lines(const void *address, uint64_t bytes)
+{
+   __builtin_ia32_mfence();
+   for (uintptr_t line = (uintptr_t)address & ~(uintptr_t)63; line < (uintptr_t)address + bytes; line += 64)
+      __builtin_ia32_clflush((const void *)line);
+   __builtin_ia32_mfence();
+}
+
 static bool
 radv_ps4_map(int64_t physical, uint64_t bytes, uint64_t alignment, void *at, uint8_t **out)
 {
@@ -351,6 +368,8 @@ radv_ps4_memory_alloc(uint64_t bytes, uint64_t alignment, bool window32, enum ra
       sceKernelReleaseDirectMemory(physical, bytes);
       return false;
    }
+   if (type == RADV_PS4_MEMORY_GARLIC)
+      radv_ps4_cpu_drop_lines(out->cpu, bytes);
    out->bytes = bytes;
    out->physical = physical;
    return true;
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h
index 68f9ec2..3fc49ac 100644
--- a/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h
@@ -24,7 +24,9 @@
  * (the GPU's fast path), and onion, which the CPU caches and the GPU reaches
  * coherently through the CPU's caches. Neither needs the CPU's cache lines
  * flushed before the GPU reads it; written-combined stores need only to have
- * left the CPU (radv_ps4_cpu_flush). */
+ * left the CPU (radv_ps4_cpu_flush). The one exception is memory that changes
+ * from onion to garlic: a new garlic allocation drops whatever lines an earlier
+ * onion owner left in the CPU's caches. */
 
 /* The GPU's virtual addresses are 40 bits wide (GFX7). */
 #define RADV_PS4_GPU_ADDRESS_LIMIT (UINT64_C(1) << 40)
