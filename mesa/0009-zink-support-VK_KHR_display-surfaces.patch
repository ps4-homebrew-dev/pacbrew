+/* The size of a VK_KHR_display display, for a loader without a window system. */
+bool
+kopperQueryDisplayExtent(struct dri_screen *screen, unsigned display_index, int *width, int *height)
+{
+   struct pipe_screen *pscreen = kopper_get_zink_screen(screen->base.screen);
+
+   return zink_kopper_query_display_extent(pscreen, display_index, width, height);
+}
