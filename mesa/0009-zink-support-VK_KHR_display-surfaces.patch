+#ifdef VK_USE_PLATFORM_DISPLAY_KHR
+/* The display of the given index, and its native mode with the highest refresh rate (or else
+ * the largest mode).
+ */
+static bool
+kopper_find_display_mode(struct zink_screen *screen, uint32_t display_index,
+                         VkDisplayKHR *display, VkDisplayModePropertiesKHR *mode)
+{
+   if (!screen->instance_info->have_KHR_display)
+      return false;
+
+   uint32_t count = 0;
+   VkResult error = VKSCR(GetPhysicalDeviceDisplayPropertiesKHR)(screen->pdev, &count, NULL);
+   if (error != VK_SUCCESS || display_index >= count)
+      return false;
+   VkDisplayPropertiesKHR *displays = calloc(count, sizeof(*displays));
+   if (!displays)
+      return false;
+   error = VKSCR(GetPhysicalDeviceDisplayPropertiesKHR)(screen->pdev, &count, displays);
+   if (error < VK_SUCCESS || display_index >= count) {
+      free(displays);
+      return false;
+   }
+   *display = displays[display_index].display;
+   const VkExtent2D native = displays[display_index].physicalResolution;
+   free(displays);
+
+   count = 0;
+   error = VKSCR(GetDisplayModePropertiesKHR)(screen->pdev, *display, &count, NULL);
+   if (error != VK_SUCCESS || !count)
+      return false;
+   VkDisplayModePropertiesKHR *modes = calloc(count, sizeof(*modes));
+   if (!modes)
+      return false;
+   error = VKSCR(GetDisplayModePropertiesKHR)(screen->pdev, *display, &count, modes);
+   if (error < VK_SUCCESS || !count) {
+      free(modes);
+      return false;
+   }
+   unsigned best = 0;
+   for (unsigned i = 1; i < count; i++) {
+      const VkDisplayModeParametersKHR *a = &modes[i].parameters, *b = &modes[best].parameters;
+      const bool a_native = a->visibleRegion.width == native.width && a->visibleRegion.height == native.height;
+      const bool b_native = b->visibleRegion.width == native.width && b->visibleRegion.height == native.height;
+      const uint64_t a_area = (uint64_t)a->visibleRegion.width * a->visibleRegion.height;
+      const uint64_t b_area = (uint64_t)b->visibleRegion.width * b->visibleRegion.height;
+      if (a_native != b_native ? a_native :
+          a_area != b_area ? a_area > b_area : a->refreshRate > b->refreshRate)
+         best = i;
+   }
+   *mode = modes[best];
+   free(modes);
+   return true;
+}
+
+bool
+zink_kopper_query_display_extent(struct pipe_screen *pscreen, uint32_t display_index, int *w, int *h)
+{
+   struct zink_screen *screen = zink_screen(pscreen);
+   VkDisplayKHR display;
+   VkDisplayModePropertiesKHR mode;
+
+   if (!kopper_find_display_mode(screen, display_index, &display, &mode))
+      return false;
+   *w = mode.parameters.visibleRegion.width;
+   *h = mode.parameters.visibleRegion.height;
+   return true;
+}
+
+/* A surface on a plane that can show the display, the size of the mode. */
+static VkResult
+kopper_create_display_surface(struct zink_screen *screen, struct kopper_displaytarget *cdt,
+                              VkSurfaceKHR *surface)
+{
+   const struct kopper_display_surface_create_info *info =
+      (const struct kopper_display_surface_create_info *)&cdt->info.bos;
+   VkDisplayKHR display;
+   VkDisplayModePropertiesKHR mode;
+
+   if (!kopper_find_display_mode(screen, info->display_index, &display, &mode)) {
+      mesa_loge("zink: no display %u to present to", info->display_index);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   uint32_t plane_count = 0;
+   VkResult error = VKSCR(GetPhysicalDeviceDisplayPlanePropertiesKHR)(screen->pdev, &plane_count, NULL);
+   if (error != VK_SUCCESS)
+      return error;
+   VkDisplayPlanePropertiesKHR *planes = calloc(plane_count, sizeof(*planes));
+   if (plane_count && !planes)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   error = VKSCR(GetPhysicalDeviceDisplayPlanePropertiesKHR)(screen->pdev, &plane_count, planes);
+   if (error < VK_SUCCESS) {
+      free(planes);
+      return error;
+   }
+
+   uint32_t plane = UINT32_MAX;
+   for (uint32_t i = 0; i < plane_count && plane == UINT32_MAX; i++) {
+      if (planes[i].currentDisplay != VK_NULL_HANDLE && planes[i].currentDisplay != display)
+         continue;
+      uint32_t count = 0;
+      if (VKSCR(GetDisplayPlaneSupportedDisplaysKHR)(screen->pdev, i, &count, NULL) != VK_SUCCESS || !count)
+         continue;
+      VkDisplayKHR *supported = calloc(count, sizeof(*supported));
+      if (!supported)
+         break;
+      if (VKSCR(GetDisplayPlaneSupportedDisplaysKHR)(screen->pdev, i, &count, supported) >= VK_SUCCESS) {
+         for (uint32_t j = 0; j < count; j++) {
+            if (supported[j] == display) {
+               plane = i;
+               break;
+            }
+         }
+      }
+      free(supported);
+   }
+   const uint32_t stack_index = plane != UINT32_MAX ? planes[plane].currentStackIndex : 0;
+   free(planes);
+   if (plane == UINT32_MAX) {
+      mesa_loge("zink: no display plane shows display %u", info->display_index);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   VkDisplayPlaneCapabilitiesKHR plane_caps;
+   error = VKSCR(GetDisplayPlaneCapabilitiesKHR)(screen->pdev, mode.displayMode, plane, &plane_caps);
+   if (error != VK_SUCCESS)
+      return error;
+   VkDisplayPlaneAlphaFlagBitsKHR alpha = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+   if (!(plane_caps.supportedAlpha & alpha))
+      alpha = (VkDisplayPlaneAlphaFlagBitsKHR)(plane_caps.supportedAlpha & -plane_caps.supportedAlpha);
+
+   const VkDisplaySurfaceCreateInfoKHR dsci = {
+      .sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR,
+      .displayMode = mode.displayMode,
+      .planeIndex = plane,
+      .planeStackIndex = stack_index,
+      .transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR,
+      .globalAlpha = 1.0f,
+      .alphaMode = alpha,
+      .imageExtent = mode.parameters.visibleRegion,
+   };
+   return VKSCR(CreateDisplayPlaneSurfaceKHR)(screen->instance, &dsci, NULL, surface);
+}
+#else
+bool
+zink_kopper_query_display_extent(struct pipe_screen *pscreen, uint32_t display_index, int *w, int *h)
+{
+   return false;
+}
+#endif
+
 static VkSurfaceKHR
 kopper_CreateSurface(struct zink_screen *screen, struct kopper_displaytarget *cdt)
 {
@@ -118,6 +277,11 @@ kopper_CreateSurface(struct zink_screen *screen, struct kopper_displaytarget *cd
       error = VKSCR(CreateWin32SurfaceKHR)(screen->instance, win32, NULL, &surface);
       break;
    }
+#endif
+#ifdef VK_USE_PLATFORM_DISPLAY_KHR
+   case VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR:
+      error = kopper_create_display_surface(screen, cdt, &surface);
+      break;
 #endif
    default:
       UNREACHABLE("unsupported!");
@@ -234,6 +398,14 @@ find_dt_entry(struct zink_screen *screen, const struct kopper_displaytarget *cdt
       he = _mesa_hash_table_search(&screen->dts, win32->hwnd);
       break;
    }
+#endif
+#ifdef VK_USE_PLATFORM_DISPLAY_KHR
+   case KOPPER_DISPLAY: {
+      const struct kopper_display_surface_create_info *dsci =
+         (const struct kopper_display_surface_create_info *)&cdt->info.bos;
+      he = _mesa_hash_table_search(&screen->dts, (void *)dsci->window);
+      break;
+   }
 #endif
    default:
       UNREACHABLE("unsupported!");
@@ -313,6 +485,7 @@ kopper_CreateSwapchain(struct zink_screen *screen, struct kopper_displaytarget *
    switch (cdt->type) {
    case KOPPER_X11:
    case KOPPER_WIN32:
+   case KOPPER_DISPLAY:
       /* With Xcb, minImageExtent, maxImageExtent, and currentExtent must always equal the window size.
        * ...
        * Due to above restrictions, it is only possible to create a new swapchain on this
@@ -444,6 +617,7 @@ zink_kopper_displaytarget_create(struct zink_screen *screen, unsigned tex_usage,
             break;
          case KOPPER_WAYLAND:
          case KOPPER_WIN32:
+         case KOPPER_DISPLAY:
             _mesa_hash_table_init(&screen->dts, screen, _mesa_hash_pointer, _mesa_key_pointer_equal);
             break;
          default:
@@ -515,6 +689,14 @@ zink_kopper_displaytarget_create(struct zink_screen *screen, unsigned tex_usage,
       _mesa_hash_table_insert(&screen->dts, win32->hwnd, cdt);
       break;
    }
+#endif
+#ifdef VK_USE_PLATFORM_DISPLAY_KHR
+   case KOPPER_DISPLAY: {
+      const struct kopper_display_surface_create_info *dsci =
+         (const struct kopper_display_surface_create_info *)&cdt->info.bos;
+      _mesa_hash_table_insert(&screen->dts, (void *)dsci->window, cdt);
+      break;
+   }
 #endif
    default:
       UNREACHABLE("unsupported!");
