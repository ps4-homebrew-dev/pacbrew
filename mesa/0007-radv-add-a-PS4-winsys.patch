+/* NOOFBANK 16, NOOFRANKS 1. */
+#define RADV_PS4_MC_ARB_RAMCFG 0x00000002
+
+/* The tile modes of the console's addressing library, as freegnm (src/gpuaddr/tilemodes.c) has
+ * them. This is the base PS4's configuration; the PS4 Pro mode tiles differently.
+ */
