diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_bo.c b/src/amd/vulkan/winsys/ps4/radv_ps4_bo.c
new file mode 100644
index 0000000..0cbc959
--- /dev/null
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_bo.c
@@ -0,0 +1,227 @@
+/*
+ * Copyright © 2026 Mihawk
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "radv_ps4_winsys.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+
+/* A buffer is one direct memory allocation, mapped for the CPU and the GPU at the same address
+ * for its whole life: always resident, and its GPU address is its CPU address. 32-bit buffers are
+ * in the window, others anywhere below 2^40. Memory the CPU reads back (GTT without write
+ * combining) is onion, everything else garlic.
+ */
+
+uint64_t radv_ps4_allocated_bytes;
+static uint64_t radv_ps4_next_obj_id;
+
+static VkResult
+radv_ps4_buffer_create(struct radeon_winsys *rws, uint64_t size, unsigned alignment, enum radeon_bo_domain domain,
+                       enum radeon_bo_flag flags, unsigned priority, uint64_t replay_address,
+                       struct radeon_winsys_bo **out_bo)
+{
+   struct radv_ps4_winsys *ws = radv_ps4_winsys(rws);
+   const bool window32 = flags & RADEON_FLAG_32BIT;
+   const enum radv_ps4_memory_type type = (domain & RADEON_DOMAIN_VRAM) || (flags & RADEON_FLAG_GTT_WC)
+                                             ? RADV_PS4_MEMORY_GARLIC
+                                             : RADV_PS4_MEMORY_ONION;
+
+   *out_bo = NULL;
+
+   if (flags & RADEON_FLAG_VIRTUAL)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   if (replay_address)
+      return VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS;
+
+   struct radv_ps4_bo *bo = calloc(1, sizeof(*bo));
+   if (!bo)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   /* Free what the GPU is done with first, and wait for the rest if there is still no room. */
+   radv_ps4_queue_release_retired(ws->queue, false);
+   bool allocated = radv_ps4_memory_alloc(size, alignment, window32, type, &bo->memory);
+   if (!allocated && radv_ps4_queue_release_retired(ws->queue, true))
+      allocated = radv_ps4_memory_alloc(size, alignment, window32, type, &bo->memory);
+   if (!allocated) {
+      free(bo);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   bo->base.va = (uintptr_t)bo->memory.cpu;
+   bo->base.size = size;
+   bo->base.is_local = true;
+   bo->base.use_global_list = true;
+   bo->base.initial_domain = domain;
+   bo->base.obj_id = p_atomic_inc_return(&radv_ps4_next_obj_id);
+
+   /* Direct memory isn't cleared, but RADV expects GTT and RADEON_FLAG_ZERO_VRAM memory to be. */
+   if ((flags & RADEON_FLAG_ZERO_VRAM) || (domain & RADEON_DOMAIN_GTT)) {
+      memset(bo->memory.cpu, 0, size);
+      radv_ps4_cpu_flush();
+   }
+
+   p_atomic_add(&radv_ps4_allocated_bytes, bo->memory.bytes);
+   p_atomic_add((domain & RADEON_DOMAIN_VRAM) ? &ws->allocated_vram : &ws->allocated_gtt, bo->memory.bytes);
+
+   *out_bo = &bo->base;
+   return VK_SUCCESS;
+}
+
+static void
+radv_ps4_buffer_destroy(struct radeon_winsys *rws, struct radeon_winsys_bo *base)
+{
+   struct radv_ps4_winsys *ws = radv_ps4_winsys(rws);
+   struct radv_ps4_bo *bo = radv_ps4_bo(base);
+
+   if (!bo)
+      return;
+
+   if (!bo->imported) {
+      p_atomic_add(&radv_ps4_allocated_bytes, -(int64_t)bo->memory.bytes);
+      p_atomic_add((bo->base.initial_domain & RADEON_DOMAIN_VRAM) ? &ws->allocated_vram : &ws->allocated_gtt,
+                   -(int64_t)bo->memory.bytes);
+      if (bo->placed)
+         radv_ps4_memory_unmap_at(bo->placed, bo->memory.bytes, false);
+      radv_ps4_queue_release(ws->queue, &bo->memory);
+   }
+   free(bo);
+}
+
+static void *
+radv_ps4_buffer_map(struct radeon_winsys *rws, struct radeon_winsys_bo *base, bool use_fixed_addr, void *fixed_addr)
+{
+   struct radv_ps4_bo *bo = radv_ps4_bo(base);
+
+   if (!use_fixed_addr)
+      return bo->memory.cpu;
+
+   if (bo->imported || bo->placed || !radv_ps4_memory_map_at(&bo->memory, fixed_addr))
+      return NULL;
+   bo->placed = fixed_addr;
+   return fixed_addr;
+}
+
+static void
+radv_ps4_buffer_unmap(struct radeon_winsys *rws, struct radeon_winsys_bo *base, bool replace)
+{
+   struct radv_ps4_bo *bo = radv_ps4_bo(base);
+
+   /* Only a placed mapping goes away. */
+   if (bo->placed) {
+      radv_ps4_memory_unmap_at(bo->placed, bo->memory.bytes, replace);
+      bo->placed = NULL;
+   }
+}
+
+static VkResult
+radv_ps4_buffer_from_ptr(struct radeon_winsys *rws, void *pointer, uint64_t size, unsigned priority,
+                         struct radeon_winsys_bo **out_bo)
+{
+   const uint64_t va = (uintptr_t)pointer;
+
+   *out_bo = NULL;
+
+   /* Only memory that is already mapped for the GPU, like VideoOut's framebuffers. */
+   if (!size || va % RADV_PS4_PAGE_BYTES || size % RADV_PS4_PAGE_BYTES || !radv_ps4_memory_gpu_mapped(pointer, size))
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+
+   struct radv_ps4_bo *bo = calloc(1, sizeof(*bo));
+   if (!bo)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   bo->imported = true;
+   bo->memory.cpu = pointer;
+   bo->memory.bytes = size;
+   bo->base.va = va;
+   bo->base.size = size;
+   bo->base.use_global_list = true;
+   bo->base.initial_domain = RADEON_DOMAIN_GTT;
+   bo->base.obj_id = p_atomic_inc_return(&radv_ps4_next_obj_id);
+   *out_bo = &bo->base;
+   return VK_SUCCESS;
+}
+
+static VkResult
+radv_ps4_buffer_from_fd(struct radeon_winsys *rws, int fd, unsigned priority, struct radeon_winsys_bo **out_bo,
+                        uint64_t *alloc_size)
+{
+   *out_bo = NULL;
+   return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+}
+
+static bool
+radv_ps4_buffer_get_fd(struct radeon_winsys *rws, struct radeon_winsys_bo *bo, int *fd)
+{
+   return false;
+}
+
+static bool
+radv_ps4_buffer_get_flags_from_fd(struct radeon_winsys *rws, int fd, enum radeon_bo_domain *domains,
+                                  enum radeon_bo_flag *flags)
+{
+   return false;
+}
+
+static void
+radv_ps4_buffer_set_metadata(struct radeon_winsys *rws, struct radeon_winsys_bo *base, struct radeon_bo_metadata *md)
+{
+   radv_ps4_bo(base)->metadata = *md;
+}
+
+static void
+radv_ps4_buffer_get_metadata(struct radeon_winsys *rws, struct radeon_winsys_bo *base, struct radeon_bo_metadata *md)
+{
+   *md = radv_ps4_bo(base)->metadata;
+}
+
+static VkResult
+radv_ps4_buffer_virtual_bind(struct radeon_winsys *rws, struct radeon_winsys_bo *parent, uint64_t offset,
+                             uint64_t size, struct radeon_winsys_bo *bo, uint64_t bo_offset)
+{
+   return VK_ERROR_FEATURE_NOT_PRESENT;
+}
+
+static VkResult
+radv_ps4_buffer_make_resident(struct radeon_winsys *rws, struct radeon_winsys_bo *bo, bool resident)
+{
+   return VK_SUCCESS;
+}
+
+static bool
+radv_ps4_bo_wait_for_idle(struct radeon_winsys *rws, struct radeon_winsys_bo *bo)
+{
+   struct radv_ps4_queue *queue = radv_ps4_winsys(rws)->queue;
+   return radv_ps4_queue_wait_seq(queue, p_atomic_read(&queue->submitted_seq), OS_TIMEOUT_INFINITE);
+}
+
+static void
+radv_ps4_dump_bo(struct radeon_winsys *rws, FILE *file)
+{
+}
+
+void
+radv_ps4_bo_init_functions(struct radv_ps4_winsys *ws)
+{
+   ws->base.buffer_create = radv_ps4_buffer_create;
+   ws->base.buffer_destroy = radv_ps4_buffer_destroy;
+   ws->base.buffer_map = radv_ps4_buffer_map;
+   ws->base.buffer_unmap = radv_ps4_buffer_unmap;
+   ws->base.buffer_from_ptr = radv_ps4_buffer_from_ptr;
+   ws->base.buffer_from_fd = radv_ps4_buffer_from_fd;
+   ws->base.buffer_get_fd = radv_ps4_buffer_get_fd;
+   ws->base.buffer_get_flags_from_fd = radv_ps4_buffer_get_flags_from_fd;
+   ws->base.buffer_set_metadata = radv_ps4_buffer_set_metadata;
+   ws->base.buffer_get_metadata = radv_ps4_buffer_get_metadata;
+   ws->base.buffer_virtual_bind = radv_ps4_buffer_virtual_bind;
+   ws->base.buffer_make_resident = radv_ps4_buffer_make_resident;
+   ws->base.bo_wait_for_idle = radv_ps4_bo_wait_for_idle;
+   ws->base.dump_bo_ranges = radv_ps4_dump_bo;
+   ws->base.dump_bo_log = radv_ps4_dump_bo;
+}
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_cs.c b/src/amd/vulkan/winsys/ps4/radv_ps4_cs.c
new file mode 100644
index 0000000..84a481f
--- /dev/null
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_cs.c
@@ -0,0 +1,594 @@
+/*
+ * Copyright © 2026 Mihawk
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "radv_ps4_winsys.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+#include "util/u_math.h"
+#include "sid.h"
+
+/* Command streams are never chained. Their words stay in CPU memory, in chunks that never move,
+ * and a submission copies all its streams into the queue's ring, followed by the EOP that writes
+ * the submission's sequence number to the marker. Chunk boundaries are packet boundaries.
+ *
+ * Each DCB may start from reset GPU state, so a submission that is too large for one DCB is only
+ * split where the state is the preamble's: at the start of a stream, or where RADV split the
+ * stream (cs_split) and re-emitted its state. Every DCB starts with the preamble.
+ */
+
+#define RADV_PS4_CS_INITIAL_DW (20 * 1024)
+#define RADV_PS4_CS_MAX_CHUNK_DW (256u * 1024)
+
+/* The most words one DCB carries. */
+#define RADV_PS4_SUBMIT_MAX_DW (RADV_PS4_DCB_MAX_BYTES / 4 - 64)
+
+/* A stream asks for a split once it holds this many words since the last one. */
+#define RADV_PS4_SPLIT_DUE_DW (512u * 1024)
+
+static bool
+radv_ps4_cs_alloc(struct radv_ps4_cs *cs, uint32_t max_dw)
+{
+   uint32_t *words = malloc((size_t)max_dw * sizeof(uint32_t));
+   if (!words)
+      return false;
+   cs->base.buf = words;
+   cs->base.max_dw = max_dw;
+   cs->base.cdw = 0;
+   cs->base.reserved_dw = 0;
+   return true;
+}
+
+static struct ac_cmdbuf *
+radv_ps4_cs_create(struct radeon_winsys *rws, enum amd_ip_type ip_type, bool is_secondary)
+{
+   struct radv_ps4_cs *cs = calloc(1, sizeof(*cs));
+   if (!cs)
+      return NULL;
+   cs->ws = radv_ps4_winsys(rws);
+   cs->ip_type = ip_type;
+   util_dynarray_init(&cs->chunks, NULL);
+   if (!radv_ps4_cs_alloc(cs, RADV_PS4_CS_INITIAL_DW)) {
+      free(cs);
+      return NULL;
+   }
+   return &cs->base;
+}
+
+static void
+radv_ps4_cs_free_chunks(struct radv_ps4_cs *cs)
+{
+   util_dynarray_foreach (&cs->chunks, struct radv_ps4_cs_chunk, chunk)
+      free(chunk->words);
+   util_dynarray_clear(&cs->chunks);
+   cs->words_in_chunks = 0;
+}
+
+static void
+radv_ps4_cs_destroy(struct ac_cmdbuf *base)
+{
+   struct radv_ps4_cs *cs = radv_ps4_cs(base);
+   radv_ps4_cs_free_chunks(cs);
+   util_dynarray_fini(&cs->chunks);
+   free(cs->base.buf);
+   free(cs);
+}
+
+static enum radeon_bo_domain
+radv_ps4_cs_domain(const struct radeon_winsys *rws)
+{
+   return RADEON_DOMAIN_GTT;
+}
+
+/* Finishes the current chunk and starts a new one. Packets never straddle chunks, since RADV
+ * checks for space before writing one.
+ */
+static void
+radv_ps4_cs_grow(struct ac_cmdbuf *base, size_t min_size)
+{
+   struct radv_ps4_cs *cs = radv_ps4_cs(base);
+
+   if (cs->status != VK_SUCCESS) {
+      cs->base.cdw = 0;
+      return;
+   }
+
+   const struct radv_ps4_cs_chunk done = {
+      .words = cs->base.buf,
+      .cdw = cs->base.cdw,
+      .max_dw = cs->base.max_dw,
+      .starts_submission = cs->buf_starts_submission,
+   };
+   const uint64_t wanted = MAX2((uint64_t)min_size + 16, (uint64_t)cs->base.max_dw * 2);
+   const uint32_t max_dw = MAX2(MIN2(wanted, RADV_PS4_CS_MAX_CHUNK_DW), (uint64_t)min_size + 16);
+
+   struct radv_ps4_cs_chunk *slot = util_dynarray_grow(&cs->chunks, struct radv_ps4_cs_chunk, 1);
+   if (slot)
+      *slot = done;
+   if (!slot || !radv_ps4_cs_alloc(cs, max_dw)) {
+      if (slot)
+         (void)util_dynarray_pop(&cs->chunks, struct radv_ps4_cs_chunk);
+      cs->base.buf = done.words;
+      cs->base.max_dw = done.max_dw;
+      cs->base.cdw = 0;
+      cs->status = VK_ERROR_OUT_OF_HOST_MEMORY;
+      return;
+   }
+   cs->words_in_chunks += done.cdw;
+   cs->buf_starts_submission = false;
+}
+
+static void
+radv_ps4_cs_pad(struct ac_cmdbuf *base, unsigned leave_dw_space)
+{
+   struct radv_ps4_cs *cs = radv_ps4_cs(base);
+   const uint32_t mask = cs->ws->info.ip[cs->ip_type].ib_pad_dw_mask;
+   const uint32_t unaligned = (cs->base.cdw + leave_dw_space) & mask;
+
+   if (!unaligned)
+      return;
+
+   const unsigned count = mask + 1 - unaligned;
+   if (count == 1) {
+      cs->base.buf[cs->base.cdw++] = PKT3_NOP_PAD;
+   } else {
+      cs->base.buf[cs->base.cdw] = PKT3(PKT3_NOP, count - 2, 0);
+      cs->base.cdw += count;
+   }
+}
+
+static VkResult
+radv_ps4_cs_finalize(struct ac_cmdbuf *base)
+{
+   struct radv_ps4_cs *cs = radv_ps4_cs(base);
+   assert(cs->base.cdw <= cs->base.reserved_dw || cs->status != VK_SUCCESS);
+   return cs->status;
+}
+
+static void
+radv_ps4_cs_reset(struct ac_cmdbuf *base)
+{
+   struct radv_ps4_cs *cs = radv_ps4_cs(base);
+   radv_ps4_cs_free_chunks(cs);
+   cs->base.cdw = 0;
+   cs->base.reserved_dw = 0;
+   cs->buf_starts_submission = false;
+   cs->split_at = 0;
+   cs->status = VK_SUCCESS;
+}
+
+static bool
+radv_ps4_cs_chain(struct ac_cmdbuf *cs, struct ac_cmdbuf *next_cs, bool pre_ena)
+{
+   return false;
+}
+
+static void
+radv_ps4_cs_unchain(struct ac_cmdbuf *cs)
+{
+}
+
+static void
+radv_ps4_cs_add_buffer(struct ac_cmdbuf *cs, struct radeon_winsys_bo *bo)
+{
+}
+
+static uint32_t
+radv_ps4_cs_words(const struct radv_ps4_cs *cs)
+{
+   return cs->words_in_chunks + cs->base.cdw;
+}
+
+static void
+radv_ps4_cs_append(struct radv_ps4_cs *cs, const uint32_t *words, uint32_t count)
+{
+   if (cs->base.max_dw - cs->base.cdw < count)
+      radv_ps4_cs_grow(&cs->base, count);
+
+   while (count && cs->status == VK_SUCCESS) {
+      if (cs->base.cdw == cs->base.max_dw)
+         radv_ps4_cs_grow(&cs->base, MIN2(count, RADV_PS4_CS_MAX_CHUNK_DW - 16));
+      const uint32_t n = MIN2(cs->base.max_dw - cs->base.cdw, count);
+      memcpy(cs->base.buf + cs->base.cdw, words, (size_t)n * sizeof(uint32_t));
+      cs->base.cdw += n;
+      cs->base.reserved_dw = MAX2(cs->base.reserved_dw, cs->base.cdw);
+      words += n;
+      count -= n;
+   }
+}
+
+static bool
+radv_ps4_cs_split_due(struct ac_cmdbuf *base)
+{
+   struct radv_ps4_cs *cs = radv_ps4_cs(base);
+   return cs->status == VK_SUCCESS && radv_ps4_cs_words(cs) - cs->split_at > RADV_PS4_SPLIT_DUE_DW;
+}
+
+static void
+radv_ps4_cs_split(struct ac_cmdbuf *base)
+{
+   struct radv_ps4_cs *cs = radv_ps4_cs(base);
+
+   if (cs->base.cdw)
+      radv_ps4_cs_grow(&cs->base, 0);
+   if (cs->status != VK_SUCCESS)
+      return;
+   cs->buf_starts_submission = true;
+   cs->split_at = radv_ps4_cs_words(cs);
+}
+
+static void
+radv_ps4_cs_execute_secondary(struct ac_cmdbuf *parent_base, struct ac_cmdbuf *child_base, bool allow_ib2)
+{
+   struct radv_ps4_cs *parent = radv_ps4_cs(parent_base);
+   struct radv_ps4_cs *child = radv_ps4_cs(child_base);
+
+   if (parent->status != VK_SUCCESS || child->status != VK_SUCCESS)
+      return;
+
+   /* Each chunk of the child lands whole in a chunk of the parent, and keeps its splits. */
+   util_dynarray_foreach (&child->chunks, struct radv_ps4_cs_chunk, chunk) {
+      if (chunk->starts_submission)
+         radv_ps4_cs_split(&parent->base);
+      radv_ps4_cs_append(parent, chunk->words, chunk->cdw);
+   }
+   if (child->buf_starts_submission)
+      radv_ps4_cs_split(&parent->base);
+   radv_ps4_cs_append(parent, child->base.buf, child->base.cdw);
+}
+
+static void
+radv_ps4_cs_execute_ib(struct ac_cmdbuf *cs, struct radeon_winsys_bo *bo, const uint64_t va, const uint32_t cdw,
+                       const bool predicate)
+{
+   /* Not reached: device-generated commands aren't exposed (has_gpu_written_ibs). */
+   radv_ps4_cs(cs)->status = VK_ERROR_FEATURE_NOT_PRESENT;
+}
+
+static void
+radv_ps4_cs_chain_dgc_ib(struct ac_cmdbuf *cs, uint64_t va, uint32_t cdw, uint64_t trailer_va, const bool predicate)
+{
+   radv_ps4_cs(cs)->status = VK_ERROR_FEATURE_NOT_PRESENT;
+}
+
+static void
+radv_ps4_cs_dump(struct ac_cmdbuf *cs, FILE *file, const int *trace_ids, int trace_id_count,
+                 enum radv_cs_dump_type type)
+{
+}
+
+static void
+radv_ps4_cs_annotate(struct ac_cmdbuf *cs, const char *marker)
+{
+}
+
+/* The EOP that ends every submission: flush the CB and DB caches, write back and invalidate L2
+ * and the vector L1 caches, then write the low 32 bits of the sequence number.
+ *
+ * Unlike the amdgpu kernel's GFX7 fence, this sets TC_WB_ACTION_ENA ("write back and invalidate
+ * L1 and L2" in Gnm): Liverpool doesn't write L2 back without it, and the fence could signal while
+ * shader stores were still in L2.
+ */
+void
+radv_ps4_completion_words(uint32_t *words, uint64_t marker_address, uint32_t value)
+{
+   words[0] = PKT3(PKT3_EVENT_WRITE_EOP, 4, 0);
+   words[1] = EVENT_TC_WB_ACTION_ENA | EVENT_TCL1_ACTION_ENA | EVENT_TC_ACTION_ENA |
+              EVENT_TYPE(V_028A90_CACHE_FLUSH_AND_INV_TS_EVENT) | EVENT_INDEX(5);
+   words[2] = (uint32_t)marker_address;
+   words[3] = ((uint32_t)(marker_address >> 32) & 0xffff) | EOP_DATA_SEL(EOP_DATA_SEL_VALUE_32BIT) |
+              EOP_INT_SEL(EOP_INT_SEL_NONE);
+   words[4] = value;
+   words[5] = 0;
+}
+
+/* The packet and the value of radv_ps4_read_gpu_clock live in the marker's page. */
+#define RADV_PS4_CLOCK_WORDS_OFFSET 1024
+#define RADV_PS4_CLOCK_VALUE_OFFSET 2048
+
+/* Reads the GPU timestamp with a BOTTOM_OF_PIPE_TS EOP, submitted alone and waited for. */
+uint64_t
+radv_ps4_read_gpu_clock(void)
+{
+   struct radv_ps4_queue *queue = radv_ps4_queue_get();
+   if (!queue)
+      return 0;
+
+   uint8_t *page = queue->marker_memory.cpu;
+   uint32_t *words = (uint32_t *)(page + RADV_PS4_CLOCK_WORDS_OFFSET);
+   volatile uint64_t *value = (volatile uint64_t *)(page + RADV_PS4_CLOCK_VALUE_OFFSET);
+   const uint64_t va = (uintptr_t)value;
+   uint64_t clock = 0;
+
+   simple_mtx_lock(&queue->submit_lock);
+   *value = UINT64_MAX;
+   words[0] = PKT3(PKT3_EVENT_WRITE_EOP, 4, 0);
+   words[1] = EVENT_TYPE(V_028A90_BOTTOM_OF_PIPE_TS) | EVENT_INDEX(5);
+   words[2] = (uint32_t)va;
+   words[3] = ((uint32_t)(va >> 32) & 0xffff) | EOP_DATA_SEL(EOP_DATA_SEL_TIMESTAMP);
+   words[4] = 0;
+   words[5] = 0;
+   if (radv_ps4_submit(words, 6) == 0) {
+      const int64_t deadline = os_time_get_nano() + INT64_C(1000000000);
+      do {
+         clock = *value;
+      } while (clock == UINT64_MAX && os_time_get_nano() < deadline);
+      if (clock == UINT64_MAX)
+         clock = 0;
+   }
+   simple_mtx_unlock(&queue->submit_lock);
+   return clock;
+}
+
+/* Forgets the in-flight records the GPU has finished. Called with the submit lock held. */
+static void
+radv_ps4_queue_retire(struct radv_ps4_queue *queue)
+{
+   const uint64_t completed = radv_ps4_queue_poll(queue);
+
+   while (queue->in_flight_count) {
+      struct radv_ps4_in_flight *oldest = &queue->in_flight[queue->in_flight_first];
+      if (oldest->seq > completed)
+         break;
+      radv_ps4_memory_free(&oldest->dedicated);
+      queue->in_flight_first = (queue->in_flight_first + 1) % RADV_PS4_MAX_IN_FLIGHT;
+      queue->in_flight_count--;
+   }
+}
+
+static struct radv_ps4_in_flight *
+radv_ps4_queue_in_flight(struct radv_ps4_queue *queue, uint32_t i)
+{
+   return &queue->in_flight[(queue->in_flight_first + i) % RADV_PS4_MAX_IN_FLIGHT];
+}
+
+/* Claims count words for submission seq: in the ring once the GPU no longer reads that range, or
+ * in memory of their own if they're too many. Called with the submit lock held.
+ */
+static uint32_t *
+radv_ps4_queue_claim(struct radv_ps4_queue *queue, uint32_t count, uint64_t seq)
+{
+   radv_ps4_queue_retire(queue);
+   while (queue->in_flight_count == RADV_PS4_MAX_IN_FLIGHT) {
+      if (!radv_ps4_queue_wait_seq(queue, radv_ps4_queue_in_flight(queue, 0)->seq, OS_TIMEOUT_INFINITE))
+         return NULL;
+      radv_ps4_queue_retire(queue);
+   }
+
+   /* Retiring doesn't move the tail, so this stays valid. */
+   struct radv_ps4_in_flight *claim = radv_ps4_queue_in_flight(queue, queue->in_flight_count);
+   uint32_t *words;
+
+   *claim = (struct radv_ps4_in_flight){.seq = seq};
+
+   if (count > RADV_PS4_RING_WORDS / 2) {
+      if (!radv_ps4_memory_alloc((uint64_t)count * 4, RADV_PS4_LARGE_BYTES, false, RADV_PS4_MEMORY_GARLIC,
+                                 &claim->dedicated))
+         return NULL;
+      words = (uint32_t *)claim->dedicated.cpu;
+   } else {
+      uint32_t start = align(queue->ring_head, 16);
+      if (start + count > RADV_PS4_RING_WORDS)
+         start = 0;
+      const uint32_t end = start + count;
+
+      for (uint32_t i = 0; i < queue->in_flight_count; i++) {
+         const struct radv_ps4_in_flight *record = radv_ps4_queue_in_flight(queue, i);
+         if (!record->dedicated.cpu && record->start < end && start < record->end &&
+             !radv_ps4_queue_wait_seq(queue, record->seq, OS_TIMEOUT_INFINITE))
+            return NULL;
+      }
+      radv_ps4_queue_retire(queue);
+
+      claim->start = start;
+      claim->end = end;
+      queue->ring_head = end;
+      words = (uint32_t *)queue->ring.cpu + start;
+   }
+
+   queue->in_flight_count++;
+   return words;
+}
+
+/* A run of words that must go into one DCB: from the start of a stream or a split to the next. */
+struct radv_ps4_unit {
+   unsigned first_piece;
+   uint32_t words;
+   /* The unit starts a new DCB. */
+   bool starts_part;
+};
+
+static void
+radv_ps4_stream_pieces(const struct radv_ps4_cs *cs, struct util_dynarray *pieces)
+{
+   util_dynarray_foreach (&cs->chunks, struct radv_ps4_cs_chunk, chunk) {
+      if (chunk->cdw)
+         util_dynarray_append(pieces, *chunk);
+      else if (chunk->starts_submission)
+         util_dynarray_append(pieces, ((struct radv_ps4_cs_chunk){.starts_submission = true}));
+   }
+   util_dynarray_append(pieces, ((struct radv_ps4_cs_chunk){
+                                   .words = cs->base.buf,
+                                   .cdw = cs->base.cdw,
+                                   .max_dw = cs->base.max_dw,
+                                   .starts_submission = cs->buf_starts_submission,
+                                }));
+}
+
+static uint32_t
+radv_ps4_count_streams(struct ac_cmdbuf **streams, unsigned count)
+{
+   uint32_t words = 0;
+   for (unsigned i = 0; i < count; i++)
+      words += radv_ps4_cs_words(radv_ps4_cs(streams[i]));
+   return words;
+}
+
+static uint32_t *
+radv_ps4_copy_streams(uint32_t *at, struct ac_cmdbuf **streams, unsigned count)
+{
+   for (unsigned i = 0; i < count; i++) {
+      const struct radv_ps4_cs *cs = radv_ps4_cs(streams[i]);
+      util_dynarray_foreach (&cs->chunks, struct radv_ps4_cs_chunk, chunk) {
+         memcpy(at, chunk->words, (size_t)chunk->cdw * sizeof(uint32_t));
+         at += chunk->cdw;
+      }
+      memcpy(at, cs->base.buf, (size_t)cs->base.cdw * sizeof(uint32_t));
+      at += cs->base.cdw;
+   }
+   return at;
+}
+
+static VkResult
+radv_ps4_cs_submit(struct radeon_winsys_ctx *rctx, const struct radv_winsys_submit_info *submit, uint32_t wait_count,
+                   const struct vk_sync_wait *waits, uint32_t signal_count, const struct vk_sync_signal *signals)
+{
+   struct radv_ps4_ctx *ctx = (struct radv_ps4_ctx *)rctx;
+   struct radv_ps4_queue *queue = ctx->ws->queue;
+
+   if (submit->ip_type != AMD_IP_GFX)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   for (unsigned i = 0; i < submit->cs_count; i++) {
+      if (radv_ps4_cs(submit->cs_array[i])->status != VK_SUCCESS)
+         return radv_ps4_cs(submit->cs_array[i])->status;
+   }
+
+   /* The queue runs in order: waits only need their signals to be submitted. */
+   uint64_t depends = 0;
+   VkResult result = radv_ps4_sync_wait_submitted(wait_count, waits, &depends);
+   if (result != VK_SUCCESS)
+      return result;
+
+   simple_mtx_lock(&queue->submit_lock);
+
+   if (submit->cs_count == 0) {
+      const uint64_t last = queue->submitted_seq;
+      simple_mtx_unlock(&queue->submit_lock);
+      radv_ps4_sync_signal_seq(signal_count, signals, MAX2(last, depends));
+      return VK_SUCCESS;
+   }
+
+   /* Cut the streams and postambles into units. */
+   const uint32_t preamble_words = radv_ps4_count_streams(submit->initial_preamble_cs, submit->initial_preamble_count);
+   struct util_dynarray pieces, units;
+   util_dynarray_init(&pieces, NULL);
+   util_dynarray_init(&units, NULL);
+   for (unsigned i = 0; i < submit->cs_count + submit->postamble_count; i++) {
+      struct ac_cmdbuf *stream =
+         i < submit->cs_count ? submit->cs_array[i] : submit->postamble_cs[i - submit->cs_count];
+      const unsigned first = util_dynarray_num_elements(&pieces, struct radv_ps4_cs_chunk);
+      radv_ps4_stream_pieces(radv_ps4_cs(stream), &pieces);
+      const unsigned end = util_dynarray_num_elements(&pieces, struct radv_ps4_cs_chunk);
+      for (unsigned p = first; p < end; p++) {
+         struct radv_ps4_cs_chunk *piece = util_dynarray_element(&pieces, struct radv_ps4_cs_chunk, p);
+         if (p == first || piece->starts_submission)
+            util_dynarray_append(&units, ((struct radv_ps4_unit){.first_piece = p}));
+         util_dynarray_last_ptr(&units, struct radv_ps4_unit)->words += piece->cdw;
+      }
+   }
+
+   /* Pack the units into DCBs that each start with the preambles. */
+   const unsigned unit_count = util_dynarray_num_elements(&units, struct radv_ps4_unit);
+   const uint32_t room = RADV_PS4_SUBMIT_MAX_DW - RADV_PS4_COMPLETION_WORDS;
+   uint32_t count = preamble_words + RADV_PS4_COMPLETION_WORDS;
+   uint32_t fill = preamble_words;
+   bool too_large = false;
+   for (unsigned u = 0; u < unit_count; u++) {
+      struct radv_ps4_unit *unit = util_dynarray_element(&units, struct radv_ps4_unit, u);
+      if (preamble_words + unit->words > room)
+         too_large = true;
+      if (fill > preamble_words && fill + unit->words > room) {
+         unit->starts_part = true;
+         count += preamble_words;
+         fill = preamble_words;
+      }
+      fill += unit->words;
+      count += unit->words;
+   }
+
+   const uint64_t seq = queue->submitted_seq + 1;
+   uint32_t *words = too_large ? NULL : radv_ps4_queue_claim(queue, count, seq);
+   if (!words) {
+      simple_mtx_unlock(&queue->submit_lock);
+      util_dynarray_fini(&pieces);
+      util_dynarray_fini(&units);
+      if (too_large)
+         fprintf(stderr, "radv/ps4: too many words between two splits for one DCB\n");
+      return VK_ERROR_DEVICE_LOST;
+   }
+
+   struct util_dynarray starts;
+   util_dynarray_init(&starts, NULL);
+   util_dynarray_append(&starts, 0u);
+   uint32_t *at = radv_ps4_copy_streams(words, submit->initial_preamble_cs, submit->initial_preamble_count);
+   for (unsigned u = 0; u < unit_count; u++) {
+      const struct radv_ps4_unit *unit = util_dynarray_element(&units, struct radv_ps4_unit, u);
+      if (unit->starts_part) {
+         util_dynarray_append(&starts, (uint32_t)(at - words));
+         at = radv_ps4_copy_streams(at, submit->initial_preamble_cs, submit->initial_preamble_count);
+      }
+      const unsigned end = u + 1 < unit_count ? util_dynarray_element(&units, struct radv_ps4_unit, u + 1)->first_piece
+                                              : util_dynarray_num_elements(&pieces, struct radv_ps4_cs_chunk);
+      for (unsigned p = unit->first_piece; p < end; p++) {
+         const struct radv_ps4_cs_chunk *piece = util_dynarray_element(&pieces, struct radv_ps4_cs_chunk, p);
+         memcpy(at, piece->words, (size_t)piece->cdw * sizeof(uint32_t));
+         at += piece->cdw;
+      }
+   }
+   radv_ps4_completion_words(at, (uintptr_t)queue->marker, (uint32_t)seq);
+   at += RADV_PS4_COMPLETION_WORDS;
+   assert((uint32_t)(at - words) == count);
+   util_dynarray_fini(&pieces);
+   util_dynarray_fini(&units);
+
+   p_atomic_set(&queue->submitted_seq, seq);
+   int err = 0;
+   const unsigned parts = util_dynarray_num_elements(&starts, uint32_t);
+   for (unsigned i = 0; i < parts && !err; i++) {
+      const uint32_t start = *util_dynarray_element(&starts, uint32_t, i);
+      const uint32_t end = i + 1 < parts ? *util_dynarray_element(&starts, uint32_t, i + 1) : count;
+      err = radv_ps4_submit(words + start, end - start);
+   }
+   util_dynarray_fini(&starts);
+   simple_mtx_unlock(&queue->submit_lock);
+
+   if (err) {
+      fprintf(stderr, "radv/ps4: sceGnmSubmitCommandBuffers failed: 0x%08x\n", (unsigned)err);
+      return VK_ERROR_DEVICE_LOST;
+   }
+
+   radv_ps4_sync_signal_seq(signal_count, signals, seq);
+   radv_ps4_queue_release_retired(queue, false);
+   return VK_SUCCESS;
+}
+
+void
+radv_ps4_cs_init_functions(struct radv_ps4_winsys *ws)
+{
+   ws->base.cs_domain = radv_ps4_cs_domain;
+   ws->base.cs_create = radv_ps4_cs_create;
+   ws->base.cs_destroy = radv_ps4_cs_destroy;
+   ws->base.cs_grow = radv_ps4_cs_grow;
+   ws->base.cs_finalize = radv_ps4_cs_finalize;
+   ws->base.cs_reset = radv_ps4_cs_reset;
+   ws->base.cs_chain = radv_ps4_cs_chain;
+   ws->base.cs_unchain = radv_ps4_cs_unchain;
+   ws->base.cs_add_buffer = radv_ps4_cs_add_buffer;
+   ws->base.cs_execute_secondary = radv_ps4_cs_execute_secondary;
+   ws->base.cs_execute_ib = radv_ps4_cs_execute_ib;
+   ws->base.cs_chain_dgc_ib = radv_ps4_cs_chain_dgc_ib;
+   ws->base.cs_submit = radv_ps4_cs_submit;
+   ws->base.cs_dump = radv_ps4_cs_dump;
+   ws->base.cs_annotate = radv_ps4_cs_annotate;
+   ws->base.cs_pad = radv_ps4_cs_pad;
+   ws->base.cs_split_due = radv_ps4_cs_split_due;
+   ws->base.cs_split = radv_ps4_cs_split;
+}
