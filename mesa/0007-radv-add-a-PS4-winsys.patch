@@ -266,6 +277,10 @@ if with_platform_android
 endif
 
 radv_build_id = get_option('radv-build-id')
+# The PS4 has no dl_iterate_phdr to find the build id the shader cache is named after.
+if radv_build_id == '' and with_radv_ps4
+  error('The PS4 build needs -Dradv-build-id')
+endif
 if radv_build_id != ''
   radv_flags += '-DRADV_BUILD_ID_OVERRIDE="' + radv_build_id + '"'
 endif
@@ -275,8 +290,32 @@ if radv_u_trace
   radv_flags += '-DRADV_U_TRACE=1'
 endif
 
+radv_lib_name = 'vulkan_radeon'
+radv_lib_kwargs = {}
+radv_link_args = [ld_args_build_id, ld_args_bsymbolic, ld_args_gc_sections, vulkan_icd_link_args]
+radv_link_depends = vulkan_icd_link_depends
+if with_radv_ps4
+  # There is no Vulkan loader on the PS4: RADV is libvulkan.so.1 and exports the
+  # Vulkan API itself.
+  libradv_files += custom_target(
+    'radv_vk_exports',
+    input : [vk_exports_gen, vk_api_xml],
+    output : 'vk_exports.c',
+    command : [prog_python, '@INPUT0@', '--xml', '@INPUT1@', '--out-c', '@OUTPUT@'],
+    depend_files : vk_entrypoints_gen_depend_files,
+  )
+  _vk_header_version = fs.read(join_paths(meson.project_source_root(), 'include', 'vulkan', 'vulkan_core.h')) \
+    .split('#define VK_HEADER_VERSION ')[1].split('\n')[0].strip()
+  _vk_api_version = '1.4.' + _vk_header_version
+  radv_lib_name = 'vulkan'
+  radv_lib_kwargs = {'soversion' : '1', 'version' : _vk_api_version}
+  radv_link_args = [ld_args_bsymbolic, ld_args_gc_sections, ps4_sysmodule_libs,
+                    '-Wl,--version-script,@0@'.format(join_paths(meson.current_source_dir(), 'vulkan.sym'))]
+  radv_link_depends = files('vulkan.sym')
+endif
+
 libvulkan_radeon = shared_library(
-  'vulkan_radeon',
+  radv_lib_name,
   [libradv_files, radv_entrypoints, radv_drirc, sha1_h, radix_sort_spv, bvh_spv, radv_annotate_layer],
   vs_module_defs : vulkan_api_def,
   include_directories : [
@@ -295,15 +334,24 @@ libvulkan_radeon = shared_library(
   ],
   c_args : [no_override_init_args, radv_flags, c_msvc_compat_args],
   cpp_args : [radv_flags, cpp_msvc_compat_args],
-  link_args : [
-    ld_args_build_id, ld_args_bsymbolic, ld_args_gc_sections, vulkan_icd_link_args,
-  ],
-  link_depends : vulkan_icd_link_depends,
+  link_args : radv_link_args,
+  link_depends : radv_link_depends,
   gnu_symbol_visibility : 'hidden',
   name_prefix : host_machine.system() == 'windows' ? '' : [],
   install : true,
+  kwargs : radv_lib_kwargs,
 )
 
+if with_radv_ps4
+  pkg.generate(
+    name : 'vulkan',
+    filebase : 'vulkan',
+    description : 'Vulkan (Mesa RADV for the PlayStation 4)',
+    version : _vk_api_version,
+    libraries : [libvulkan_radeon, ps4_sysmodule_libs],
+  )
+endif
+
 if with_symbols_check
   test(
     'radv symbols check',
