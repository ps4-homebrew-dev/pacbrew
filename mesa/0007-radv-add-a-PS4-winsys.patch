+/* ---------------------------------------------------------------------------------- winsys */
+
+static uint64_t
+radv_ps4_winsys_query_value(struct radeon_winsys *rws, enum radeon_value_id value)
+{
+   struct radv_ps4_winsys *ws = radv_ps4_winsys(rws);
+
+   switch (value) {
+   case RADEON_ALLOCATED_VRAM:
+   case RADEON_ALLOCATED_VRAM_VIS:
+   case RADEON_VRAM_USAGE:
+   case RADEON_VRAM_VIS_USAGE:
+      return p_atomic_read(&ws->allocated_vram);
+   case RADEON_ALLOCATED_GTT:
+   case RADEON_GTT_USAGE:
+      return p_atomic_read(&ws->allocated_gtt);
+   case RADEON_TIMESTAMP:
+      return radv_ps4_read_gpu_clock();
+   default:
+      return 0;
+   }
+}
