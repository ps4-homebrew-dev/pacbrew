+   ws->info = *info;
+   ws->queue = queue;
+
+   ws->base.destroy = radv_ps4_winsys_destroy;
+   ws->base.query_value = radv_ps4_winsys_query_value;
+   ws->base.read_registers = radv_ps4_winsys_read_registers;
+   ws->base.query_gpuvm_fault = radv_ps4_winsys_query_gpuvm_fault;
+   ws->base.ctx_create = radv_ps4_ctx_create;
+   ws->base.ctx_destroy = radv_ps4_ctx_destroy;
+   ws->base.ctx_wait_idle = radv_ps4_ctx_wait_idle;
+   ws->base.ctx_set_pstate = radv_ps4_ctx_set_pstate;
+   ws->base.get_fd = radv_ps4_winsys_get_fd;
+   ws->base.get_sync_provider = radv_ps4_winsys_get_sync_provider;
+   ws->base.copy_sync_payloads = radv_ps4_sync_copy_payloads;
+   ws->base.reserve_vmid = radv_ps4_winsys_reserve_vmid;
+   ws->base.unreserve_vmid = radv_ps4_winsys_unreserve_vmid;
+   radv_ps4_bo_init_functions(ws);
+   radv_ps4_cs_init_functions(ws);
+
+   *winsys = &ws->base;
+   return VK_SUCCESS;
+}
