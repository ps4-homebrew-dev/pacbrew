+/* Liverpool is a GFX7 GPU, described to RADV as a Bonaire with Liverpool's units: two shader
+ * engines with one shader array each, 18 CUs, 8 RBs, 8 memory channels and 8 tiling pipes.
+ */
+static void
+radv_ps4_describe_gpu(struct radeon_info *info, bool compiler_compat_mode)
+{
+   const struct drm_amdgpu_info_hw_ip gfx_ip = {
+      .hw_ip_version_major = 7,
+      .hw_ip_version_minor = 0,
+      .ib_start_alignment = 32,
+      .ib_size_alignment = 32,
+      .available_rings = 0x1,
+   };
+   struct drm_amdgpu_info_device dev = {
+      .device_id = 0x9920,
+      .chip_rev = 0,
+      .external_rev = 0x14, /* Bonaire */
+      .family = FAMILY_CI,
+      .num_shader_engines = 2,
+      .num_shader_arrays_per_engine = 1,
+      .cu_active_number = 18,
+      .cu_ao_mask = 0x1ff,
+      .cu_bitmap = {{0x1ff}, {0x1ff}},
+      .cu_ao_bitmap = {{0x1ff}, {0x1ff}},
+      .num_cu_per_sh = 9,
+      .enabled_rb_pipes_mask = 0xff,
+      .num_rb_pipes = 8,
+      .num_tcc_blocks = 8,
+      .gpu_counter_freq = 100000, /* kHz */
+      .max_engine_clock = UINT64_C(800000),
+      .min_engine_clock = UINT64_C(300000),
+      .max_memory_clock = UINT64_C(1375000),
+      .min_memory_clock = UINT64_C(150000),
+      .num_hw_gfx_contexts = 8,
+      .ids_flags = AMDGPU_IDS_FLAGS_FUSION,
+      .virtual_address_offset = UINT64_C(0x200000),
+      .virtual_address_max = RADV_PS4_GPU_ADDRESS_LIMIT,
+      .virtual_address_alignment = RADV_PS4_PAGE_BYTES,
+      .pte_fragment_size = 2097152,
+      .gart_page_size = RADV_PS4_PAGE_BYTES,
+      .vram_type = AMDGPU_VRAM_TYPE_GDDR5,
+      .vram_bit_width = 256,
+      .gc_double_offchip_lds_buf = 0,
+      .wave_front_size = 64,
+      .num_shader_visible_vgprs = 256,
+      .gs_vgt_table_depth = 32,
+      .gs_prim_buffer_depth = 1792,
+      .max_gs_waves_per_vgt = 32,
+   };
+   /* One pool of memory, split between "VRAM" and "GTT" like an APU's. */
+   const uint64_t pool = radv_ps4_memory_pool_bytes();
+   const struct drm_amdgpu_memory_info memory = {
+      .vram = {.total_heap_size = pool / 2},
+      .cpu_accessible_vram = {.total_heap_size = pool / 2},
+      .gtt = {.total_heap_size = pool - pool / 2},
+   };
+   struct amdgpu_gpu_info gpu_info = {
+      .gb_addr_cfg = RADV_PS4_GB_ADDR_CONFIG,
+      .mc_arb_ramcfg = RADV_PS4_MC_ARB_RAMCFG,
+   };
+   memcpy(gpu_info.gb_tile_mode, radv_ps4_gb_tile_mode, sizeof(radv_ps4_gb_tile_mode));
+   memcpy(gpu_info.gb_macro_tile_mode, radv_ps4_gb_macrotile_mode, sizeof(radv_ps4_gb_macrotile_mode));
+
+   memset(info, 0, sizeof(*info));
+   /* The oldest kernel RADV supports, so that no newer kernel features are assumed. */
+   info->drm_major = 3;
+   info->drm_minor = 54;
+
+   ac_fill_hw_ip_info(info, &dev, AMD_IP_GFX, &gfx_ip);
+   info->ip[AMD_IP_GFX].num_instances = 1;
+   ac_identify_chip(info, &dev);
+   ac_fill_memory_info(info, &dev, &memory);
+   ac_fill_hw_info(info, &dev);
+   ac_fill_tiling_info(info, &gpu_info);
+   ac_fill_feature_info(info, &dev);
+   ac_fill_bug_info(info);
+   ac_fill_tess_info(info);
+   ac_fill_compiler_info(info, &dev, compiler_compat_mode);
+   assert(info->family == CHIP_BONAIRE && info->gfx_level == GFX7);
+
+   snprintf(info->marketing_name, sizeof(info->marketing_name), "PlayStation 4 GPU (Liverpool)");
+   info->l2_cache_size = info->num_tcc_blocks * 64 * 1024;
+
+   /* What the system does differently from the amdgpu kernel. */
+   info->has_kernel_raster_config = true;
+   /* SH_MEM_CONFIG.ALIGNMENT_MODE isn't UNALIGNED: misaligned typed fetches return wrong data. */
+   info->compiler_info.has_unaligned_typed_vtx_fetch = false;
+   info->fixed_gs_ring_size = RADV_PS4_GS_RING_BYTES;
+   info->hs_offchip_param = (info->hs_offchip_param & C_03093C_OFFCHIP_BUFFERING_GFX7) |
+                            S_03093C_OFFCHIP_BUFFERING_GFX7(RADV_PS4_TESS_OFFCHIP_WORKGROUPS);
+   info->tess_offchip_ring_size = RADV_PS4_TESS_OFFCHIP_WORKGROUPS * info->hs_offchip_workgroup_dw_size * 4;
+   info->fixed_tess_factor_ring_va = radv_ps4_tess_factor_ring_va();
+   info->fixed_tess_factor_ring_size = info->fixed_tess_factor_ring_va ? RADV_PS4_TESS_FACTOR_RING_BYTES : 0;
+   info->total_tess_ring_size =
+      info->tess_offchip_ring_size + (info->fixed_tess_factor_ring_va ? 0 : info->tess_factor_ring_size);
+
+   /* The CP hangs on SET_PREDICATION and DRAW_*INDIRECT_MULTI, the CB on CMASK. */
+   info->has_set_predication = false;
+   info->has_draw_indirect_multi = false;
+   info->has_cmask = false;
+   info->has_external_fd = false;
+   info->has_gpu_written_ibs = false;
+   info->has_replayable_va = false;
+   info->has_sparse = false;
+   info->has_userptr = true;
+   info->has_vm_always_valid = true;
+   info->has_dedicated_vram = false;
+   info->all_vram_visible = true;
+   info->address32_hi = radv_ps4_address32_hi();
+   /* Built over the binary sync type by the runtime. */
+   info->has_timeline_syncobj = true;
+   info->kernel_has_modifiers = false;
+   info->num_compute_queues_on_gfx = 4;
+   info->max_submitted_ibs[AMD_IP_GFX] = 1;
+
+   /* What ac_query_gpu_info would derive. */
+   info->spi_cu_en = ~0u;
+   info->scratch_wavesize_granularity_shift = 10;
+   info->scratch_wavesize_granularity = BITFIELD_BIT(info->scratch_wavesize_granularity_shift);
+   info->max_scratch_waves = MAX2(32 * info->max_good_cu_per_sa * info->max_sa_per_se * info->num_se, 32);
+   info->has_scratch_base_registers = false;
+   info->max_gflops = 128 * info->num_cu * info->max_gpu_freq_mhz / 1000;
+   info->memory_bandwidth_gbps = DIV_ROUND_UP(info->memory_freq_mhz_effective * info->memory_bus_width / 8, 1000);
+   info->instr_prefetch_distance = 0;
+   ac_get_raster_config(info, &info->pa_sc_raster_config, &info->pa_sc_raster_config_1, &info->se_tile_repeat);
+
+   if (radv_ps4_platform_is_neo())
+      fprintf(stderr, "radv/ps4: PS4 Pro mode isn't supported, images may be laid out wrong\n");
+}
