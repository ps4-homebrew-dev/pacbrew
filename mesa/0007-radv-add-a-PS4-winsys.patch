+
+#ifndef RADV_PS4_WINSYS_H
+#define RADV_PS4_WINSYS_H
+
+#include "radv_ps4_platform.h"
+#include "radv_ps4_winsys_public.h"
+
+#include "c11/threads.h"
+#include "util/simple_mtx.h"
+#include "util/u_dynarray.h"
+
+/* The PS4 winsys submits to the graphics ring with sceGnmSubmitCommandBuffers.
+ *
+ * Every device and every RADV queue shares that ring. Submissions get increasing sequence
+ * numbers, and each one ends with an EOP event that writes the low 32 bits of its number to the
+ * marker: the GPU has finished everything up to the number the marker holds.
+ *
+ * Nothing runs as an INDIRECT_BUFFER: the words of a submission are copied into a ring buffer and
+ * submitted as one DCB, or several when they don't fit in one (radv_ps4_cs.c).
+ */
+
+#define RADV_PS4_RING_BYTES (UINT64_C(16) << 20)
+#define RADV_PS4_RING_WORDS ((uint32_t)(RADV_PS4_RING_BYTES / 4))
+#define RADV_PS4_MAX_IN_FLIGHT 4096
+
+/* The EVENT_WRITE_EOP that ends every submission. */
+#define RADV_PS4_COMPLETION_WORDS 6
+
+struct radv_ps4_in_flight {
+   uint64_t seq;
+   /* Words [start, end) of the ring, or memory of its own for a large submission. */
+   uint32_t start;
+   uint32_t end;
+   struct radv_ps4_memory dedicated;
+};
+
+/* Memory freed once the GPU has finished submission seq. */
+struct radv_ps4_release {
+   uint64_t seq;
+   struct radv_ps4_memory memory;
+};
+
+/* The GPU queue, shared by all winsyses of the process. */
+struct radv_ps4_queue {
+   /* Held while claiming ring space and submitting, so sequence numbers reach the GPU in order. */
+   simple_mtx_t submit_lock;
+   struct radv_ps4_memory ring;
+   uint32_t ring_head;
+   struct radv_ps4_in_flight in_flight[RADV_PS4_MAX_IN_FLIGHT];
+   uint32_t in_flight_first;
+   uint32_t in_flight_count;
+
+   struct radv_ps4_memory marker_memory;
+   volatile uint32_t *marker;
+   uint64_t submitted_seq;
+   uint64_t completed_seq;
+
+   /* Signalled whenever a sync object is submitted for signalling. */
+   mtx_t sync_lock;
+   cnd_t sync_cond;
+
+   /* Memory of destroyed buffers the GPU may still use, oldest first. RADV relies on the kernel
+    * keeping buffers alive until the submissions using them have finished.
+    */
+   simple_mtx_t release_lock;
+   struct util_dynarray releases;
+};
+
+/* The process's queue, or NULL if it couldn't be created. */
+struct radv_ps4_queue *radv_ps4_queue_get(void);
+
+/* The sequence number the GPU has finished. */
+uint64_t radv_ps4_queue_poll(struct radv_ps4_queue *queue);
+/* Waits until the GPU has finished seq; false on timeout or a hang. */
+bool radv_ps4_queue_wait_seq(struct radv_ps4_queue *queue, uint64_t seq, uint64_t abs_timeout_ns);
+
+/* Frees memory once the submissions made so far have finished. */
+void radv_ps4_queue_release(struct radv_ps4_queue *queue, struct radv_ps4_memory *memory);
+/* Frees the released memory the GPU is done with, after waiting for all of it if wait is set.
+ * Returns whether anything was freed.
+ */
+bool radv_ps4_queue_release_retired(struct radv_ps4_queue *queue, bool wait);
+
+uint64_t radv_ps4_read_gpu_clock(void);
+
+struct radv_ps4_winsys {
+   struct radeon_winsys base;
+   struct radeon_info info;
+   struct radv_ps4_queue *queue;
+
+   uint64_t allocated_vram;
+   uint64_t allocated_gtt;
+};
+
+static inline struct radv_ps4_winsys *
+radv_ps4_winsys(struct radeon_winsys *base)
+{
+   return (struct radv_ps4_winsys *)base;
+}
+
+struct radv_ps4_bo {
+   struct radeon_winsys_bo base;
+   struct radv_ps4_memory memory;
+   struct radeon_bo_metadata metadata;
+   /* The VK_EXT_map_memory_placed mapping, if any. */
+   void *placed;
+   /* Imported host memory, which stays the application's. */
+   bool imported;
+};
+
+static inline struct radv_ps4_bo *
+radv_ps4_bo(struct radeon_winsys_bo *base)
+{
+   return (struct radv_ps4_bo *)base;
+}
+
+/* Command streams are kept in CPU memory, in chunks that never move. */
+struct radv_ps4_cs_chunk {
+   uint32_t *words;
+   uint32_t cdw;
+   uint32_t max_dw;
+   /* The chunk starts at a split (cs_split), where a DCB may begin. */
+   bool starts_submission;
+};
+
+struct radv_ps4_cs {
+   struct ac_cmdbuf base;
+   struct radv_ps4_winsys *ws;
+   enum amd_ip_type ip_type;
+   VkResult status;
+   /* Finished chunks, oldest first; the current one is base.buf. */
+   struct util_dynarray chunks;
+   uint32_t words_in_chunks;
+   bool buf_starts_submission;
+   /* Where in the stream the last split is. */
+   uint32_t split_at;
+};
+
+static inline struct radv_ps4_cs *
+radv_ps4_cs(struct ac_cmdbuf *base)
+{
+   return (struct radv_ps4_cs *)base;
+}
+
+struct radv_ps4_ctx {
+   struct radv_ps4_winsys *ws;
+};
+
+/* A binary sync object signalled by a submission, or by the host. */
+extern const struct vk_sync_type radv_ps4_sync_type;
+/* Waits until the waits have been submitted for signalling, and returns the latest sequence
+ * number they depend on.
+ */
+VkResult radv_ps4_sync_wait_submitted(uint32_t wait_count, const struct vk_sync_wait *waits, uint64_t *seq);
+/* Makes the signals signalled once the GPU has finished seq. */
+void radv_ps4_sync_signal_seq(uint32_t signal_count, const struct vk_sync_signal *signals, uint64_t seq);
+VkResult radv_ps4_sync_copy_payloads(struct vk_device *device, uint32_t wait_count, const struct vk_sync_wait *waits,
+                                     uint32_t signal_count, const struct vk_sync_signal *signals);
+
+/* Direct memory held by all winsyses of the process. */
+extern uint64_t radv_ps4_allocated_bytes;
+
+void radv_ps4_completion_words(uint32_t *words, uint64_t marker_address, uint32_t value);
+
+void radv_ps4_bo_init_functions(struct radv_ps4_winsys *ws);
+void radv_ps4_cs_init_functions(struct radv_ps4_winsys *ws);
+
+#endif /* RADV_PS4_WINSYS_H */
