+void
+radv_ps4_winsys_heap_usage(uint64_t *pool_bytes, uint64_t *available_bytes, uint64_t *driver_bytes)
+{
+   *pool_bytes = radv_ps4_memory_pool_bytes();
+   *available_bytes = radv_ps4_memory_available_bytes();
+   *driver_bytes = p_atomic_read(&radv_ps4_allocated_bytes);
+}
+
+VkResult
+radv_ps4_winsys_query_info(uint64_t debug_flags, struct radeon_winsys_info *info)
+{
+   memset(info, 0, sizeof(*info));
+   if (!radv_ps4_queue_get())
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   radv_ps4_describe_gpu(&info->base, !(debug_flags & RADV_DEBUG_NO_CACHE_COMPAT));
+   info->syncobj_sync_type = radv_ps4_sync_type;
+   /* There is one queue: allow only the priorities any application may use. */
+   info->global_priority_mask = BITFIELD_BIT(RADEON_CTX_PRIORITY_LOW) | BITFIELD_BIT(RADEON_CTX_PRIORITY_MEDIUM);
+   return VK_SUCCESS;
+}
