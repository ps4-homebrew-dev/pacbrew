+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "radv_ps4_platform.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "c11/threads.h"
+#include "util/macros.h"
+#include "util/simple_mtx.h"
+#include "util/u_math.h"
+#include "ps4_sce.h"
+
+#define RADV_PS4_PROT_CPU_GPU_RW                                                                                     \
+   (PS4_KERNEL_PROT_CPU_READ | PS4_KERNEL_PROT_CPU_WRITE | PS4_KERNEL_PROT_GPU_READ | PS4_KERNEL_PROT_GPU_WRITE)
+
+/* The window for 32-bit pointers, handed out first fit in granules. */
+#define RADV_PS4_GRANULES ((uint32_t)(RADV_PS4_WINDOW_BYTES / RADV_PS4_GRANULE_BYTES))
+
+static struct {
+   simple_mtx_t lock;
+   uint8_t *base;
+   uint32_t granules;
+   uint64_t used[RADV_PS4_GRANULES / 64];
+} radv_ps4_window = {.lock = SIMPLE_MTX_INITIALIZER};
+
+static bool radv_ps4_neo;
+static uint64_t radv_ps4_tess_factor_ring;
+
+static bool
+radv_ps4_granule_used(uint32_t granule)
+{
+   return radv_ps4_window.used[granule / 64] & (UINT64_C(1) << (granule % 64));
+}
+
+static void
+radv_ps4_granules_mark_locked(uint32_t first, uint32_t count, bool used)
+{
+   for (uint32_t g = first; g < first + count; g++) {
+      if (used)
+         radv_ps4_window.used[g / 64] |= UINT64_C(1) << (g % 64);
+      else
+         radv_ps4_window.used[g / 64] &= ~(UINT64_C(1) << (g % 64));
+   }
+}
+
+static void
+radv_ps4_granules_release(uint32_t first, uint32_t count)
+{
+   simple_mtx_lock(&radv_ps4_window.lock);
+   radv_ps4_granules_mark_locked(first, count, false);
+   simple_mtx_unlock(&radv_ps4_window.lock);
+}
+
+/* Takes the first free run of count granules aligned to align, or returns UINT32_MAX. */
+static uint32_t
+radv_ps4_granules_take(uint32_t count, uint32_t align)
+{
+   uint32_t result = UINT32_MAX;
+
+   simple_mtx_lock(&radv_ps4_window.lock);
+   for (uint32_t first = 0; first + count <= radv_ps4_window.granules; first += align) {
+      uint32_t g = first;
+      while (g < first + count && !radv_ps4_granule_used(g))
+         g++;
+      if (g == first + count) {
+         radv_ps4_granules_mark_locked(first, count, true);
+         result = first;
+         break;
+      }
+      /* Skip past the used granule, keeping the alignment. */
+      first = (g / align) * align;
+   }
+   simple_mtx_unlock(&radv_ps4_window.lock);
+   return result;
+}
+
+uint32_t
+radv_ps4_address32_hi(void)
+{
+   return (uint32_t)((uintptr_t)radv_ps4_window.base >> 32);
+}
+
+uint64_t
+radv_ps4_tess_factor_ring_va(void)
+{
+   return radv_ps4_tess_factor_ring;
+}
+
+bool
+radv_ps4_platform_is_neo(void)
+{
+   return radv_ps4_neo;
+}
+
+/* Writes back and drops the CPU cache lines of a range. A dirty line left by an earlier onion
+ * owner of the memory could otherwise be evicted over what was written through a garlic mapping.
+ */
+static void
+radv_ps4_cpu_drop_lines(const void *address, uint64_t bytes)
+{
+   __builtin_ia32_mfence();
+   for (uintptr_t line = (uintptr_t)address & ~(uintptr_t)63; line < (uintptr_t)address + bytes; line += 64)
+      __builtin_ia32_clflush((const void *)line);
+   __builtin_ia32_mfence();
+}
+
+static bool
+radv_ps4_window_fits(const uint8_t *window, uint64_t bytes)
+{
+   const uint64_t at = (uintptr_t)window;
+   return at % bytes == 0 && at + bytes <= RADV_PS4_GPU_ADDRESS_LIMIT;
+}
+
+/* Reserves a window of bytes aligned to its size: directly, or by trimming a reservation twice as
+ * large.
+ */
+static uint8_t *
+radv_ps4_window_reserve(uint64_t bytes)
+{
+   void *window = NULL;
+   if (sceKernelReserveVirtualRange(&window, bytes, 0, bytes) == 0) {
+      if (radv_ps4_window_fits(window, bytes))
+         return window;
+      sceKernelMunmap(window, bytes);
+   }
+
+   void *range = NULL;
+   if (sceKernelReserveVirtualRange(&range, 2 * bytes, 0, RADV_PS4_PAGE_BYTES) == 0) {
+      uint8_t *const start = range;
+      uint8_t *const end = start + 2 * bytes;
+      uint8_t *const at = (uint8_t *)align_uintptr((uintptr_t)start, bytes);
+      if (at > start)
+         sceKernelMunmap(start, at - start);
+      if (end > at + bytes)
+         sceKernelMunmap(at + bytes, end - (at + bytes));
+      if (radv_ps4_window_fits(at, bytes))
+         return at;
+      sceKernelMunmap(at, bytes);
+   }
+
+   return NULL;
+}
+
+/* Maps memory at the system's tess factor ring address, which the VGT reads whatever
+ * VGT_TF_MEMORY_BASE is set to.
+ */
+static void
+radv_ps4_tess_factor_ring_map(void)
+{
+   const uint64_t at = sceGnmGetTheTessellationFactorRingBufferBaseAddress();
+   const uint64_t bytes = RADV_PS4_TESS_FACTOR_RING_BYTES;
+   int64_t physical = 0;
+   void *address = (void *)(uintptr_t)at;
+
+   if (!at || at % RADV_PS4_PAGE_BYTES || at + bytes > RADV_PS4_GPU_ADDRESS_LIMIT ||
+       sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), bytes, RADV_PS4_LARGE_BYTES,
+                                     PS4_KERNEL_WC_GARLIC, &physical)) {
+      fprintf(stderr, "radv/ps4: no tessellation factor ring at 0x%" PRIx64 "\n", at);
+      return;
+   }
+
+   const int err =
+      sceKernelMapDirectMemory(&address, bytes, RADV_PS4_PROT_CPU_GPU_RW, 0, physical, RADV_PS4_PAGE_BYTES);
+   if (err || (uintptr_t)address != at) {
+      if (!err)
+         sceKernelMunmap(address, bytes);
+      sceKernelReleaseDirectMemory(physical, bytes);
+      fprintf(stderr, "radv/ps4: the tessellation factor ring address 0x%" PRIx64 " is taken\n", at);
+      return;
+   }
+
+   radv_ps4_cpu_drop_lines(address, bytes);
+   memset(address, 0, bytes);
+   radv_ps4_cpu_flush();
+   radv_ps4_tess_factor_ring = at;
+}
+
+static bool radv_ps4_platform_ready;
+static once_flag radv_ps4_platform_flag = ONCE_FLAG_INIT;
+
+static void
+radv_ps4_platform_once(void)
+{
+   /* /app0 is read-only, so the shader cache goes to /data, unless the title says otherwise. */
+   setenv("MESA_SHADER_CACHE_DIR", "/data/radv-shader-cache", 0);
+   setenv("MESA_DISK_CACHE_DATABASE", "1", 0);
+
+   /* The largest window the kernel gives; RADV's 32-bit buffers fit in far less than 4 GiB. */
+   static const uint64_t sizes[] = {RADV_PS4_WINDOW_BYTES, UINT64_C(1) << 30, UINT64_C(256) << 20};
+   for (unsigned i = 0; i < ARRAY_SIZE(sizes) && !radv_ps4_window.base; i++) {
+      radv_ps4_window.base = radv_ps4_window_reserve(sizes[i]);
+      radv_ps4_window.granules = sizes[i] / RADV_PS4_GRANULE_BYTES;
+   }
+   if (!radv_ps4_window.base) {
+      fprintf(stderr, "radv/ps4: no address range for 32-bit pointers\n");
+      return;
+   }
+
+   radv_ps4_neo = sceKernelIsNeoMode() > 0;
+
+   const int err = sceGnmSetGsRingSizes(RADV_PS4_GS_RING_BYTES, RADV_PS4_GS_RING_BYTES);
+   if (err)
+      fprintf(stderr, "radv/ps4: sceGnmSetGsRingSizes failed: 0x%08x\n", (unsigned)err);
+
+   radv_ps4_tess_factor_ring_map();
+   radv_ps4_platform_ready = true;
+}
+
+bool
+radv_ps4_platform_init(void)
+{
+   call_once(&radv_ps4_platform_flag, radv_ps4_platform_once);
+   return radv_ps4_platform_ready;
+}
+
+bool
+radv_ps4_memory_gpu_mapped(const void *address, uint64_t bytes)
+{
+   const uint8_t *at = address;
+   const uint8_t *const end = at + bytes;
+
+   if ((uintptr_t)address >= RADV_PS4_GPU_ADDRESS_LIMIT || bytes > RADV_PS4_GPU_ADDRESS_LIMIT - (uintptr_t)address)
+      return false;
+
+   while (at < end) {
+      struct ps4_kernel_virtual_query_info query;
+      if (sceKernelVirtualQuery(at, 0, &query, sizeof(query)) != 0 ||
+          (query.protection & (PS4_KERNEL_PROT_GPU_READ | PS4_KERNEL_PROT_GPU_WRITE)) !=
+             (PS4_KERNEL_PROT_GPU_READ | PS4_KERNEL_PROT_GPU_WRITE) ||
+          (const uint8_t *)query.start > at || (const uint8_t *)query.end <= at)
+         return false;
+      at = query.end;
+   }
+   return true;
+}
+
+uint64_t
+radv_ps4_memory_pool_bytes(void)
+{
+   return sceKernelGetDirectMemorySize();
+}
+
+uint64_t
+radv_ps4_memory_available_bytes(void)
+{
+   int64_t physical = 0;
+   size_t available = 0;
+   if (sceKernelAvailableDirectMemorySize(0, sceKernelGetDirectMemorySize(), 0, &physical, &available))
+      return 0;
+   return available;
+}
+
+static bool
+radv_ps4_map(int64_t physical, uint64_t bytes, uint64_t alignment, void *at, uint8_t **out)
+{
+   void *address = at;
+
+   if (sceKernelMapDirectMemory(&address, bytes, RADV_PS4_PROT_CPU_GPU_RW, at ? PS4_KERNEL_MAP_FIXED : 0, physical,
+                                alignment))
+      return false;
+
+   if ((at && address != at) || (uintptr_t)address + bytes > RADV_PS4_GPU_ADDRESS_LIMIT) {
+      sceKernelMunmap(address, bytes);
+      return false;
+   }
+
+   *out = address;
+   return true;
+}
+
+/* Gives a range back to the window's reservation. */
+static void
+radv_ps4_reserve_again(void *at, uint64_t bytes)
+{
+   void *again = at;
+   if (sceKernelReserveVirtualRange(&again, bytes, PS4_KERNEL_MAP_FIXED, RADV_PS4_PAGE_BYTES) || again != at)
+      fprintf(stderr, "radv/ps4: could not reserve %p again\n", at);
+}
+
+bool
+radv_ps4_memory_alloc(uint64_t bytes, uint64_t alignment, bool window32, enum radv_ps4_memory_type type,
+                      struct radv_ps4_memory *out)
+{
+   const int memory_type = type == RADV_PS4_MEMORY_ONION ? PS4_KERNEL_WB_ONION : PS4_KERNEL_WC_GARLIC;
+   int64_t physical = 0;
+   void *at = NULL;
+
+   memset(out, 0, sizeof(*out));
+
+   alignment = MAX2(alignment, RADV_PS4_PAGE_BYTES);
+   if (bytes >= RADV_PS4_LARGE_BYTES)
+      alignment = MAX2(alignment, RADV_PS4_LARGE_BYTES);
+   alignment = util_next_power_of_two64(alignment);
+   bytes = align64(MAX2(bytes, 1), RADV_PS4_PAGE_BYTES);
+
+   if (sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), bytes, alignment, memory_type, &physical))
+      return false;
+
+   if (window32) {
+      const uint32_t count = DIV_ROUND_UP(bytes, RADV_PS4_GRANULE_BYTES);
+      const uint32_t first = radv_ps4_granules_take(count, MAX2(alignment / RADV_PS4_GRANULE_BYTES, 1));
+      if (first == UINT32_MAX) {
+         sceKernelReleaseDirectMemory(physical, bytes);
+         return false;
+      }
+      out->granule = first;
+      out->granules = count;
+      out->in_window = true;
+      at = radv_ps4_window.base + (uint64_t)first * RADV_PS4_GRANULE_BYTES;
+   }
+
+   if (!radv_ps4_map(physical, bytes, alignment, at, &out->cpu)) {
+      if (window32)
+         radv_ps4_granules_release(out->granule, out->granules);
+      sceKernelReleaseDirectMemory(physical, bytes);
+      return false;
+   }
+
+   if (type == RADV_PS4_MEMORY_GARLIC)
+      radv_ps4_cpu_drop_lines(out->cpu, bytes);
+   out->bytes = bytes;
+   out->physical = physical;
+   return true;
+}
+
+void
+radv_ps4_memory_free(struct radv_ps4_memory *memory)
+{
+   if (!memory->cpu)
+      return;
+
+   sceKernelMunmap(memory->cpu, memory->bytes);
+   if (memory->in_window) {
+      radv_ps4_reserve_again(memory->cpu, memory->bytes);
+      radv_ps4_granules_release(memory->granule, memory->granules);
+   }
+   sceKernelReleaseDirectMemory(memory->physical, memory->bytes);
+   memset(memory, 0, sizeof(*memory));
+}
+
+bool
+radv_ps4_memory_map_at(const struct radv_ps4_memory *memory, void *address)
+{
+   uint8_t *cpu;
+   return radv_ps4_map(memory->physical, memory->bytes, RADV_PS4_PAGE_BYTES, address, &cpu);
+}
+
+void
+radv_ps4_memory_unmap_at(void *address, uint64_t bytes, bool reserve)
+{
+   sceKernelMunmap(address, bytes);
+   if (reserve) {
+      void *again = address;
+      sceKernelReserveVirtualRange(&again, bytes, PS4_KERNEL_MAP_FIXED, RADV_PS4_PAGE_BYTES);
+   }
+}
+
+int
+radv_ps4_submit(uint32_t *words, uint32_t count)
+{
+   void *dcb = words;
+   uint32_t dcb_bytes = count * 4;
+   void *ccb = NULL;
+   uint32_t ccb_bytes = 0;
+
+   radv_ps4_cpu_flush();
+   int err = sceGnmSubmitCommandBuffers(1, &dcb, &dcb_bytes, &ccb, &ccb_bytes);
+   if (!err)
+      err = sceGnmSubmitDone();
+   return err;
+}
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h
new file mode 100644
index 0000000..22046fb
--- /dev/null
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h
@@ -0,0 +1,106 @@
+/*
+ * Copyright © 2026 Mihawk
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef RADV_PS4_PLATFORM_H
+#define RADV_PS4_PLATFORM_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* The PS4 system interface: libkernel direct memory, mapped at the same address for the CPU and
+ * the GPU, and libSceGnmDriver submission.
+ *
+ * Memory is either garlic (CPU write-combined, the GPU's fast path) or onion (CPU cached, GPU
+ * coherent). Neither needs CPU cache flushes for the GPU to see CPU writes; write-combined stores
+ * only need to be drained (radv_ps4_cpu_flush). The exception is memory that changes from onion
+ * to garlic, whose stale CPU cache lines are dropped when it is allocated.
+ */
+
+/* GFX7 GPU virtual addresses are 40 bits. */
+#define RADV_PS4_GPU_ADDRESS_LIMIT (UINT64_C(1) << 40)
+
+/* 32-bit pointers share their high word: they use a window within one 4 GiB block. */
+#define RADV_PS4_WINDOW_BYTES (UINT64_C(1) << 32)
+
+/* Direct memory comes in 16 KiB pages, with 2 MiB alignment for allocations of 2 MiB or more.
+ * The window is handed out in 64 KiB granules.
+ */
+#define RADV_PS4_PAGE_BYTES UINT64_C(0x4000)
+#define RADV_PS4_LARGE_BYTES UINT64_C(0x200000)
+#define RADV_PS4_GRANULE_BYTES UINT64_C(0x10000)
+
+/* The largest DCB Gnm accepts. */
+#define RADV_PS4_DCB_MAX_BYTES UINT32_C(0x3ffffc)
+
+/* The system owns VGT_ESGS_RING_SIZE and VGT_GSVS_RING_SIZE (writes from a command buffer are
+ * ignored); the platform sets both to the largest size sceGnmSetGsRingSizes accepts.
+ */
+#define RADV_PS4_GS_RING_BYTES (UINT32_C(8) << 20)
+
+/* The system owns VGT_HS_OFFCHIP_PARAM and VGT_TF_MEMORY_BASE too: the VGT uses 256 off-chip
+ * buffers (as sceGnmGetOffChipTessellationBufferSize says), and reads the tess factors at the
+ * system's address, where the platform maps this much memory.
+ */
+#define RADV_PS4_TESS_OFFCHIP_WORKGROUPS 256
+#define RADV_PS4_TESS_FACTOR_RING_BYTES (UINT32_C(2) << 20)
+
+enum radv_ps4_memory_type {
+   RADV_PS4_MEMORY_GARLIC,
+   RADV_PS4_MEMORY_ONION,
+};
+
+struct radv_ps4_memory {
+   /* The CPU mapping, which is also the GPU address. */
+   uint8_t *cpu;
+   uint64_t bytes;
+   int64_t physical;
+   /* The window granules it uses, if in_window. */
+   uint32_t granule;
+   uint32_t granules;
+   bool in_window;
+};
+
+/* Sets up the process-wide state once; false if that failed. */
+bool radv_ps4_platform_init(void);
+
+bool radv_ps4_platform_is_neo(void);
+
+/* The high 32 bits of the addresses in the window. */
+uint32_t radv_ps4_address32_hi(void);
+
+/* The tess factor ring the VGT reads, or 0 if it could not be mapped. */
+uint64_t radv_ps4_tess_factor_ring_va(void);
+
+bool radv_ps4_memory_alloc(uint64_t bytes, uint64_t alignment, bool window32, enum radv_ps4_memory_type type,
+                           struct radv_ps4_memory *out);
+void radv_ps4_memory_free(struct radv_ps4_memory *memory);
+
+/* Maps the memory again for the CPU at address (VK_EXT_map_memory_placed), and unmaps it, leaving
+ * the range reserved if reserve is set.
+ */
+bool radv_ps4_memory_map_at(const struct radv_ps4_memory *memory, void *address);
+void radv_ps4_memory_unmap_at(void *address, uint64_t bytes, bool reserve);
+
+/* Whether the whole range is mapped for GPU read and write, so that it can be imported. */
+bool radv_ps4_memory_gpu_mapped(const void *address, uint64_t bytes);
+
+/* The direct memory pool, and how much of it is free. */
+uint64_t radv_ps4_memory_pool_bytes(void);
+uint64_t radv_ps4_memory_available_bytes(void);
+
+/* Drains write-combined stores, so that the GPU sees them. */
+static inline void
+radv_ps4_cpu_flush(void)
+{
+   __builtin_ia32_sfence();
+}
+
+/* Submits count words (in garlic memory) as one DCB, followed by sceGnmSubmitDone. */
+int radv_ps4_submit(uint32_t *words, uint32_t count);
+
+#endif /* RADV_PS4_PLATFORM_H */
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_sync.c b/src/amd/vulkan/winsys/ps4/radv_ps4_sync.c
new file mode 100644
index 0000000..d4ea5f7
--- /dev/null
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_sync.c
@@ -0,0 +1,209 @@
+/*
+ * Copyright © 2026 Mihawk
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "radv_ps4_winsys.h"
+
+#include "util/os_time.h"
+#include "vk_sync.h"
+
+/* A binary sync object on the one queue, signalled by the submission that carries it (once the
+ * GPU has finished that sequence number) or by the host. Submissions run in order, so a
+ * submission that waits for a sync signalled by an earlier one only needs that signal to have
+ * been submitted. The state is protected by the queue's sync lock.
+ */
+struct radv_ps4_sync {
+   struct vk_sync base;
+   /* A signal has been submitted, or made by the host. */
+   bool pending;
+   /* Signalled once the GPU has finished this sequence number (0: already). */
+   uint64_t seq;
+};
+
+static inline struct radv_ps4_sync *
+radv_ps4_sync(struct vk_sync *sync)
+{
+   return container_of(sync, struct radv_ps4_sync, base);
+}
+
+static VkResult
+radv_ps4_sync_init(struct vk_device *device, struct vk_sync *vk_sync, uint64_t initial_value)
+{
+   struct radv_ps4_sync *sync = radv_ps4_sync(vk_sync);
+   sync->pending = initial_value != 0;
+   sync->seq = 0;
+   return VK_SUCCESS;
+}
+
+static void
+radv_ps4_sync_finish(struct vk_device *device, struct vk_sync *vk_sync)
+{
+}
+
+static void
+radv_ps4_sync_set(struct radv_ps4_sync *sync, bool pending)
+{
+   struct radv_ps4_queue *queue = radv_ps4_queue_get();
+   mtx_lock(&queue->sync_lock);
+   sync->pending = pending;
+   sync->seq = 0;
+   if (pending)
+      cnd_broadcast(&queue->sync_cond);
+   mtx_unlock(&queue->sync_lock);
+}
+
+static VkResult
+radv_ps4_sync_signal(struct vk_device *device, struct vk_sync *vk_sync, uint64_t value)
+{
+   radv_ps4_sync_set(radv_ps4_sync(vk_sync), true);
+   return VK_SUCCESS;
+}
+
+static VkResult
+radv_ps4_sync_reset(struct vk_device *device, struct vk_sync *vk_sync)
+{
+   radv_ps4_sync_set(radv_ps4_sync(vk_sync), false);
+   return VK_SUCCESS;
+}
+
+static VkResult
+radv_ps4_sync_move(struct vk_device *device, struct vk_sync *dst, struct vk_sync *src)
+{
+   struct radv_ps4_queue *queue = radv_ps4_queue_get();
+   struct radv_ps4_sync *d = radv_ps4_sync(dst), *s = radv_ps4_sync(src);
+
+   mtx_lock(&queue->sync_lock);
+   d->pending = s->pending;
+   d->seq = s->seq;
+   s->pending = false;
+   s->seq = 0;
+   if (d->pending)
+      cnd_broadcast(&queue->sync_cond);
+   mtx_unlock(&queue->sync_lock);
+   return VK_SUCCESS;
+}
+
+static bool
+radv_ps4_sync_ready(struct radv_ps4_queue *queue, const struct radv_ps4_sync *sync, enum vk_sync_wait_flags flags)
+{
+   if (!sync->pending)
+      return false;
+   if (flags & VK_SYNC_WAIT_PENDING)
+      return true;
+   return sync->seq == 0 || radv_ps4_queue_poll(queue) >= sync->seq;
+}
+
+static VkResult
+radv_ps4_sync_wait_many(struct vk_device *device, uint32_t wait_count, const struct vk_sync_wait *waits,
+                        enum vk_sync_wait_flags flags, uint64_t abs_timeout_ns)
+{
+   struct radv_ps4_queue *queue = radv_ps4_queue_get();
+   const bool any = flags & VK_SYNC_WAIT_ANY;
+
+   mtx_lock(&queue->sync_lock);
+   for (;;) {
+      uint32_t ready = 0;
+      /* The latest sequence number a submitted but unfinished wait needs. */
+      uint64_t need = 0;
+      bool all_pending = true;
+      for (uint32_t i = 0; i < wait_count; i++) {
+         const struct radv_ps4_sync *sync = radv_ps4_sync(waits[i].sync);
+         if (radv_ps4_sync_ready(queue, sync, flags))
+            ready++;
+         else if (sync->pending)
+            need = MAX2(need, sync->seq);
+         else
+            all_pending = false;
+      }
+      if (any ? ready > 0 || wait_count == 0 : ready == wait_count) {
+         mtx_unlock(&queue->sync_lock);
+         return VK_SUCCESS;
+      }
+
+      const uint64_t now = os_time_get_nano();
+      if (now >= abs_timeout_ns) {
+         mtx_unlock(&queue->sync_lock);
+         return VK_TIMEOUT;
+      }
+
+      if (all_pending && need != 0) {
+         /* Everything has been submitted: wait for the GPU. */
+         mtx_unlock(&queue->sync_lock);
+         if (any)
+            os_time_sleep(100);
+         else if (!radv_ps4_queue_wait_seq(queue, need, abs_timeout_ns))
+            return os_time_get_nano() >= abs_timeout_ns ? VK_TIMEOUT : VK_ERROR_DEVICE_LOST;
+         mtx_lock(&queue->sync_lock);
+         continue;
+      }
+
+      /* Wait for a signal to be submitted, polling running work every millisecond. */
+      const uint64_t wake = MIN2(abs_timeout_ns, now + 1000000);
+      const struct timespec until = {.tv_sec = wake / 1000000000, .tv_nsec = wake % 1000000000};
+      cnd_timedwait(&queue->sync_cond, &queue->sync_lock, &until);
+   }
+}
+
+const struct vk_sync_type radv_ps4_sync_type = {
+   .size = sizeof(struct radv_ps4_sync),
+   .features = VK_SYNC_FEATURE_BINARY | VK_SYNC_FEATURE_GPU_WAIT | VK_SYNC_FEATURE_GPU_MULTI_WAIT |
+               VK_SYNC_FEATURE_CPU_WAIT | VK_SYNC_FEATURE_CPU_RESET | VK_SYNC_FEATURE_CPU_SIGNAL |
+               VK_SYNC_FEATURE_WAIT_ANY | VK_SYNC_FEATURE_WAIT_PENDING,
+   .init = radv_ps4_sync_init,
+   .finish = radv_ps4_sync_finish,
+   .signal = radv_ps4_sync_signal,
+   .reset = radv_ps4_sync_reset,
+   .move = radv_ps4_sync_move,
+   .wait_many = radv_ps4_sync_wait_many,
+};
+
+VkResult
+radv_ps4_sync_wait_submitted(uint32_t wait_count, const struct vk_sync_wait *waits, uint64_t *seq)
+{
+   *seq = 0;
+   if (wait_count == 0)
+      return VK_SUCCESS;
+
+   VkResult result = radv_ps4_sync_wait_many(NULL, wait_count, waits, VK_SYNC_WAIT_PENDING, OS_TIMEOUT_INFINITE);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct radv_ps4_queue *queue = radv_ps4_queue_get();
+   mtx_lock(&queue->sync_lock);
+   for (uint32_t i = 0; i < wait_count; i++)
+      *seq = MAX2(*seq, radv_ps4_sync(waits[i].sync)->seq);
+   mtx_unlock(&queue->sync_lock);
+   return VK_SUCCESS;
+}
+
+void
+radv_ps4_sync_signal_seq(uint32_t signal_count, const struct vk_sync_signal *signals, uint64_t seq)
+{
+   if (signal_count == 0)
+      return;
+
+   struct radv_ps4_queue *queue = radv_ps4_queue_get();
+   mtx_lock(&queue->sync_lock);
+   for (uint32_t i = 0; i < signal_count; i++) {
+      struct radv_ps4_sync *sync = radv_ps4_sync(signals[i].sync);
+      sync->pending = true;
+      sync->seq = seq;
+   }
+   cnd_broadcast(&queue->sync_cond);
+   mtx_unlock(&queue->sync_lock);
+}
+
+VkResult
+radv_ps4_sync_copy_payloads(struct vk_device *device, uint32_t wait_count, const struct vk_sync_wait *waits,
+                            uint32_t signal_count, const struct vk_sync_signal *signals)
+{
+   uint64_t seq = 0;
+   VkResult result = radv_ps4_sync_wait_submitted(wait_count, waits, &seq);
+   if (result != VK_SUCCESS)
+      return result;
+   radv_ps4_sync_signal_seq(signal_count, signals, seq);
+   return VK_SUCCESS;
+}
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
new file mode 100644
index 0000000..50aa85e
--- /dev/null
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
@@ -0,0 +1,529 @@
+/*
+ * Copyright © 2026 Mihawk
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "radv_ps4_winsys.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "addrlib/inc/addrtypes.h"
+#include "addrlib/src/amdgpu_asic_addr.h"
+#include "tools/radv_debug.h"
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+#include "util/u_math.h"
+#include "ac_linux_drm.h"
+#include "sid.h"
+
+/* ----------------------------------------------------------------------------------- queue */
+
+static struct radv_ps4_queue radv_ps4_queue_storage;
+static struct radv_ps4_queue *radv_ps4_queue_instance;
+static once_flag radv_ps4_queue_once = ONCE_FLAG_INIT;
+
+static void
+radv_ps4_queue_create(void)
+{
+   struct radv_ps4_queue *queue = &radv_ps4_queue_storage;
+
+   if (!radv_ps4_platform_init())
+      return;
+
+   if (!radv_ps4_memory_alloc(RADV_PS4_RING_BYTES, RADV_PS4_LARGE_BYTES, false, RADV_PS4_MEMORY_GARLIC,
+                              &queue->ring))
+      return;
+
+   if (!radv_ps4_memory_alloc(RADV_PS4_PAGE_BYTES, RADV_PS4_PAGE_BYTES, false, RADV_PS4_MEMORY_GARLIC,
+                              &queue->marker_memory)) {
+      radv_ps4_memory_free(&queue->ring);
+      return;
+   }
+
+   queue->marker = (volatile uint32_t *)queue->marker_memory.cpu;
+   *queue->marker = 0;
+   radv_ps4_cpu_flush();
+   simple_mtx_init(&queue->submit_lock, mtx_plain);
+   mtx_init(&queue->sync_lock, mtx_plain);
+   cnd_init(&queue->sync_cond);
+   simple_mtx_init(&queue->release_lock, mtx_plain);
+   util_dynarray_init(&queue->releases, NULL);
+
+   radv_ps4_queue_instance = queue;
+}
+
+struct radv_ps4_queue *
+radv_ps4_queue_get(void)
+{
+   call_once(&radv_ps4_queue_once, radv_ps4_queue_create);
+   return radv_ps4_queue_instance;
+}
+
+uint64_t
+radv_ps4_queue_poll(struct radv_ps4_queue *queue)
+{
+   const uint64_t submitted = p_atomic_read(&queue->submitted_seq);
+   const uint32_t marker = *queue->marker;
+   /* The latest sequence number with the marker's low bits that is not past the submitted one. */
+   const uint64_t completed = submitted - (uint32_t)((uint32_t)submitted - marker);
+   uint64_t known = p_atomic_read(&queue->completed_seq);
+
+   while (completed > known) {
+      const uint64_t seen = p_atomic_cmpxchg(&queue->completed_seq, known, completed);
+      if (seen == known)
+         return completed;
+      known = seen;
+   }
+   return known;
+}
+
+/* No progress for this long means the GPU hung. */
+#define RADV_PS4_STALL_NS (UINT64_C(10) * 1000000000)
+/* Spin this long before sleeping between polls. */
+#define RADV_PS4_SPIN_NS UINT64_C(1500000)
+
+bool
+radv_ps4_queue_wait_seq(struct radv_ps4_queue *queue, uint64_t seq, uint64_t abs_timeout_ns)
+{
+   uint64_t completed = radv_ps4_queue_poll(queue);
+   if (completed >= seq)
+      return true;
+
+   uint64_t now = os_time_get_nano();
+   const uint64_t spin_until = now + RADV_PS4_SPIN_NS;
+   uint64_t progress_at = now;
+   uint64_t last = completed;
+
+   for (;;) {
+      completed = radv_ps4_queue_poll(queue);
+      if (completed >= seq)
+         return true;
+
+      now = os_time_get_nano();
+      if (now >= abs_timeout_ns)
+         return false;
+
+      if (completed != last) {
+         last = completed;
+         progress_at = now;
+      } else if (now - progress_at > RADV_PS4_STALL_NS) {
+         fprintf(stderr, "radv/ps4: GPU hang: submission %" PRIu64 " not reached (at %" PRIu64 ")\n", seq,
+                 completed);
+         return false;
+      }
+
+      if (now < spin_until)
+         __builtin_ia32_pause();
+      else
+         os_time_sleep(1000);
+   }
+}
+
+void
+radv_ps4_queue_release(struct radv_ps4_queue *queue, struct radv_ps4_memory *memory)
+{
+   simple_mtx_lock(&queue->release_lock);
+
+   const uint64_t seq = p_atomic_read(&queue->submitted_seq);
+   if (radv_ps4_queue_poll(queue) >= seq && !util_dynarray_num_elements(&queue->releases, struct radv_ps4_release)) {
+      simple_mtx_unlock(&queue->release_lock);
+      radv_ps4_memory_free(memory);
+      return;
+   }
+
+   struct radv_ps4_release *release = util_dynarray_grow(&queue->releases, struct radv_ps4_release, 1);
+   if (!release) {
+      simple_mtx_unlock(&queue->release_lock);
+      radv_ps4_queue_wait_seq(queue, seq, OS_TIMEOUT_INFINITE);
+      radv_ps4_memory_free(memory);
+      return;
+   }
+   *release = (struct radv_ps4_release){.seq = seq, .memory = *memory};
+   simple_mtx_unlock(&queue->release_lock);
+
+   radv_ps4_queue_release_retired(queue, false);
+}
+
+bool
+radv_ps4_queue_release_retired(struct radv_ps4_queue *queue, bool wait)
+{
+   simple_mtx_lock(&queue->release_lock);
+
+   struct radv_ps4_release *releases = queue->releases.data;
+   const unsigned count = util_dynarray_num_elements(&queue->releases, struct radv_ps4_release);
+   if (!count) {
+      simple_mtx_unlock(&queue->release_lock);
+      return false;
+   }
+
+   if (wait)
+      radv_ps4_queue_wait_seq(queue, releases[count - 1].seq, OS_TIMEOUT_INFINITE);
+
+   const uint64_t completed = radv_ps4_queue_poll(queue);
+   unsigned freed = 0;
+   while (freed < count && releases[freed].seq <= completed) {
+      radv_ps4_memory_free(&releases[freed].memory);
+      freed++;
+   }
+   if (freed) {
+      memmove(releases, releases + freed, (size_t)(count - freed) * sizeof(*releases));
+      queue->releases.size -= freed * sizeof(*releases);
+   }
+
+   simple_mtx_unlock(&queue->release_lock);
+   return freed != 0;
+}
+
+/* ------------------------------------------------------------------------------------- GPU */
+
+/* NUM_PIPES 8, PIPE_INTERLEAVE_SIZE 256 B, BANK_INTERLEAVE_SIZE 1, NUM_SHADER_ENGINES 2,
+ * SHADER_ENGINE_TILE_SIZE 32, NUM_GPUS 1, MULTI_GPU_TILE_SIZE 2, ROW_SIZE 1 KiB.
+ */
