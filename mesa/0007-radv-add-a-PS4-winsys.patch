diff --git a/src/vulkan/util/vk_exports_gen.py b/src/vulkan/util/vk_exports_gen.py
new file mode 100644
index 0000000..b6ec2f3
--- /dev/null
+++ b/src/vulkan/util/vk_exports_gen.py
@@ -0,0 +1,126 @@
+# Copyright © 2026 John Törnblom
+# SPDX-License-Identifier: MIT
+"""Generate the vk* functions the Khronos loader exports, for a driver that is
+its own libvulkan (the PS4 has no loader).
+
+Each function forwards through the dispatch table of the object behind its
+first handle; global commands go through vk_icdGetInstanceProcAddr(NULL, ...).
+The core API and the WSI extensions the loader exports without a window system
+are exported; anything else is reached through vkGet*ProcAddr.
+"""
+
+import argparse
+import os
+import sys
+
+from mako.template import Template
+
+sys.path.append(os.path.dirname(__file__))
+from vk_entrypoints import get_entrypoints_from_xml  # noqa: E402
+
+EXPORTED_EXTENSIONS = {
+    'VK_KHR_surface',
+    'VK_KHR_swapchain',
+    'VK_KHR_display',
+    'VK_KHR_display_swapchain',
+}
+
+TEMPLATE = Template("""\
+/* This file generated from ${filename}, don't edit directly. */
+
+#include "vk_command_buffer.h"
+#include "vk_device.h"
+#include "vk_instance.h"
+#include "vk_physical_device.h"
+#include "vk_queue.h"
+
+#include "util/macros.h"
+#include "util/u_atomic.h"
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vk_icdGetInstanceProcAddr(VkInstance instance, const char *pName);
+
+static PFN_vkVoidFunction
+vk_exports_global(const char *name, PFN_vkVoidFunction *cache)
+{
+   PFN_vkVoidFunction func = p_atomic_read(cache);
+   if (func == NULL) {
+      func = vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, name);
+      p_atomic_set(cache, func);
+   }
+   return func;
+}
+
+PUBLIC VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vkGetInstanceProcAddr(VkInstance instance, const char *pName)
+{
+   return vk_icdGetInstanceProcAddr(instance, pName);
+}
+
+% for e in entrypoints:
+<% ret = '' if e.return_type == 'void' else 'return ' %>
+PUBLIC VKAPI_ATTR ${e.return_type} VKAPI_CALL
+vk${e.name}(${e.decl_params()})
+{
+  % if e.kind == 'global':
+   static PFN_vkVoidFunction cache;
+   PFN_vk${e.name} func = (PFN_vk${e.name})vk_exports_global("vk${e.name}", &cache);
+   ${ret}func(${e.call_params()});
+  % else:
+    % if e.name in ('DestroyInstance', 'DestroyDevice'):
+   /* vkDestroyInstance/vkDestroyDevice(VK_NULL_HANDLE) do nothing. */
+   if (${e.params[0].name} == VK_NULL_HANDLE)
+      return;
+    % endif
+   ${ret}${e.table}.${e.table_name}(${e.call_params()});
+  % endif
+}
+% endfor
+""")
+
+TABLES = {
+    'VkInstance': 'vk_instance_from_handle({0})->dispatch_table',
+    'VkPhysicalDevice': 'vk_physical_device_from_handle({0})->dispatch_table',
+    'VkDevice': 'vk_device_from_handle({0})->dispatch_table',
+    'VkQueue': 'vk_queue_from_handle({0})->base.device->dispatch_table',
+    'VkCommandBuffer': 'vk_command_buffer_from_handle({0})->base.device->dispatch_table',
+}
+
+
+def ext_name(ext):
+    return getattr(ext, 'name', ext)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--xml', required=True, action='append', dest='xml_files')
+    parser.add_argument('--out-c', required=True)
+    args = parser.parse_args()
+
+    entrypoints = []
+    for e in get_entrypoints_from_xml(args.xml_files, beta=False):
+        if e.guard is not None:
+            continue
+        exts = {ext_name(x) for x in e.extensions}
+        if e.core_version is None and not (exts & EXPORTED_EXTENSIONS):
+            continue
+        if e.name in ('GetInstanceProcAddr',):
+            continue
+
+        first = e.params[0].type
+        if first in TABLES:
+            e.kind = 'dispatch'
+            e.table = TABLES[first].format(e.params[0].name)
+            # Aliases share a union member with the function they alias.
+            e.table_name = e.alias.name if e.alias else e.name
+        else:
+            e.kind = 'global'
+        entrypoints.append(e)
+
+    with open(args.out_c, 'w', encoding='utf-8') as f:
+        f.write(TEMPLATE.render(entrypoints=entrypoints,
+                                filename=os.path.basename(__file__)))
+
+
+if __name__ == '__main__':
+    main()
