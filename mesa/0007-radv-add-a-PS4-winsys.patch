+   0x00000308, /*  9: display 1D thin */
+   0x02000310, /* 10: display 2D thin */
+   0x02000294, /* 11: display thin PRT */
+   0x02000318, /* 12: display 2D thin PRT */
+   0x00400308, /* 13: thin 1D thin */
