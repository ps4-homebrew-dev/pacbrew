+
+/* ------------------------------------------------------------- submission */
+
+/* The completion packet: one EVENT_WRITE_EOP of CACHE_FLUSH_AND_INV_TS_EVENT
+ * (event 20, index 5) that flushes the colour and depth caches, writes back
+ * and invalidates L2 and the vector L1 caches, and only then writes the
+ * sequence number's low 32 bits -- the packet the amdgpu kernel's GFX7 fences
+ * are (gfx_v7_0_ring_emit_fence_gfx), and the one the gnm_submit sample waits
+ * on. */
+
+/* RADV_PS4_TRACE writes a tag to the queue's trace slot with WRITE_DATA (which
+ * the gnm_submit sample runs on the console) at the boundaries of a submission
+ * -- after the preamble, after the streams -- so that, when the GPU hangs
+ * inside a frame, the slot tells how far the CP got: nothing (preamble
+ * wedged), the preamble's tag (a draw wedged) or the streams' tag (the trailing
+ * flush or the fence). Only a submission that fits one DCB is traced. */
+#define RADV_PS4_WRITEDATA_WORDS 5
+
+static bool
+radv_ps4_cs_trace_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = getenv("RADV_PS4_TRACE") != NULL;
+   return enabled;
+}
+
+static void
+radv_ps4_writedata_words(uint32_t *words, uint64_t address, uint32_t value)
+{
+   /* WRITE_DATA from the ME to memory, confirmed written, as gnm_submit's. */
+   words[0] = PKT3(PKT3_WRITE_DATA, 3, 0);
+   words[1] = (5u << 8) | (1u << 20);
+   words[2] = (uint32_t)address;
+   words[3] = (uint32_t)(address >> 32);
+   words[4] = value;
+}
+
+void
+radv_ps4_completion_words(uint32_t *words, uint64_t marker_address, uint32_t value)
+{
+   words[0] = PKT3(PKT3_EVENT_WRITE_EOP, 4, 0);
+   words[1] = EVENT_TCL1_ACTION_ENA | EVENT_TC_ACTION_ENA | EVENT_TYPE(V_028A90_CACHE_FLUSH_AND_INV_TS_EVENT) |
+              EVENT_INDEX(5);
+   words[2] = (uint32_t)marker_address;
+   words[3] = ((uint32_t)(marker_address >> 32) & 0xffff) | EOP_DATA_SEL(EOP_DATA_SEL_VALUE_32BIT) |
+              EOP_INT_SEL(EOP_INT_SEL_NONE);
+   words[4] = value;
+   words[5] = 0;
+}
+
+/* The GPU clock, as a timestamp query reads it: an EVENT_WRITE_EOP that writes
+ * the 64-bit counter at the bottom of the pipe, submitted alone and waited
+ * for. It lands after whatever the queue still runs, which the caller's CPU
+ * clock readings around it (vkGetCalibratedTimestampsKHR's deviation)
+ * include. The packet and its value live in the marker's page, past the
+ * marker. */
+#define RADV_PS4_CLOCK_WORDS_OFFSET 1024
+#define RADV_PS4_CLOCK_VALUE_OFFSET 2048
+
+uint64_t
+radv_ps4_read_gpu_clock(void)
+{
+   /* The model runs no GPU: its clock is the host's, at the counter's rate
+    * (radv_ps4_describe_gpu). */
+   if (!radv_ps4_platform_runs_gpu())
+      return (uint64_t)os_time_get_nano() / 10;
+   struct radv_ps4_queue *const queue = radv_ps4_queue_get();
+   if (!queue)
+      return 0;
+   uint8_t *const page = (uint8_t *)queue->marker_memory.cpu;
+   uint32_t *const words = (uint32_t *)(page + RADV_PS4_CLOCK_WORDS_OFFSET);
+   volatile uint64_t *const value = (volatile uint64_t *)(page + RADV_PS4_CLOCK_VALUE_OFFSET);
+   const uint64_t va = (uint64_t)(uintptr_t)value;
+
+   simple_mtx_lock(&queue->submit_lock);
+   *value = UINT64_MAX;
+   radv_ps4_cpu_flush((const void *)value, sizeof(*value));
+   words[0] = PKT3(PKT3_EVENT_WRITE_EOP, 4, 0);
+   words[1] = EVENT_TYPE(V_028A90_BOTTOM_OF_PIPE_TS) | EVENT_INDEX(5);
+   words[2] = (uint32_t)va;
+   words[3] = ((uint32_t)(va >> 32) & 0xffff) | EOP_DATA_SEL(EOP_DATA_SEL_TIMESTAMP);
+   words[4] = 0;
+   words[5] = 0;
+   uint64_t clock = 0;
+   if (radv_ps4_submit(words, 6, NULL, 0) == 0) {
+      const int64_t deadline = os_time_get_nano() + INT64_C(1000000000);
+      do {
+         radv_ps4_cpu_flush((const void *)value, sizeof(*value));
+         clock = *value;
+      } while (clock == UINT64_MAX && os_time_get_nano() < deadline);
+      if (clock == UINT64_MAX)
+         clock = 0;
+   }
+   simple_mtx_unlock(&queue->submit_lock);
+   return clock;
+}
+
+/* Forgets the ring records the GPU has finished with. Called with the submit
+ * lock held. */
+static void
+radv_ps4_queue_retire(struct radv_ps4_queue *queue)
+{
+   const uint64_t completed = radv_ps4_queue_poll(queue);
+   while (queue->in_flight_count) {
+      struct radv_ps4_in_flight *const oldest = &queue->in_flight[queue->in_flight_first];
+      if (oldest->seq > completed)
+         break;
+      radv_ps4_memory_free(&oldest->dedicated);
+      queue->in_flight_first = (queue->in_flight_first + 1) % RADV_PS4_MAX_IN_FLIGHT;
+      queue->in_flight_count--;
+   }
+}
+
+/* Words for a submission of count words: a ring range the GPU no longer reads,
+ * or a buffer of its own for one too large for the ring. Called with the submit
+ * lock held; records the claim for seq. */
+static uint32_t *
+radv_ps4_queue_claim(struct radv_ps4_queue *queue, uint32_t count, uint64_t seq)
+{
+   radv_ps4_queue_retire(queue);
+   while (queue->in_flight_count == RADV_PS4_MAX_IN_FLIGHT) {
+      const uint64_t oldest = queue->in_flight[queue->in_flight_first].seq;
+      if (!radv_ps4_queue_wait_seq(queue, oldest, OS_TIMEOUT_INFINITE))
+         return NULL;
+      radv_ps4_queue_retire(queue);
+   }
+   struct radv_ps4_in_flight *const claim =
+      &queue->in_flight[(queue->in_flight_first + queue->in_flight_count) % RADV_PS4_MAX_IN_FLIGHT];
+   *claim = (struct radv_ps4_in_flight){.seq = seq, .dedicated = {.physical = -1}};
+
+   if (count > RADV_PS4_RING_WORDS / 2) {
+      if (!radv_ps4_memory_alloc((uint64_t)count * 4, RADV_PS4_LARGE_BYTES, false, RADV_PS4_MEMORY_GARLIC,
+                                 &claim->dedicated))
+         return NULL;
+      queue->in_flight_count++;
+      return (uint32_t *)claim->dedicated.cpu;
+   }
+
+   /* Streams start on a 64-byte line and follow one another round the ring. */
+   uint32_t start = align(queue->ring_head, 16);
+   if (start + count > RADV_PS4_RING_WORDS)
+      start = 0;
+   const uint32_t end = start + count;
+   /* Wait for every earlier stream still in the range to be run. */
+   for (uint32_t i = 0; i < queue->in_flight_count; i++) {
+      const struct radv_ps4_in_flight *const record =
+         &queue->in_flight[(queue->in_flight_first + i) % RADV_PS4_MAX_IN_FLIGHT];
+      if (record->dedicated.cpu || record->end <= start || end <= record->start)
+         continue;
+      if (!radv_ps4_queue_wait_seq(queue, record->seq, OS_TIMEOUT_INFINITE))
+         return NULL;
+   }
+   radv_ps4_queue_retire(queue);
+   claim->start = start;
+   claim->end = end;
+   /* The claim is recorded after the retire, which may have moved the first
+    * record; rebuild it in place at the end of the list. */
+   struct radv_ps4_in_flight *const slot =
+      &queue->in_flight[(queue->in_flight_first + queue->in_flight_count) % RADV_PS4_MAX_IN_FLIGHT];
+   *slot = (struct radv_ps4_in_flight){.seq = seq, .start = start, .end = end, .dedicated = {.physical = -1}};
+   queue->in_flight_count++;
+   queue->ring_head = end;
+   return (uint32_t *)queue->ring.cpu + start;
+}
+
+/* A run of a submission's words that must go to the GPU in one DCB: from a
+ * place the GPU state is the preamble's (a stream's start or a split) to the
+ * next such place. */
+struct radv_ps4_unit {
+   unsigned first_piece;
+   uint32_t words;
+   /* The unit starts a DCB after the first. */
+   bool starts_part;
+};
+
+/* The words of a stream in submission order, as chunks (the current one last). */
+static void
+radv_ps4_stream_pieces(const struct radv_ps4_cs *cs, struct util_dynarray *pieces)
+{
+   util_dynarray_foreach (&cs->chunks, struct radv_ps4_cs_chunk, chunk) {
+      if (chunk->cdw)
+         util_dynarray_append(pieces, *chunk);
+      else if (chunk->starts_submission)
+         util_dynarray_append(pieces, ((struct radv_ps4_cs_chunk){.starts_submission = true}));
+   }
+   util_dynarray_append(pieces, ((struct radv_ps4_cs_chunk){
+                                   .words = cs->base.buf,
+                                   .cdw = cs->base.cdw,
+                                   .max_dw = cs->base.max_dw,
+                                   .starts_submission = cs->buf_starts_submission,
+                                }));
+}
+
+static uint32_t
+radv_ps4_count_streams(struct ac_cmdbuf **streams, unsigned count)
+{
+   uint32_t words = 0;
+   for (unsigned i = 0; i < count; i++)
+      words += radv_ps4_cs_words(radv_ps4_cs(streams[i]));
+   return words;
+}
+
+static uint32_t *
+radv_ps4_copy_streams(uint32_t *at, struct ac_cmdbuf **streams, unsigned count)
+{
+   for (unsigned i = 0; i < count; i++) {
+      const struct radv_ps4_cs *const cs = radv_ps4_cs(streams[i]);
+      util_dynarray_foreach (&cs->chunks, struct radv_ps4_cs_chunk, chunk) {
+         memcpy(at, chunk->words, (size_t)chunk->cdw * sizeof(uint32_t));
+         at += chunk->cdw;
+      }
+      memcpy(at, cs->base.buf, (size_t)cs->base.cdw * sizeof(uint32_t));
+      at += cs->base.cdw;
+   }
+   return at;
+}
+
+/* Where the submissions' time goes: a line on stderr every 10 s of a queue
+ * that submits (held with the submit lock). */
+static struct {
+   uint64_t window_start, count, words, claim_ns, copy_ns;
+} radv_ps4_submit_window;
+
+static void
+radv_ps4_note_submission(uint32_t words, uint64_t claim_ns, uint64_t copy_ns)
+{
+   const uint64_t now = os_time_get_nano();
+   if (!radv_ps4_submit_window.window_start)
+      radv_ps4_submit_window.window_start = now;
+   radv_ps4_submit_window.count++;
+   radv_ps4_submit_window.words += words;
+   radv_ps4_submit_window.claim_ns += claim_ns;
+   radv_ps4_submit_window.copy_ns += copy_ns;
+   if (now - radv_ps4_submit_window.window_start < 10ull * 1000 * 1000 * 1000)
+      return;
+   uint64_t times[2];
+   radv_ps4_submit_times(times);
+   fprintf(stderr,
+           "radv/ps4 submissions: window count=%" PRIu64 " kwords=%" PRIu64 " claim_ms=%.1f copy_ms=%.1f"
+           " submit_ms=%.1f done_ms=%.1f\n",
+           radv_ps4_submit_window.count, radv_ps4_submit_window.words / 1024, radv_ps4_submit_window.claim_ns / 1e6,
+           radv_ps4_submit_window.copy_ns / 1e6, times[0] / 1e6, times[1] / 1e6);
+   memset(&radv_ps4_submit_window, 0, sizeof(radv_ps4_submit_window));
+   radv_ps4_submit_window.window_start = now;
+}
+
+static VkResult
+radv_ps4_cs_submit(struct radeon_winsys_ctx *rctx, const struct radv_winsys_submit_info *submit, uint32_t wait_count,
+                   const struct vk_sync_wait *waits, uint32_t signal_count, const struct vk_sync_signal *signals)
+{
+   struct radv_ps4_ctx *const ctx = (struct radv_ps4_ctx *)rctx;
+   struct radv_ps4_queue *const queue = ctx->ws->queue;
+
+   if (submit->ip_type != AMD_IP_GFX)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   for (unsigned i = 0; i < submit->cs_count; i++) {
+      if (radv_ps4_cs(submit->cs_array[i])->status != VK_SUCCESS)
+         return radv_ps4_cs(submit->cs_array[i])->status;
+   }
+
+   /* Waits need only their signals submitted: this queue runs in order. */
+   uint64_t depends = 0;
+   VkResult result = radv_ps4_sync_wait_submitted(wait_count, waits, &depends);
+   if (result != VK_SUCCESS)
+      return result;
+
+   simple_mtx_lock(&queue->submit_lock);
+   if (submit->cs_count == 0) {
+      /* Nothing for the GPU: the signals follow what was submitted before. */
+      const uint64_t last = queue->submitted_seq;
+      simple_mtx_unlock(&queue->submit_lock);
+      radv_ps4_sync_signal_seq(signal_count, signals, MAX2(last, depends));
+      return VK_SUCCESS;
+   }
+
+   /* The initial preambles (every submission starts from the state they set,
+    * as each amdgpu submission does), the streams, the postambles, then the
+    * completion. The streams and postambles are cut into units; units go
+    * into one DCB as long as they fit, and each further DCB starts with the
+    * preambles again. */
+   const uint32_t preamble_words = radv_ps4_count_streams(submit->initial_preamble_cs, submit->initial_preamble_count);
+   struct util_dynarray pieces, units;
+   util_dynarray_init(&pieces, NULL);
+   util_dynarray_init(&units, NULL);
+   for (unsigned i = 0; i < submit->cs_count + submit->postamble_count; i++) {
+      struct ac_cmdbuf *const stream =
+         i < submit->cs_count ? submit->cs_array[i] : submit->postamble_cs[i - submit->cs_count];
+      const unsigned first = util_dynarray_num_elements(&pieces, struct radv_ps4_cs_chunk);
+      radv_ps4_stream_pieces(radv_ps4_cs(stream), &pieces);
+      const unsigned end = util_dynarray_num_elements(&pieces, struct radv_ps4_cs_chunk);
+      for (unsigned p = first; p < end; p++) {
+         struct radv_ps4_cs_chunk *const piece = util_dynarray_element(&pieces, struct radv_ps4_cs_chunk, p);
+         if (p == first || piece->starts_submission)
+            util_dynarray_append(&units, ((struct radv_ps4_unit){.first_piece = p}));
+         util_dynarray_last_ptr(&units, struct radv_ps4_unit)->words += piece->cdw;
+      }
+   }
+
+   /* Plan: which unit starts each DCB, and the words in all. */
+   const unsigned unit_count = util_dynarray_num_elements(&units, struct radv_ps4_unit);
+   const uint32_t room = RADV_PS4_SUBMIT_MAX_DW - RADV_PS4_COMPLETION_WORDS;
+   uint32_t count = preamble_words + RADV_PS4_COMPLETION_WORDS;
+   uint32_t fill = preamble_words;
+   bool too_large = false;
+   bool multi_part = false;
+   for (unsigned u = 0; u < unit_count; u++) {
+      struct radv_ps4_unit *const unit = util_dynarray_element(&units, struct radv_ps4_unit, u);
+      if (preamble_words + unit->words > room)
+         too_large = true;
+      if (fill > preamble_words && fill + unit->words > room) {
+         unit->starts_part = true;
+         multi_part = true;
+         count += preamble_words;
+         fill = preamble_words;
+      }
+      fill += unit->words;
+      count += unit->words;
+   }
+
+   /* The trace's two WRITE_DATAs, when a single DCB carries the submission. */
+   const uint64_t trace_address = (uint64_t)(uintptr_t)queue->marker_memory.cpu + RADV_PS4_TRACE_OFFSET;
+   const bool trace = radv_ps4_cs_trace_enabled() && !multi_part && !too_large;
+   if (trace)
+      count += 2 * RADV_PS4_WRITEDATA_WORDS;
+
+   const uint64_t seq = queue->submitted_seq + 1;
+   const uint64_t claim_start = os_time_get_nano();
+   uint32_t *const words = too_large ? NULL : radv_ps4_queue_claim(queue, count, seq);
+   const uint64_t copy_start = os_time_get_nano();
+   if (!words) {
+      simple_mtx_unlock(&queue->submit_lock);
+      util_dynarray_fini(&pieces);
+      util_dynarray_fini(&units);
+      if (too_large)
+         fprintf(stderr, "radv/ps4: a submission holds more words between two splits than one DCB can\n");
+      return VK_ERROR_DEVICE_LOST;
+   }
+
+   struct util_dynarray starts;
+   util_dynarray_init(&starts, NULL);
+   util_dynarray_append(&starts, 0u);
+   uint32_t *at = radv_ps4_copy_streams(words, submit->initial_preamble_cs, submit->initial_preamble_count);
+   if (trace) {
+      radv_ps4_writedata_words(at, trace_address, (uint32_t)(seq * 4 + 1));
+      at += RADV_PS4_WRITEDATA_WORDS;
+   }
+   for (unsigned u = 0; u < unit_count; u++) {
+      const struct radv_ps4_unit *const unit = util_dynarray_element(&units, struct radv_ps4_unit, u);
+      if (unit->starts_part) {
+         util_dynarray_append(&starts, (uint32_t)(at - words));
+         at = radv_ps4_copy_streams(at, submit->initial_preamble_cs, submit->initial_preamble_count);
+      }
+      const unsigned end = u + 1 < unit_count ? util_dynarray_element(&units, struct radv_ps4_unit, u + 1)->first_piece
+                                              : util_dynarray_num_elements(&pieces, struct radv_ps4_cs_chunk);
+      for (unsigned p = unit->first_piece; p < end; p++) {
+         const struct radv_ps4_cs_chunk *const piece = util_dynarray_element(&pieces, struct radv_ps4_cs_chunk, p);
+         memcpy(at, piece->words, (size_t)piece->cdw * sizeof(uint32_t));
+         at += piece->cdw;
+      }
+   }
+   if (trace) {
+      radv_ps4_writedata_words(at, trace_address, (uint32_t)(seq * 4 + 2));
+      at += RADV_PS4_WRITEDATA_WORDS;
+   }
+   radv_ps4_completion_words(at, (uint64_t)(uintptr_t)queue->marker, (uint32_t)seq);
+   at += RADV_PS4_COMPLETION_WORDS;
+   assert((uint32_t)(at - words) == count);
+   util_dynarray_fini(&pieces);
+   util_dynarray_fini(&units);
+
+   const uint64_t copy_end = os_time_get_nano();
+   p_atomic_set(&queue->submitted_seq, seq);
+   int submitted = 0;
+   const unsigned parts = util_dynarray_num_elements(&starts, uint32_t);
+   for (unsigned i = 0; i < parts && submitted == 0; i++) {
+      const uint32_t start = *util_dynarray_element(&starts, uint32_t, i);
+      const uint32_t end = i + 1 < parts ? *util_dynarray_element(&starts, uint32_t, i + 1) : count;
+      submitted = radv_ps4_submit(words + start, end - start, queue->marker, (uint32_t)seq);
+   }
+   util_dynarray_fini(&starts);
+   radv_ps4_note_submission(count, copy_start - claim_start, copy_end - copy_start);
+   simple_mtx_unlock(&queue->submit_lock);
+   if (submitted != 0) {
+      fprintf(stderr, "radv/ps4: sceGnmSubmitCommandBuffers failed: 0x%08x\n", (unsigned)submitted);
+      return VK_ERROR_DEVICE_LOST;
+   }
+   ctx->queue_used[submit->ip_type][submit->queue_index] = true;
+   radv_ps4_sync_signal_seq(signal_count, signals, seq);
+   return VK_SUCCESS;
+}
+
+void
+radv_ps4_cs_init_functions(struct radv_ps4_winsys *ws)
+{
+   ws->base.cs_domain = radv_ps4_cs_domain;
+   ws->base.cs_create = radv_ps4_cs_create;
+   ws->base.cs_destroy = radv_ps4_cs_destroy;
+   ws->base.cs_grow = radv_ps4_cs_grow;
+   ws->base.cs_finalize = radv_ps4_cs_finalize;
+   ws->base.cs_reset = radv_ps4_cs_reset;
+   ws->base.cs_chain = radv_ps4_cs_chain;
+   ws->base.cs_unchain = radv_ps4_cs_unchain;
+   ws->base.cs_add_buffer = radv_ps4_cs_add_buffer;
+   ws->base.cs_execute_secondary = radv_ps4_cs_execute_secondary;
+   ws->base.cs_execute_ib = radv_ps4_cs_execute_ib;
+   ws->base.cs_chain_dgc_ib = radv_ps4_cs_chain_dgc_ib;
+   ws->base.cs_submit = radv_ps4_cs_submit;
+   ws->base.cs_dump = radv_ps4_cs_dump;
+   ws->base.cs_annotate = radv_ps4_cs_annotate;
+   ws->base.cs_pad = radv_ps4_cs_pad;
+   ws->base.cs_split_due = radv_ps4_cs_split_due;
+   ws->base.cs_split = radv_ps4_cs_split;
+}
