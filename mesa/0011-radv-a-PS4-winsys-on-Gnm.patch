@@ -0,0 +1,37 @@
+/*
+ * Copyright © 2026 Mihawk
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef RADV_PS4_WINSYS_PUBLIC_H
+#define RADV_PS4_WINSYS_PUBLIC_H
+
+#include "radv_radeon_winsys.h"
+#include "ac_gpu_info.h"
+#include "vk_sync.h"
+
+/* What the physical device learns from the winsys before it exists. */
+struct radeon_winsys_info {
+   struct radeon_info base;
+   struct vk_sync_type syncobj_sync_type;
+   uint32_t global_priority_mask;
+   /* Memory, semaphores and fences can be shared as file descriptors
+    * (opaque fd, sync fd, dma-buf). */
+   bool has_external_fd;
+};
+
+/* The console's GPU: Liverpool, a GFX7 GPU tiled the way the console's own
+ * addressing library tiles memory. Fails when the platform cannot be set up
+ * (radv_ps4_platform_init). */
+VkResult radv_ps4_winsys_query_info(uint64_t debug_flags, struct radeon_winsys_info *info);
+
+VkResult radv_ps4_winsys_create(const struct radeon_info *info, uint64_t debug_flags, uint64_t perftest_flags,
+                                struct radeon_winsys **winsys);
+
+/* The direct-memory pool, what it has left, and what this driver holds of it,
+ * for VK_EXT_memory_budget. */
+void radv_ps4_winsys_heap_usage(uint64_t *pool_bytes, uint64_t *available_bytes, uint64_t *driver_bytes);
+
+#endif /* RADV_PS4_WINSYS_PUBLIC_H */
