index 0000000..abb7bfb
--- /dev/null
+++ b/include/ps4_sce.h
@@ -0,0 +1,136 @@
+/*
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Declarations of the PlayStation 4 system functions RADV's PS4 winsys
+ * (src/amd/vulkan/winsys/ps4) and the VideoOut WSI call. The PS4 homebrew SDK
+ * links them (libkernel, libSceGnmDriver and libSceVideoOut stubs) but its
+ * headers do not declare them, so Mesa carries its own.
+ *
+ * Signatures follow the public PS4 SDK's, as OpenOrbis declares them, and the
+ * forms the console accepted in the SDK's gnm_submit sample. Only built for
+ * the console (__ORBIS__).
+ */
+
+#ifndef PS4_SCE_H
+#define PS4_SCE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ------------------------------------------------------------- libkernel */
+
+#define PS4_KERNEL_PROT_CPU_READ  0x01
+#define PS4_KERNEL_PROT_CPU_WRITE 0x02
+#define PS4_KERNEL_PROT_GPU_READ  0x10
+#define PS4_KERNEL_PROT_GPU_WRITE 0x20
+
+/* MAP_FIXED. */
+#define PS4_KERNEL_MAP_FIXED 0x10
+
+/* Direct memory types: CPU write-back, GPU coherent through the CPU's caches
+ * (onion), and CPU write-combined (garlic). */
+#define PS4_KERNEL_WB_ONION  0
+#define PS4_KERNEL_WC_GARLIC 3
+
+int32_t sceKernelAllocateDirectMemory(int64_t search_start, int64_t search_end, size_t length,
+                                      size_t alignment, int32_t memory_type, int64_t *physical);
+int32_t sceKernelReleaseDirectMemory(int64_t start, size_t length);
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int protection, int flags,
+                                 int64_t physical, size_t alignment);
+int64_t sceKernelGetDirectMemorySize(void);
+int32_t sceKernelAvailableDirectMemorySize(int64_t search_start, int64_t search_end, size_t alignment,
+                                           int64_t *physical, size_t *available);
+int32_t sceKernelReserveVirtualRange(void **address, size_t length, int flags, size_t alignment);
+int32_t sceKernelMunmap(void *address, size_t length);
+
+/* What sceKernelVirtualQuery reports of the mapping at an address (flags 0:
+ * the mapping holding it, or an error where there is none). */
+struct ps4_kernel_virtual_query_info {
+   void *start;
+   void *end;
+   int64_t offset;
+   int32_t protection;
+   int32_t memory_type;
+   uint32_t is_flexible : 1;
+   uint32_t is_direct : 1;
+   uint32_t is_stack : 1;
+   uint32_t is_pooled : 1;
+   uint32_t is_committed : 1;
+   char name[32];
+};
+int32_t sceKernelVirtualQuery(const void *address, int flags, struct ps4_kernel_virtual_query_info *info,
+                              size_t size);
+int32_t sceKernelIsNeoMode(void);
+
+/* ------------------------------------------------------- libSceGnmDriver */
+
+/* Submits count draw command buffers (and as many constant command buffers,
+ * which may be empty), each at most 0x3ffffc bytes, to the graphics ring. */
+int32_t sceGnmSubmitCommandBuffers(uint32_t count, void *dcb_addresses[], uint32_t *dcb_bytes,
+                                   void *ccb_addresses[], uint32_t *ccb_bytes);
+/* Tells the system a frame's submissions are done; a title that submits must
+ * call it regularly. */
+int32_t sceGnmSubmitDone(void);
+
+/* ---------------------------------------------------------- libSceVideoOut */
+
+/* The display (src/vulkan/wsi/wsi_common_videoout.c), as OpenOrbis and the
+ * freegnm examples drive it: opened for the system user on the main bus,
+ * framebuffers registered with their format, tiling and pitch, and flipped at
+ * a vblank. */
+#define PS4_VIDEO_OUT_USER_SYSTEM 0xff
+#define PS4_VIDEO_OUT_BUS_MAIN 0
+/* B8G8R8A8 in memory. */
+#define PS4_VIDEO_OUT_PIXEL_FORMAT_A8R8G8B8_SRGB 0x80000000u
+/* Tiled: the GPU's 2D thin display tiling (GNM_TM_DISPLAY_2D_THIN). */
+#define PS4_VIDEO_OUT_TILING_MODE_TILE 0u
+#define PS4_VIDEO_OUT_ASPECT_RATIO_16_9 0u
+#define PS4_VIDEO_OUT_FLIP_VSYNC 1u
+
+struct ps4_video_out_buffer_attribute {
+   uint32_t pixel_format;
+   uint32_t tiling_mode;
+   uint32_t aspect_ratio;
+   uint32_t width;
+   uint32_t height;
+   uint32_t pitch_in_pixel;
+   uint64_t reserved[2];
+};
+
+struct ps4_video_out_flip_status {
+   uint64_t count;
+   uint64_t process_time;
+   uint64_t tsc;
+   /* The argument of the latest flip shown. */
+   int64_t flip_argument;
+   uint64_t reserved[2];
+   int32_t gpu_flips_pending;
+   int32_t flips_pending;
+   int32_t current_buffer;
+   uint32_t reserved1;
+};
+
+int32_t sceVideoOutOpen(int32_t user, int32_t bus, int32_t index, const void *parameter);
+int32_t sceVideoOutClose(int32_t handle);
+void sceVideoOutSetBufferAttribute(struct ps4_video_out_buffer_attribute *attribute, uint32_t pixel_format,
+                                   uint32_t tiling_mode, uint32_t aspect_ratio, uint32_t width, uint32_t height,
+                                   uint32_t pitch_in_pixel);
+int32_t sceVideoOutRegisterBuffers(int32_t handle, int32_t start, void *const *addresses, int32_t count,
+                                   const struct ps4_video_out_buffer_attribute *attribute);
+int32_t sceVideoOutSetFlipRate(int32_t handle, int32_t rate);
+int32_t sceVideoOutSubmitFlip(int32_t handle, int32_t buffer_index, uint32_t flip_mode, int64_t argument);
+int32_t sceVideoOutGetFlipStatus(int32_t handle, struct ps4_video_out_flip_status *status);
+int32_t sceVideoOutWaitVblank(int32_t handle);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS4_SCE_H */
