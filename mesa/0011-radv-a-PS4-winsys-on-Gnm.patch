+/* ----------------------------------------------------------- the GPU itself */
+
+/* The console's GPU, Liverpool, as the winsys describes it to RADV: in the form
+ * the amdgpu kernel reports a GPU, then completed by ac_gpu_info's own
+ * derivations.
+ *
+ * Liverpool is a Sea Islands (GFX7, GCN 2) GPU, as Bonaire and Hawaii are: the
+ * same shader instructions and register layout, so RADV takes it for a
+ * Bonaire (FAMILY_CI) with Liverpool's units: two shader engines of one shader
+ * array each, 18 compute units in use (9 per array), 8 render backends, 8
+ * memory channels (and so 8 L2 cache slices of 64 KiB), 8 tiling pipes. The
+ * compute units, clocks and memory are the public PS4 figures; the units the
+ * GPU actually enables are not measured yet.
+ *
+ * Tiling follows the console's own GPU addressing library, as freegnm
+ * (https://github.com/lateleite/freegnm, src/gpuaddr/tilemodes.c) records it:
+ * the GB_TILE_MODE and GB_MACROTILE_MODE tables below are its tile modes and
+ * macro tile modes, field by field, and GB_ADDR_CONFIG has its 8 pipes, a
+ * 256-byte pipe interleave and a 1 KiB DRAM row. This is the base PS4's
+ * configuration; the PS4 Pro (NEO) mode tiles otherwise and is not described.
+ */
+
+/* PA_SC_RASTER_CONFIG is the kernel's: Gnm never writes it, and a title's
+ * submissions start from the context CLEAR_STATE gives, which holds it
+ * (radeon_info.has_kernel_raster_config). */
+
+static void
+radv_ps4_describe_gpu(struct radeon_info *info, bool compiler_compat_mode)
+{
+   const struct drm_amdgpu_info_hw_ip gfx_ip = {
+      .hw_ip_version_major = 7,
+      .hw_ip_version_minor = 0,
+      .ib_start_alignment = 32,
+      .ib_size_alignment = 32,
+      .available_rings = 0x1,
+   };
+   struct drm_amdgpu_info_device dev = {
+      .device_id = 0x9920, /* Liverpool's, as the PS4 Linux kernel names it */
+      .chip_rev = 0,
+      .external_rev = RADV_PS4_EXTERNAL_REV,
+      .family = FAMILY_CI,
+      .num_shader_engines = 2,
+      .num_shader_arrays_per_engine = 1,
+      .cu_active_number = 18,
+      .cu_ao_mask = 0x1ff,
+      .cu_bitmap = {{0x1ff}, {0x1ff}},
+      .cu_ao_bitmap = {{0x1ff}, {0x1ff}},
+      .num_cu_per_sh = 9,
+      .enabled_rb_pipes_mask = 0xff,
+      .num_rb_pipes = 8,
+      .num_tcc_blocks = 8,
+      /* The GPU timestamp counter, in kHz; the gnm_submit sample measures it. */
+      .gpu_counter_freq = 100000,
+      .max_engine_clock = UINT64_C(800000),
+      .min_engine_clock = UINT64_C(300000),
+      .max_memory_clock = UINT64_C(1375000),
+      .min_memory_clock = UINT64_C(150000),
+      .num_hw_gfx_contexts = 8,
+      /* One memory, the CPU's and the GPU's. */
+      .ids_flags = AMDGPU_IDS_FLAGS_FUSION,
+      .virtual_address_offset = UINT64_C(0x200000),
+      .virtual_address_max = RADV_PS4_GPU_ADDRESS_LIMIT,
+      .virtual_address_alignment = RADV_PS4_PAGE_BYTES,
+      .pte_fragment_size = 2097152,
+      .gart_page_size = RADV_PS4_PAGE_BYTES,
+      .vram_type = AMDGPU_VRAM_TYPE_GDDR5,
+      .vram_bit_width = 256,
+      .gc_double_offchip_lds_buf = 0,
+      .wave_front_size = 64,
+      .num_shader_visible_vgprs = 256,
+      .gs_vgt_table_depth = 32,
+      .gs_prim_buffer_depth = 1792,
+      .max_gs_waves_per_vgt = 32,
+   };
+   const uint64_t pool = radv_ps4_memory_pool_bytes();
+   /* An APU's memory, as amdgpu reports Kaveri's: a carve-out for the GPU and
+    * the rest through the GART. Here both are the one direct-memory pool,
+    * split so that RADV's integrated-GPU heaps sum to it. */
+   const struct drm_amdgpu_memory_info memory = {
+      .vram = {.total_heap_size = pool / 2},
+      .cpu_accessible_vram = {.total_heap_size = pool / 2},
+      .gtt = {.total_heap_size = pool - pool / 2},
+   };
+   struct amdgpu_gpu_info gpu_info = {
+      .gb_addr_cfg = RADV_PS4_GB_ADDR_CONFIG,
+      .mc_arb_ramcfg = RADV_PS4_MC_ARB_RAMCFG,
+   };
+   memcpy(gpu_info.gb_tile_mode, radv_ps4_gb_tile_mode, sizeof(radv_ps4_gb_tile_mode));
+   memcpy(gpu_info.gb_macro_tile_mode, radv_ps4_gb_macrotile_mode, sizeof(radv_ps4_gb_macrotile_mode));
+
+   memset(info, 0, sizeof(*info));
+   /* No kernel stands behind this description; the version is the lowest
+    * RADV's amdgpu path accepts, so no feature is assumed from a newer kernel. */
+   info->drm_major = 3;
+   info->drm_minor = 54;
+   info->is_amdgpu = false;
+
+   ac_fill_hw_ip_info(info, &dev, AMD_IP_GFX, &gfx_ip);
+   info->ip[AMD_IP_GFX].num_instances = 1;
+   ac_identify_chip(info, &dev);
+   ac_fill_memory_info(info, &dev, &memory);
+   ac_fill_hw_info(info, &dev);
+   ac_fill_tiling_info(info, &gpu_info);
+   ac_fill_feature_info(info, &dev);
+   ac_fill_bug_info(info);
+   ac_fill_tess_info(info);
+   ac_fill_compiler_info(info, &dev, compiler_compat_mode);
+   assert(info->family == CHIP_BONAIRE && info->gfx_level == GFX7);
+
+   snprintf(info->marketing_name, sizeof(info->marketing_name), "PlayStation 4 GPU (Liverpool)");
+
+   /* Liverpool's L2 is 512 KiB, 64 KiB a slice; Bonaire's slices are larger. */
+   info->l2_cache_size = info->num_tcc_blocks * 64 * 1024;
+   info->has_kernel_raster_config = true;
+
+   /* What the platform, not the chip, rules out. */
+   /* Nothing RADV records runs as an INDIRECT_BUFFER, so the command buffers
+    * device-generated commands write cannot run. */
+   info->has_gpu_written_ibs = false;
+   /* One pool of memory the CPU and the GPU share, which RADV presents as an
+    * integrated GPU's. */
+   info->has_dedicated_vram = false;
+   info->all_vram_visible = true;
+   info->address32_hi = radv_ps4_address32_hi();
+   /* Timeline semaphores: the runtime builds them over the binary sync type
+    * (vk_sync_timeline), with threaded submission for waits before signals. */
+   info->has_timeline_syncobj = true;
+   info->kernel_has_modifiers = false;
+   /* No sparse resources and no capture and replay of addresses. Host
+    * pointers are imported where they are direct memory mapped for the GPU
+    * (VK_EXT_external_memory_host), as VideoOut's framebuffers are. */
+   info->has_sparse = false;
+   info->has_replayable_va = false;
+   info->has_userptr = true;
+   info->has_vm_always_valid = true;
+   /* A compute and transfer queue family whose queues submit to the graphics
+    * ring through the same sceGnmSubmitCommandBuffers: their work runs in turn
+    * with graphics rather than alongside it, which Vulkan allows. Gnm's
+    * asynchronous compute queues would run it alongside; they are not used
+    * yet. */
+   info->num_compute_queues_on_gfx = 4;
+   info->max_submitted_ibs[AMD_IP_GFX] = 1;
+
+   /* ac_query_gpu_info's own derivations, which have no kernel input. */
+   /* Every compute unit may run every stage (set_custom_cu_en_mask without
+    * AMD_CU_MASK): on GFX7 the CU_EN fields of SPI_SHADER_PGM_RSRC3_* are
+    * honoured, and with 0 there no wave would launch. */
+   info->spi_cu_en = ~0u;
+   info->scratch_wavesize_granularity_shift = 10;
+   info->scratch_wavesize_granularity = BITFIELD_BIT(info->scratch_wavesize_granularity_shift);
+   const unsigned max_waves_per_tg = 32;
+   info->max_scratch_waves =
+      MAX2(32 * info->max_good_cu_per_sa * info->max_sa_per_se * info->num_se, max_waves_per_tg);
+   info->has_scratch_base_registers = false;
+   info->max_gflops = 128 * info->num_cu * info->max_gpu_freq_mhz / 1000;
+   info->memory_bandwidth_gbps =
+      DIV_ROUND_UP(info->memory_freq_mhz_effective * info->memory_bus_width / 8, 1000);
+   info->instr_prefetch_distance = 0;
+   ac_get_raster_config(info, &info->pa_sc_raster_config, &info->pa_sc_raster_config_1, &info->se_tile_repeat);
+
+   if (radv_ps4_platform_is_neo())
+      fprintf(stderr, "radv/ps4: the console runs in PS4 Pro mode, whose tiling this driver does not describe; "
+                      "images may be laid out wrong\n");
+}
+
+void
+radv_ps4_winsys_heap_usage(uint64_t *pool_bytes, uint64_t *available_bytes, uint64_t *driver_bytes)
+{
+   *pool_bytes = radv_ps4_memory_pool_bytes();
+   *available_bytes = radv_ps4_memory_available_bytes();
+   *driver_bytes = p_atomic_read(&radv_ps4_allocated_bytes);
+}
+
+VkResult
+radv_ps4_winsys_query_info(uint64_t debug_flags, struct radeon_winsys_info *info)
+{
+   memset(info, 0, sizeof(*info));
+   if (!radv_ps4_queue_get())
+      return VK_ERROR_INITIALIZATION_FAILED;
+   radv_ps4_describe_gpu(&info->base, !(debug_flags & RADV_DEBUG_NO_CACHE_COMPAT));
+   info->syncobj_sync_type = radv_ps4_sync_type;
+   /* One queue, which a title's submissions all reach: low and medium, the
+    * priorities an application may always have, both run there. A priority is
+    * a scheduling hint, and with one queue there is nothing to order. */
+   info->global_priority_mask = BITFIELD_BIT(RADEON_CTX_PRIORITY_LOW) | BITFIELD_BIT(RADEON_CTX_PRIORITY_MEDIUM);
+   /* GPU memory and the queue's syncs have no file descriptor to share. */
+   info->has_external_fd = false;
+   return VK_SUCCESS;
+}
