+/* ------------------------------------------------------------------ queue */
+
+static struct radv_ps4_queue radv_ps4_queue_storage;
+static struct radv_ps4_queue *radv_ps4_queue_instance;
+static once_flag radv_ps4_queue_once = ONCE_FLAG_INIT;
+
+static void
+radv_ps4_queue_create(void)
+{
+   struct radv_ps4_queue *const queue = &radv_ps4_queue_storage;
+   if (!radv_ps4_platform_init()) {
+      fprintf(stderr, "radv/ps4: the platform did not initialise; no device\n");
+      return;
+   }
+   /* The words the GPU runs and the marker it writes are garlic: the CPU
+    * writes the one in order and reads the other uncached. */
+   if (!radv_ps4_memory_alloc(RADV_PS4_RING_BYTES, RADV_PS4_LARGE_BYTES, false, RADV_PS4_MEMORY_GARLIC,
+                              &queue->ring)) {
+      fprintf(stderr, "radv/ps4: no submission ring: %s; no device\n", radv_ps4_memory_error());
+      return;
+   }
+   if (!radv_ps4_memory_alloc(RADV_PS4_PAGE_BYTES, RADV_PS4_PAGE_BYTES, false, RADV_PS4_MEMORY_GARLIC,
+                              &queue->marker_memory)) {
+      fprintf(stderr, "radv/ps4: no completion marker: %s; no device\n", radv_ps4_memory_error());
+      radv_ps4_memory_free(&queue->ring);
+      return;
+   }
+   queue->marker = (volatile uint32_t *)queue->marker_memory.cpu;
+   *queue->marker = 0;
+   radv_ps4_cpu_flush((const void *)queue->marker, sizeof(*queue->marker));
+   simple_mtx_init(&queue->submit_lock, mtx_plain);
+   mtx_init(&queue->sync_lock, mtx_plain);
+   cnd_init(&queue->sync_cond);
+
+   /* RADV_PS4_PROBE submits one command buffer that only writes the marker
+    * with the completion EOP -- no preamble, no rendering -- and reports
+    * whether the GPU reached it. It isolates the submission and end-of-pipe
+    * fence from everything RADV renders: if the probe advances the marker but
+    * a frame hangs, the rendered stream or its state is at fault, not the
+    * submit path; if the probe hangs too, the submit or fence handshake is.
+    * The SDK's gnm_submit sample tests the same thing with hand-written PM4. */
+   if (getenv("RADV_PS4_PROBE")) {
+      uint32_t words[RADV_PS4_COMPLETION_WORDS];
+      radv_ps4_completion_words(words, (uint64_t)(uintptr_t)queue->marker, 1);
+      const int err = radv_ps4_submit(words, RADV_PS4_COMPLETION_WORDS, queue->marker, 1);
+      const uint64_t deadline = radv_ps4_now_ns() + UINT64_C(2) * 1000000000;
+      while (*queue->marker != 1 && radv_ps4_now_ns() < deadline)
+         radv_ps4_sleep_us(1000);
+      fprintf(stderr, "radv/ps4: probe: submit 0x%08x, marker at %p reached %u (want 1) -- the EOP fence %s\n",
+              (unsigned)err, (void *)queue->marker, *queue->marker,
+              *queue->marker == 1 ? "works" : "did NOT land (submit/fence handshake)");
+      *queue->marker = 0;
+      radv_ps4_cpu_flush((const void *)queue->marker, sizeof(*queue->marker));
+   }
+
+   radv_ps4_queue_instance = queue;
+}
+
+struct radv_ps4_queue *
+radv_ps4_queue_get(void)
+{
+   call_once(&radv_ps4_queue_once, radv_ps4_queue_create);
+   return radv_ps4_queue_instance;
+}
+
+uint64_t
+radv_ps4_queue_poll(struct radv_ps4_queue *queue)
+{
+   const uint64_t submitted = p_atomic_read(&queue->submitted_seq);
+   /* The marker holds the low 32 bits of the newest sequence the GPU has run;
+    * it is garlic, which the CPU reads uncached. */
+   const uint32_t marker = *queue->marker;
+   /* The GPU never lags the CPU by 2^32 submissions, so the newest sequence
+    * with these low bits that is not past the submitted one is the one. */
+   const uint64_t completed = submitted - (uint32_t)((uint32_t)submitted - marker);
+   uint64_t known = p_atomic_read(&queue->completed_seq);
+   while (completed > known) {
+      const uint64_t seen = p_atomic_cmpxchg(&queue->completed_seq, known, completed);
+      if (seen == known) {
+         known = completed;
+         break;
+      }
+      known = seen;
+   }
+   return known;
+}
+
+/* A marker that makes no progress for this long while work is outstanding
+ * means the GPU is not running it: the device is lost. */
+#define RADV_PS4_STALL_NS (UINT64_C(10) * 1000000000)
+/* Before sleeping, the marker is checked in a loop for this long: most waits
+ * end well inside a millisecond. */
+#define RADV_PS4_SPIN_NS UINT64_C(1500000)
+
+bool
+radv_ps4_queue_wait_seq(struct radv_ps4_queue *queue, uint64_t seq, uint64_t abs_timeout_ns)
+{
+   uint64_t completed = radv_ps4_queue_poll(queue);
+   if (completed >= seq)
+      return true;
+   uint64_t now = os_time_get_nano();
+   const uint64_t spin_until = now + RADV_PS4_SPIN_NS;
+   uint64_t progress_at = now;
+   uint64_t last = completed;
+   for (;;) {
+      completed = radv_ps4_queue_poll(queue);
+      if (completed >= seq)
+         return true;
+      now = os_time_get_nano();
+      if (now >= abs_timeout_ns)
+         return false;
+      if (completed != last) {
+         last = completed;
+         progress_at = now;
+      } else if (now - progress_at > RADV_PS4_STALL_NS) {
+         fprintf(stderr, "radv/ps4: the GPU has not reached submission %" PRIu64 " (at %" PRIu64 ") in %u s\n", seq,
+                 completed, (unsigned)(RADV_PS4_STALL_NS / 1000000000));
+         if (getenv("RADV_PS4_TRACE")) {
+            const uint32_t tag = *(volatile uint32_t *)((uint8_t *)queue->marker_memory.cpu + RADV_PS4_TRACE_OFFSET);
+            const char *where = tag < seq * 4 + 1 ? "the preamble" : tag == seq * 4 + 1 ? "a draw (the preamble ran)"
+                                                                                        : "the trailing flush or the fence (the draws ran)";
+            fprintf(stderr, "radv/ps4: trace tag %u for submission %" PRIu64 ": the CP wedged in %s\n", tag, seq, where);
+         }
+         return false;
+      }
+      if (now < spin_until)
+         radv_ps4_cpu_pause();
+      else
+         radv_ps4_sleep_us(1000);
+   }
+}
