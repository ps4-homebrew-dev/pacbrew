diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c
new file mode 100644
index 0000000..02e033c
--- /dev/null
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c
@@ -0,0 +1,645 @@
+/*
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "radv_ps4_platform.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "c11/threads.h"
+#include "util/os_time.h"
+#include "util/simple_mtx.h"
+#include "util/u_math.h"
+
+#if defined(__ORBIS__)
+#include "ps4_sce.h"
+#else
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+/* ----------------------------------------------------- the window's granules */
+
+/* The window, handed out first fit in 64 KiB granules: 4 GiB at most, less
+ * where the console reserves no more (radv_ps4_window_reserve). */
+#define RADV_PS4_GRANULES ((uint32_t)(RADV_PS4_WINDOW_BYTES / RADV_PS4_GRANULE_BYTES))
+
+static struct {
+   simple_mtx_t lock;
+   uint8_t *base;
+   /* The granules the window holds. */
+   uint32_t granules;
+   uint64_t used[RADV_PS4_GRANULES / 64];
+} radv_ps4_window = {.lock = SIMPLE_MTX_INITIALIZER, .granules = RADV_PS4_GRANULES};
+
+static bool
+radv_ps4_granule_used(uint32_t granule)
+{
+   return radv_ps4_window.used[granule / 64] & (UINT64_C(1) << (granule % 64));
+}
+
+static void
+radv_ps4_granules_mark(uint32_t first, uint32_t count, bool used)
+{
+   for (uint32_t g = first; g < first + count; g++) {
+      if (used)
+         radv_ps4_window.used[g / 64] |= UINT64_C(1) << (g % 64);
+      else
+         radv_ps4_window.used[g / 64] &= ~(UINT64_C(1) << (g % 64));
+   }
+}
+
+/* The first free run of count granules starting on a multiple of align; the
+ * run is marked used. UINT32_MAX if there is none. Called with the lock held. */
+static uint32_t
+radv_ps4_granules_take(uint32_t count, uint32_t align)
+{
+   for (uint32_t first = 0; first + count <= radv_ps4_window.granules; first += align) {
+      uint32_t g = first;
+      while (g < first + count && !radv_ps4_granule_used(g))
+         g++;
+      if (g == first + count) {
+         radv_ps4_granules_mark(first, count, true);
+         return first;
+      }
+      /* Skip past the used granule, keeping the alignment. */
+      first = (g / align) * align;
+   }
+   return UINT32_MAX;
+}
+
+/* ------------------------------------------------------------ common */
+
+static thread_local const char *radv_ps4_last_error = "";
+
+const char *
+radv_ps4_memory_error(void)
+{
+   return radv_ps4_last_error;
+}
+
+uint32_t
+radv_ps4_address32_hi(void)
+{
+   return (uint32_t)((uint64_t)(uintptr_t)radv_ps4_window.base >> 32);
+}
+
+uint64_t
+radv_ps4_now_ns(void)
+{
+   return (uint64_t)os_time_get_nano();
+}
+
+void
+radv_ps4_sleep_us(unsigned microseconds)
+{
+   os_time_sleep(microseconds);
+}
+
+void
+radv_ps4_cpu_flush(const void *address, size_t bytes)
+{
+   (void)address;
+   (void)bytes;
+#if defined(__x86_64__)
+   /* Garlic stores sit in write-combining buffers until they are drained;
+    * onion memory is coherent with the GPU. */
+   __builtin_ia32_sfence();
+#else
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+}
+
+static uint64_t
+radv_ps4_round_bytes(uint64_t bytes, uint64_t *alignment)
+{
+   *alignment = MAX2(*alignment, RADV_PS4_PAGE_BYTES);
+   if (bytes >= RADV_PS4_LARGE_BYTES)
+      *alignment = MAX2(*alignment, RADV_PS4_LARGE_BYTES);
+   *alignment = util_next_power_of_two64(*alignment);
+   return align64(MAX2(bytes, 1), RADV_PS4_PAGE_BYTES);
+}
+
+static uint64_t radv_ps4_submit_ns[2];
+
+void
+radv_ps4_submit_times(uint64_t times[2])
+{
+   times[0] = radv_ps4_submit_ns[0];
+   times[1] = radv_ps4_submit_ns[1];
+   radv_ps4_submit_ns[0] = radv_ps4_submit_ns[1] = 0;
+}
+
+#if defined(__ORBIS__)
+
+/* --------------------------------------------------------------- console */
+
+#define RADV_PS4_PROT_CPU_GPU_RW                                                                                  \
+   (PS4_KERNEL_PROT_CPU_READ | PS4_KERNEL_PROT_CPU_WRITE | PS4_KERNEL_PROT_GPU_READ | PS4_KERNEL_PROT_GPU_WRITE)
+
+static bool radv_ps4_neo;
+
+/* Whether a window of bytes at window holds 32-bit pointers: within one
+ * 4 GiB block (at a multiple of its size, a power of two of at most 4 GiB)
+ * and below the GPU's address limit. */
+static bool
+radv_ps4_window_fits(const uint8_t *window, uint64_t bytes)
+{
+   const uint64_t at = (uint64_t)(uintptr_t)window;
+   return at % bytes == 0 && at + bytes <= RADV_PS4_GPU_ADDRESS_LIMIT;
+}
+
+/* Reserves a window of bytes for 32-bit pointers: aligned to its size where
+ * the kernel takes that alignment, and otherwise as the aligned part of a
+ * reservation twice the size, the rest given back. */
+static uint8_t *
+radv_ps4_window_reserve(uint64_t bytes)
+{
+   void *window = NULL;
+   const int aligned = sceKernelReserveVirtualRange(&window, bytes, 0, bytes);
+   if (aligned == 0) {
+      if (radv_ps4_window_fits(window, bytes))
+         return window;
+      sceKernelMunmap(window, bytes);
+   }
+
+   void *range = NULL;
+   const int trimmed = sceKernelReserveVirtualRange(&range, 2 * bytes, 0, RADV_PS4_PAGE_BYTES);
+   if (trimmed == 0) {
+      uint8_t *const start = range;
+      uint8_t *const end = start + 2 * bytes;
+      uint8_t *const at = (uint8_t *)align_uintptr((uintptr_t)start, bytes);
+      if (at > start)
+         sceKernelMunmap(start, at - start);
+      if (end > at + bytes)
+         sceKernelMunmap(at + bytes, end - (at + bytes));
+      if (radv_ps4_window_fits(at, bytes))
+         return at;
+      sceKernelMunmap(at, bytes);
+   }
+
+   fprintf(stderr,
+           "radv/ps4: no %" PRIu64 " MiB window for 32-bit pointers: 0x%08x aligned, 0x%08x trimmed%s\n",
+           bytes >> 20, (unsigned)aligned, (unsigned)trimmed,
+           aligned == 0 || trimmed == 0 ? " (not below 1 TiB)" : "");
+   return NULL;
+}
+
+static bool
+radv_ps4_platform_once(void)
+{
+   /* RADV's shader cache in the database form. /app0 is the
+    * title's read-only PKG, so the cache goes under /data, which homebrew can
+    * write; a title may choose otherwise, as on Linux. If the directory
+    * cannot be made the cache disables itself and pipelines are recompiled
+    * each launch. */
+   setenv("MESA_SHADER_CACHE_DIR", "/data/radv-shader-cache", 0);
+   setenv("MESA_DISK_CACHE_DATABASE", "1", 0);
+
+   /* 32-bit pointers share their high word, so the window must not cross a
+    * 4 GiB boundary; it need not be 4 GiB. RADV's 32-bit buffers (shaders,
+    * descriptors, uploads) fit in far less. */
+   static const uint64_t sizes[] = {RADV_PS4_WINDOW_BYTES, UINT64_C(1) << 30, UINT64_C(256) << 20};
+   uint8_t *window = NULL;
+   uint64_t bytes = 0;
+   for (unsigned i = 0; i < ARRAY_SIZE(sizes) && !window; i++) {
+      bytes = sizes[i];
+      window = radv_ps4_window_reserve(bytes);
+   }
+   if (!window)
+      return false;
+   if (bytes != RADV_PS4_WINDOW_BYTES)
+      fprintf(stderr, "radv/ps4: a %" PRIu64 " MiB window for 32-bit pointers at %p\n", bytes >> 20,
+              (void *)window);
+   radv_ps4_window.base = window;
+   radv_ps4_window.granules = (uint32_t)(bytes / RADV_PS4_GRANULE_BYTES);
+   radv_ps4_neo = sceKernelIsNeoMode() > 0;
+   return true;
+}
+
+bool
+radv_ps4_platform_runs_gpu(void)
+{
+   return true;
+}
+
+bool
+radv_ps4_platform_is_neo(void)
+{
+   return radv_ps4_neo;
+}
+
+bool
+radv_ps4_memory_gpu_mapped(const void *address, uint64_t bytes)
+{
+   /* Walk the mappings the range spans: each must give the GPU read and
+    * write access. */
+   const uint8_t *at = address;
+   const uint8_t *const end = at + bytes;
+   if ((uint64_t)(uintptr_t)address >= RADV_PS4_GPU_ADDRESS_LIMIT ||
+       bytes > RADV_PS4_GPU_ADDRESS_LIMIT - (uint64_t)(uintptr_t)address)
+      return false;
+   while (at < end) {
+      struct ps4_kernel_virtual_query_info query;
+      if (sceKernelVirtualQuery(at, 0, &query, sizeof(query)) != 0)
+         return false;
+      if ((query.protection & (PS4_KERNEL_PROT_GPU_READ | PS4_KERNEL_PROT_GPU_WRITE)) !=
+             (PS4_KERNEL_PROT_GPU_READ | PS4_KERNEL_PROT_GPU_WRITE) ||
+          (const uint8_t *)query.start > at || (const uint8_t *)query.end <= at)
+         return false;
+      at = query.end;
+   }
+   return true;
+}
+
+uint64_t
+radv_ps4_memory_pool_bytes(void)
+{
+   return (uint64_t)sceKernelGetDirectMemorySize();
+}
+
+uint64_t
+radv_ps4_memory_available_bytes(void)
+{
+   int64_t physical = 0;
+   size_t available = 0;
+   if (sceKernelAvailableDirectMemorySize(0, sceKernelGetDirectMemorySize(), 0, &physical, &available))
+      return 0;
+   return available;
+}
+
+static bool
+radv_ps4_map(int64_t physical, uint64_t bytes, uint64_t alignment, void *at, uint8_t **out)
+{
+   void *address = at;
+   int err = sceKernelMapDirectMemory(&address, bytes, RADV_PS4_PROT_CPU_GPU_RW, at ? PS4_KERNEL_MAP_FIXED : 0,
+                                      physical, alignment);
+   if (err) {
+      radv_ps4_last_error = "sceKernelMapDirectMemory failed";
+      return false;
+   }
+   if (at && address != at) {
+      sceKernelMunmap(address, bytes);
+      radv_ps4_last_error = "sceKernelMapDirectMemory did not map at the address asked for";
+      return false;
+   }
+   if ((uint64_t)(uintptr_t)address + bytes > RADV_PS4_GPU_ADDRESS_LIMIT) {
+      sceKernelMunmap(address, bytes);
+      radv_ps4_last_error = "direct memory was mapped beyond the GPU's 40-bit addresses";
+      return false;
+   }
+   *out = address;
+   return true;
+}
+
+/* Gives the window's range back to the reservation. */
+static void
+radv_ps4_window_unmap(void *at, uint64_t bytes)
+{
+   sceKernelMunmap(at, bytes);
+   void *again = at;
+   if (sceKernelReserveVirtualRange(&again, bytes, PS4_KERNEL_MAP_FIXED, RADV_PS4_PAGE_BYTES) || again != at)
+      fprintf(stderr, "radv/ps4: could not reserve %p again in the window\n", at);
+}
+
+bool
+radv_ps4_memory_alloc(uint64_t bytes, uint64_t alignment, bool window32, enum radv_ps4_memory_type type,
+                      struct radv_ps4_memory *out)
+{
+   memset(out, 0, sizeof(*out));
+   out->physical = -1;
+   out->fd = -1;
+   bytes = radv_ps4_round_bytes(bytes, &alignment);
+
+   int64_t physical = 0;
+   const int memory_type = type == RADV_PS4_MEMORY_ONION ? PS4_KERNEL_WB_ONION : PS4_KERNEL_WC_GARLIC;
+   if (sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), bytes, alignment, memory_type, &physical)) {
+      radv_ps4_last_error = "sceKernelAllocateDirectMemory failed";
+      return false;
+   }
+
+   void *at = NULL;
+   if (window32) {
+      const uint32_t count = (uint32_t)DIV_ROUND_UP(bytes, RADV_PS4_GRANULE_BYTES);
+      const uint32_t align = (uint32_t)MAX2(alignment / RADV_PS4_GRANULE_BYTES, 1);
+      simple_mtx_lock(&radv_ps4_window.lock);
+      const uint32_t first = radv_ps4_granules_take(count, align);
+      simple_mtx_unlock(&radv_ps4_window.lock);
+      if (first == UINT32_MAX) {
+         sceKernelReleaseDirectMemory(physical, bytes);
+         radv_ps4_last_error = "the 32-bit window is full";
+         return false;
+      }
+      out->granule = first;
+      out->granules = count;
+      out->in_window = true;
+      at = radv_ps4_window.base + (uint64_t)first * RADV_PS4_GRANULE_BYTES;
+   }
+
+   if (!radv_ps4_map(physical, bytes, alignment, at, &out->cpu)) {
+      if (window32) {
+         simple_mtx_lock(&radv_ps4_window.lock);
+         radv_ps4_granules_mark(out->granule, out->granules, false);
+         simple_mtx_unlock(&radv_ps4_window.lock);
+      }
+      sceKernelReleaseDirectMemory(physical, bytes);
+      return false;
+   }
+   out->bytes = bytes;
+   out->physical = physical;
+   return true;
+}
+
+void
+radv_ps4_memory_free(struct radv_ps4_memory *memory)
+{
+   if (!memory->cpu)
+      return;
+   if (memory->in_window) {
+      radv_ps4_window_unmap(memory->cpu, memory->bytes);
+      simple_mtx_lock(&radv_ps4_window.lock);
+      radv_ps4_granules_mark(memory->granule, memory->granules, false);
+      simple_mtx_unlock(&radv_ps4_window.lock);
+   } else {
+      sceKernelMunmap(memory->cpu, memory->bytes);
+   }
+   if (memory->physical >= 0)
+      sceKernelReleaseDirectMemory(memory->physical, memory->bytes);
+   memset(memory, 0, sizeof(*memory));
+   memory->physical = -1;
+   memory->fd = -1;
+}
+
+bool
+radv_ps4_memory_map_at(const struct radv_ps4_memory *memory, void *address)
+{
+   uint8_t *cpu;
+   if (memory->physical < 0)
+      return false;
+   return radv_ps4_map(memory->physical, memory->bytes, RADV_PS4_PAGE_BYTES, address, &cpu);
+}
+
+void
+radv_ps4_memory_unmap_at(void *address, uint64_t bytes, bool reserve)
+{
+   sceKernelMunmap(address, bytes);
+   if (reserve) {
+      void *again = address;
+      sceKernelReserveVirtualRange(&again, bytes, PS4_KERNEL_MAP_FIXED, RADV_PS4_PAGE_BYTES);
+   }
+}
+
+int
+radv_ps4_submit(uint32_t *words, uint32_t count, volatile uint32_t *marker, uint32_t marker_value)
+{
+   (void)marker;
+   (void)marker_value;
+   void *dcb = words;
+   uint32_t dcb_bytes = count * 4;
+   void *ccb = NULL;
+   uint32_t ccb_bytes = 0;
+
+   radv_ps4_cpu_flush(words, dcb_bytes);
+   const uint64_t start = radv_ps4_now_ns();
+   int err = sceGnmSubmitCommandBuffers(1, &dcb, &dcb_bytes, &ccb, &ccb_bytes);
+   const uint64_t submitted = radv_ps4_now_ns();
+   if (!err)
+      err = sceGnmSubmitDone();
+   radv_ps4_submit_ns[0] += submitted - start;
+   radv_ps4_submit_ns[1] += radv_ps4_now_ns() - submitted;
+   return err;
+}
+
+#else
+
+/* ------------------------------------------------------------ host model */
+
+/* Memory is a memfd per allocation, so that placed mappings can map it again.
+ * As on the console, every GPU address lies below 2^40: the model reserves an
+ * arena there, the window first, and hands out the rest in order (it never
+ * reuses addresses, which a host's address space can afford). Nothing runs: a
+ * submission writes its marker at once. */
+
+#define RADV_PS4_HOST_POOL_BYTES (UINT64_C(4608) << 20)
+#define RADV_PS4_HOST_ARENA_BYTES (UINT64_C(256) << 30)
+
+static uint64_t radv_ps4_host_allocated;
+static struct {
+   simple_mtx_t lock;
+   uint8_t *next;
+   uint8_t *end;
+} radv_ps4_arena = {.lock = SIMPLE_MTX_INITIALIZER};
+
+static bool
+radv_ps4_platform_once(void)
+{
+   /* An arena at a 4 GiB boundary below 1 TiB, wherever one is free. */
+   for (uint64_t at = UINT64_C(16) << 30; at + RADV_PS4_HOST_ARENA_BYTES <= RADV_PS4_GPU_ADDRESS_LIMIT;
+        at += RADV_PS4_HOST_ARENA_BYTES) {
+      uint8_t *arena = mmap((void *)(uintptr_t)at, RADV_PS4_HOST_ARENA_BYTES, PROT_NONE,
+                            MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+      if (arena == MAP_FAILED)
+         continue;
+      if (arena != (uint8_t *)(uintptr_t)at) {
+         munmap(arena, RADV_PS4_HOST_ARENA_BYTES);
+         continue;
+      }
+      radv_ps4_window.base = arena;
+      radv_ps4_arena.next = arena + RADV_PS4_WINDOW_BYTES;
+      radv_ps4_arena.end = arena + RADV_PS4_HOST_ARENA_BYTES;
+      return true;
+   }
+   fprintf(stderr, "radv/ps4: no address space below 1 TiB for the model: %s\n", strerror(errno));
+   return false;
+}
+
+bool
+radv_ps4_platform_runs_gpu(void)
+{
+   return false;
+}
+
+bool
+radv_ps4_platform_is_neo(void)
+{
+   return false;
+}
+
+bool
+radv_ps4_memory_gpu_mapped(const void *address, uint64_t bytes)
+{
+   /* The model runs no GPU work: any memory will do. */
+   (void)address;
+   (void)bytes;
+   return true;
+}
+
+uint64_t
+radv_ps4_memory_pool_bytes(void)
+{
+   return RADV_PS4_HOST_POOL_BYTES;
+}
+
+uint64_t
+radv_ps4_memory_available_bytes(void)
+{
+   const uint64_t used = __atomic_load_n(&radv_ps4_host_allocated, __ATOMIC_RELAXED);
+   return used < RADV_PS4_HOST_POOL_BYTES ? RADV_PS4_HOST_POOL_BYTES - used : 0;
+}
+
+static uint8_t *
+radv_ps4_host_map(int fd, uint64_t bytes, uint64_t alignment, void *at)
+{
+   if (!at) {
+      /* The arena's next aligned range. */
+      simple_mtx_lock(&radv_ps4_arena.lock);
+      uint8_t *const p = (uint8_t *)align64((uint64_t)(uintptr_t)radv_ps4_arena.next, alignment);
+      if (p + bytes <= radv_ps4_arena.end) {
+         radv_ps4_arena.next = p + bytes;
+         at = p;
+      }
+      simple_mtx_unlock(&radv_ps4_arena.lock);
+      if (!at)
+         return NULL;
+   }
+   void *p = mmap(at, bytes, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, fd, 0);
+   return p == MAP_FAILED ? NULL : p;
+}
+
+static void
+radv_ps4_host_reserve(void *at, uint64_t bytes)
+{
+   mmap(at, bytes, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE, -1, 0);
+}
+
+bool
+radv_ps4_memory_alloc(uint64_t bytes, uint64_t alignment, bool window32, enum radv_ps4_memory_type type,
+                      struct radv_ps4_memory *out)
+{
+   (void)type;
+   memset(out, 0, sizeof(*out));
+   out->physical = -1;
+   out->fd = -1;
+   bytes = radv_ps4_round_bytes(bytes, &alignment);
+
+   if (radv_ps4_memory_available_bytes() < bytes) {
+      radv_ps4_last_error = "the model's pool is exhausted";
+      return false;
+   }
+   const int fd = memfd_create("radv-ps4", MFD_CLOEXEC);
+   if (fd < 0 || ftruncate(fd, (off_t)bytes) != 0) {
+      if (fd >= 0)
+         close(fd);
+      radv_ps4_last_error = "memfd_create failed";
+      return false;
+   }
+
+   void *at = NULL;
+   if (window32) {
+      const uint32_t count = (uint32_t)DIV_ROUND_UP(bytes, RADV_PS4_GRANULE_BYTES);
+      const uint32_t align = (uint32_t)MAX2(alignment / RADV_PS4_GRANULE_BYTES, 1);
+      simple_mtx_lock(&radv_ps4_window.lock);
+      const uint32_t first = radv_ps4_granules_take(count, align);
+      simple_mtx_unlock(&radv_ps4_window.lock);
+      if (first == UINT32_MAX) {
+         close(fd);
+         radv_ps4_last_error = "the 32-bit window is full";
+         return false;
+      }
+      out->granule = first;
+      out->granules = count;
+      out->in_window = true;
+      at = radv_ps4_window.base + (uint64_t)first * RADV_PS4_GRANULE_BYTES;
+   }
+
+   out->cpu = radv_ps4_host_map(fd, bytes, alignment, at);
+   if (!out->cpu) {
+      if (window32) {
+         radv_ps4_host_reserve(at, bytes);
+         simple_mtx_lock(&radv_ps4_window.lock);
+         radv_ps4_granules_mark(out->granule, out->granules, false);
+         simple_mtx_unlock(&radv_ps4_window.lock);
+      }
+      close(fd);
+      radv_ps4_last_error = "mmap failed";
+      return false;
+   }
+   out->bytes = bytes;
+   out->fd = fd;
+   __atomic_add_fetch(&radv_ps4_host_allocated, bytes, __ATOMIC_RELAXED);
+   return true;
+}
+
+void
+radv_ps4_memory_free(struct radv_ps4_memory *memory)
+{
+   if (!memory->cpu)
+      return;
+   if (memory->in_window) {
+      radv_ps4_host_reserve(memory->cpu, memory->bytes);
+      simple_mtx_lock(&radv_ps4_window.lock);
+      radv_ps4_granules_mark(memory->granule, memory->granules, false);
+      simple_mtx_unlock(&radv_ps4_window.lock);
+   } else {
+      /* The arena keeps the range. */
+      radv_ps4_host_reserve(memory->cpu, memory->bytes);
+   }
+   if (memory->fd >= 0) {
+      close(memory->fd);
+      __atomic_sub_fetch(&radv_ps4_host_allocated, memory->bytes, __ATOMIC_RELAXED);
+   }
+   memset(memory, 0, sizeof(*memory));
+   memory->physical = -1;
+   memory->fd = -1;
+}
+
+bool
+radv_ps4_memory_map_at(const struct radv_ps4_memory *memory, void *address)
+{
+   if (memory->fd < 0)
+      return false;
+   return radv_ps4_host_map(memory->fd, memory->bytes, RADV_PS4_PAGE_BYTES, address) != NULL;
+}
+
+void
+radv_ps4_memory_unmap_at(void *address, uint64_t bytes, bool reserve)
+{
+   if (reserve)
+      radv_ps4_host_reserve(address, bytes);
+   else
+      munmap(address, bytes);
+}
+
+int
+radv_ps4_submit(uint32_t *words, uint32_t count, volatile uint32_t *marker, uint32_t marker_value)
+{
+   (void)words;
+   (void)count;
+   if (marker)
+      *marker = marker_value;
+   return 0;
+}
+
+#endif
+
+static bool radv_ps4_platform_ready;
+static once_flag radv_ps4_platform_flag = ONCE_FLAG_INIT;
+
+static void
+radv_ps4_platform_call_once(void)
+{
+   radv_ps4_platform_ready = radv_ps4_platform_once();
+}
+
+bool
+radv_ps4_platform_init(void)
+{
+   call_once(&radv_ps4_platform_flag, radv_ps4_platform_call_once);
+   return radv_ps4_platform_ready;
+}
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h
new file mode 100644
index 0000000..68f9ec2
--- /dev/null
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.h
@@ -0,0 +1,122 @@
+/*
+ * Copyright © 2026 Mihawk
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef RADV_PS4_PLATFORM_H
+#define RADV_PS4_PLATFORM_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* What the PS4 winsys needs from the console: direct memory the CPU and the GPU
+ * share at one address, and submission of PM4 words. On the console these are
+ * libkernel's direct memory functions and libSceGnmDriver's
+ * sceGnmSubmitCommandBuffers (include/ps4_sce.h); a host build models them, so
+ * the driver runs on a PC for everything that does not need the GPU to execute
+ * (device creation, pipeline compilation, API tests).
+ *
+ * The PS4's GPU addresses are its CPU addresses, and it has two
+ * kinds of memory: garlic, which the CPU writes combined and reads uncached
+ * (the GPU's fast path), and onion, which the CPU caches and the GPU reaches
+ * coherently through the CPU's caches. Neither needs the CPU's cache lines
+ * flushed before the GPU reads it; written-combined stores need only to have
+ * left the CPU (radv_ps4_cpu_flush). */
+
+/* The GPU's virtual addresses are 40 bits wide (GFX7). */
+#define RADV_PS4_GPU_ADDRESS_LIMIT (UINT64_C(1) << 40)
+
+/* The shaders' 32-bit pointers reach a window of at most 4 GiB within one
+ * 4 GiB block, reserved wherever the kernel finds room for it
+ * (radv_ps4_address32_hi). */
+#define RADV_PS4_WINDOW_BYTES (UINT64_C(1) << 32)
+
+/* Direct memory is granted in 16 KiB pages; allocations of at least 2 MiB get
+ * 2 MiB alignment. The window is handed out in 64 KiB granules. */
+#define RADV_PS4_PAGE_BYTES UINT64_C(0x4000)
+#define RADV_PS4_LARGE_BYTES UINT64_C(0x200000)
+#define RADV_PS4_GRANULE_BYTES UINT64_C(0x10000)
+
+/* The most bytes one DCB may hold (Gnm's indirect buffer limit). */
+#define RADV_PS4_DCB_MAX_BYTES UINT32_C(0x3ffffc)
+
+enum radv_ps4_memory_type {
+   /* CPU write-combined: what the GPU reads fastest, and what the CPU should
+    * only write. */
+   RADV_PS4_MEMORY_GARLIC,
+   /* CPU write-back, GPU coherent: for what the CPU reads back. */
+   RADV_PS4_MEMORY_ONION,
+};
+
+struct radv_ps4_memory {
+   /* The CPU mapping, which is also the GPU address. */
+   uint8_t *cpu;
+   uint64_t bytes;
+   /* The direct-memory allocation behind it; -1 on the host. */
+   int64_t physical;
+   /* The window's granules the mapping took, if it is in the window. */
+   uint32_t granule;
+   uint32_t granules;
+   bool in_window;
+   /* A memfd behind the host model's mapping, for placed mappings; -1. */
+   int fd;
+};
+
+/* Reserves the window once per process. */
+bool radv_ps4_platform_init(void);
+
+/* Whether submitted words run on a GPU. The host model completes a submission
+ * without running it. */
+bool radv_ps4_platform_runs_gpu(void);
+
+/* Whether the console runs in the PS4 Pro's mode, whose tiling the winsys does
+ * not describe yet. */
+bool radv_ps4_platform_is_neo(void);
+
+/* The high word of the window's addresses. */
+uint32_t radv_ps4_address32_hi(void);
+
+/* Why this thread's last radv_ps4_memory_alloc failed, or "". */
+const char *radv_ps4_memory_error(void);
+
+bool radv_ps4_memory_alloc(uint64_t bytes, uint64_t alignment, bool window32, enum radv_ps4_memory_type type,
+                           struct radv_ps4_memory *out);
+void radv_ps4_memory_free(struct radv_ps4_memory *memory);
+
+/* Maps memory's direct memory a second time for the CPU, at address, replacing
+ * whatever the range held (a placed mapping), and undoes it, leaving the range
+ * reserved if reserve is set. */
+bool radv_ps4_memory_map_at(const struct radv_ps4_memory *memory, void *address);
+void radv_ps4_memory_unmap_at(void *address, uint64_t bytes, bool reserve);
+
+/* Whether every page of [address, address + bytes) is mapped for the GPU to
+ * read and write, below its address limit: memory a host pointer import may
+ * take. */
+bool radv_ps4_memory_gpu_mapped(const void *address, uint64_t bytes);
+
+/* The direct-memory pool, which the CPU draws on too, and what it has left. */
+uint64_t radv_ps4_memory_pool_bytes(void);
+uint64_t radv_ps4_memory_available_bytes(void);
+
+/* Orders the CPU's earlier stores, written-combined ones included, before what
+ * follows: the GPU then sees them. (No cache line needs flushing on the PS4;
+ * the range says what the stores were, should a platform need it.) */
+void radv_ps4_cpu_flush(const void *address, size_t bytes);
+
+/* Submits count PM4 words at words (garlic memory) as one DCB, then tells the
+ * system the submission is done (sceGnmSubmitDone). The words end with a
+ * packet that writes marker_value to marker once they have run; the host model
+ * writes it at once. */
+int radv_ps4_submit(uint32_t *words, uint32_t count, volatile uint32_t *marker, uint32_t marker_value);
+
+/* The nanoseconds radv_ps4_submit spent since the last call, in
+ * sceGnmSubmitCommandBuffers and in sceGnmSubmitDone. */
+void radv_ps4_submit_times(uint64_t times[2]);
+
+uint64_t radv_ps4_now_ns(void);
+void radv_ps4_sleep_us(unsigned microseconds);
+
+#endif /* RADV_PS4_PLATFORM_H */
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_sync.c b/src/amd/vulkan/winsys/ps4/radv_ps4_sync.c
new file mode 100644
index 0000000..29332e1
--- /dev/null
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_sync.c
@@ -0,0 +1,227 @@
+/*
+ * Copyright © 2026 Mihawk
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "radv_ps4_winsys.h"
+
+#include "util/os_time.h"
+#include "vk_sync.h"
+
+/* A binary sync object on the console's one queue. It is signalled by the
+ * submission that carries it -- the GPU has run it once the queue's marker
+ * passes that submission's sequence number -- or by the host at once. Every
+ * submission runs after the ones before it, so a submission that waits on a
+ * sync signalled by an earlier one needs only that signal to have been
+ * submitted, never a GPU wait. The state is guarded by the
+ * queue's sync lock, whose condition wakes waiters when a signal is submitted.
+ */
+struct radv_ps4_sync {
+   struct vk_sync base;
+   /* A signal has been submitted, or made by the host. */
+   bool pending;
+   /* Signalled once the GPU has run this sequence (0: already). */
+   uint64_t seq;
+};
+
+static inline struct radv_ps4_sync *
+radv_ps4_sync(struct vk_sync *sync)
+{
+   return container_of(sync, struct radv_ps4_sync, base);
+}
+
+static struct radv_ps4_queue *
+radv_ps4_sync_queue(void)
+{
+   return radv_ps4_queue_get();
+}
+
+static VkResult
+radv_ps4_sync_init(struct vk_device *device, struct vk_sync *vk_sync, uint64_t initial_value)
+{
+   (void)device;
+   struct radv_ps4_sync *const sync = radv_ps4_sync(vk_sync);
+   sync->pending = initial_value != 0;
+   sync->seq = 0;
+   return VK_SUCCESS;
+}
+
+static void
+radv_ps4_sync_finish(struct vk_device *device, struct vk_sync *vk_sync)
+{
+   (void)device;
+   (void)vk_sync;
+}
+
+static void
+radv_ps4_sync_set(struct radv_ps4_sync *sync, bool pending, uint64_t seq)
+{
+   struct radv_ps4_queue *const queue = radv_ps4_sync_queue();
+   mtx_lock(&queue->sync_lock);
+   sync->pending = pending;
+   sync->seq = seq;
+   if (pending)
+      cnd_broadcast(&queue->sync_cond);
+   mtx_unlock(&queue->sync_lock);
+}
+
+static VkResult
+radv_ps4_sync_signal(struct vk_device *device, struct vk_sync *vk_sync, uint64_t value)
+{
+   (void)device;
+   (void)value;
+   radv_ps4_sync_set(radv_ps4_sync(vk_sync), true, 0);
+   return VK_SUCCESS;
+}
+
+static VkResult
+radv_ps4_sync_reset(struct vk_device *device, struct vk_sync *vk_sync)
+{
+   (void)device;
+   radv_ps4_sync_set(radv_ps4_sync(vk_sync), false, 0);
+   return VK_SUCCESS;
+}
+
+static VkResult
+radv_ps4_sync_move(struct vk_device *device, struct vk_sync *dst, struct vk_sync *src)
+{
+   (void)device;
+   struct radv_ps4_queue *const queue = radv_ps4_sync_queue();
+   mtx_lock(&queue->sync_lock);
+   struct radv_ps4_sync *const d = radv_ps4_sync(dst), *const s = radv_ps4_sync(src);
+   d->pending = s->pending;
+   d->seq = s->seq;
+   s->pending = false;
+   s->seq = 0;
+   if (d->pending)
+      cnd_broadcast(&queue->sync_cond);
+   mtx_unlock(&queue->sync_lock);
+   return VK_SUCCESS;
+}
+
+/* Whether one wait is satisfied: the signal submitted, and for a complete wait
+ * the GPU past its sequence. Called with the sync lock held. */
+static bool
+radv_ps4_sync_ready(struct radv_ps4_queue *queue, const struct radv_ps4_sync *sync, enum vk_sync_wait_flags flags)
+{
+   if (!sync->pending)
+      return false;
+   if (flags & VK_SYNC_WAIT_PENDING)
+      return true;
+   return sync->seq == 0 || radv_ps4_queue_poll(queue) >= sync->seq;
+}
+
+static VkResult
+radv_ps4_sync_wait_many(struct vk_device *device, uint32_t wait_count, const struct vk_sync_wait *waits,
+                        enum vk_sync_wait_flags flags, uint64_t abs_timeout_ns)
+{
+   (void)device;
+   struct radv_ps4_queue *const queue = radv_ps4_sync_queue();
+   const bool any = flags & VK_SYNC_WAIT_ANY;
+
+   mtx_lock(&queue->sync_lock);
+   for (;;) {
+      uint32_t ready = 0;
+      /* The sequence the slowest ready-but-running wait still needs. */
+      uint64_t need = 0;
+      bool all_pending = true;
+      for (uint32_t i = 0; i < wait_count; i++) {
+         const struct radv_ps4_sync *const sync = radv_ps4_sync(waits[i].sync);
+         if (radv_ps4_sync_ready(queue, sync, flags)) {
+            ready++;
+         } else if (sync->pending) {
+            need = MAX2(need, sync->seq);
+         } else {
+            all_pending = false;
+         }
+      }
+      if (any ? ready > 0 || wait_count == 0 : ready == wait_count) {
+         mtx_unlock(&queue->sync_lock);
+         return VK_SUCCESS;
+      }
+      const uint64_t now = os_time_get_nano();
+      if (now >= abs_timeout_ns) {
+         mtx_unlock(&queue->sync_lock);
+         return VK_TIMEOUT;
+      }
+      if (all_pending && need != 0) {
+         /* Everything waited for is submitted: the rest is the GPU's. */
+         mtx_unlock(&queue->sync_lock);
+         if (any) {
+            radv_ps4_sleep_us(100);
+         } else if (!radv_ps4_queue_wait_seq(queue, need, abs_timeout_ns)) {
+            return os_time_get_nano() >= abs_timeout_ns ? VK_TIMEOUT : VK_ERROR_DEVICE_LOST;
+         }
+         mtx_lock(&queue->sync_lock);
+         continue;
+      }
+      /* A signal still has to be submitted: sleep until one is, or a
+       * millisecond passes so running work is polled too. */
+      struct timespec until;
+      const uint64_t wake = MIN2(abs_timeout_ns, now + 1000000);
+      until.tv_sec = wake / 1000000000;
+      until.tv_nsec = wake % 1000000000;
+      cnd_timedwait(&queue->sync_cond, &queue->sync_lock, &until);
+   }
+}
+
+const struct vk_sync_type radv_ps4_sync_type = {
+   .size = sizeof(struct radv_ps4_sync),
+   .features = VK_SYNC_FEATURE_BINARY | VK_SYNC_FEATURE_GPU_WAIT | VK_SYNC_FEATURE_GPU_MULTI_WAIT |
+               VK_SYNC_FEATURE_CPU_WAIT | VK_SYNC_FEATURE_CPU_RESET | VK_SYNC_FEATURE_CPU_SIGNAL |
+               VK_SYNC_FEATURE_WAIT_ANY | VK_SYNC_FEATURE_WAIT_PENDING,
+   .init = radv_ps4_sync_init,
+   .finish = radv_ps4_sync_finish,
+   .signal = radv_ps4_sync_signal,
+   .reset = radv_ps4_sync_reset,
+   .move = radv_ps4_sync_move,
+   .wait_many = radv_ps4_sync_wait_many,
+};
+
+VkResult
+radv_ps4_sync_wait_submitted(uint32_t wait_count, const struct vk_sync_wait *waits, uint64_t *seq)
+{
+   *seq = 0;
+   if (wait_count == 0)
+      return VK_SUCCESS;
+   const VkResult result = radv_ps4_sync_wait_many(NULL, wait_count, waits, VK_SYNC_WAIT_PENDING, OS_TIMEOUT_INFINITE);
+   if (result != VK_SUCCESS)
+      return result;
+   struct radv_ps4_queue *const queue = radv_ps4_sync_queue();
+   mtx_lock(&queue->sync_lock);
+   for (uint32_t i = 0; i < wait_count; i++)
+      *seq = MAX2(*seq, radv_ps4_sync(waits[i].sync)->seq);
+   mtx_unlock(&queue->sync_lock);
+   return VK_SUCCESS;
+}
+
+void
+radv_ps4_sync_signal_seq(uint32_t signal_count, const struct vk_sync_signal *signals, uint64_t seq)
+{
+   if (signal_count == 0)
+      return;
+   struct radv_ps4_queue *const queue = radv_ps4_sync_queue();
+   mtx_lock(&queue->sync_lock);
+   for (uint32_t i = 0; i < signal_count; i++) {
+      struct radv_ps4_sync *const sync = radv_ps4_sync(signals[i].sync);
+      sync->pending = true;
+      sync->seq = seq;
+   }
+   cnd_broadcast(&queue->sync_cond);
+   mtx_unlock(&queue->sync_lock);
+}
+
+VkResult
+radv_ps4_sync_copy_payloads(struct vk_device *device, uint32_t wait_count, const struct vk_sync_wait *waits,
+                            uint32_t signal_count, const struct vk_sync_signal *signals)
+{
+   (void)device;
+   uint64_t seq = 0;
+   const VkResult result = radv_ps4_sync_wait_submitted(wait_count, waits, &seq);
+   if (result != VK_SUCCESS)
+      return result;
+   radv_ps4_sync_signal_seq(signal_count, signals, seq);
+   return VK_SUCCESS;
+}
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
new file mode 100644
