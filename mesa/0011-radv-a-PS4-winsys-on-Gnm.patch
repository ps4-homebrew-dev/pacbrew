+
+#ifndef RADV_PS4_LIVERPOOL_H
+#define RADV_PS4_LIVERPOOL_H
+
+#include <stdint.h>
+
+/* The PS4's GPU, Liverpool, as RADV's PS4 winsys describes it
+ * (radv_ps4_describe_gpu): what it reports in the amdgpu kernel's form, kept
+ * apart so that tools can check it (the tiling against freegnm's addressing
+ * library). */
+
+#define RADV_PS4_EXTERNAL_REV 0x14 /* the BONAIRE range: GFX7 */
+
+/* NUM_PIPES 8 (3), PIPE_INTERLEAVE_SIZE 256 bytes (0), BANK_INTERLEAVE_SIZE 1
+ * (0), NUM_SHADER_ENGINES 2 (1), SHADER_ENGINE_TILE_SIZE 32 (1), NUM_GPUS 1
+ * (0), MULTI_GPU_TILE_SIZE 2 (1), ROW_SIZE 1 KiB (0). */
+#define RADV_PS4_GB_ADDR_CONFIG 0x01011003
+/* NOOFBANK 16 (2), NOOFRANKS 1 (0). */
+#define RADV_PS4_MC_ARB_RAMCFG 0x00000002
+
+static const uint32_t radv_ps4_gb_tile_mode[32] = {
+   0x00800310, /*  0: depth 2D thin, 64 B tile split */
+   0x00800b10, /*  1: depth 2D thin, 128 B tile split */
+   0x00801310, /*  2: depth 2D thin, 256 B tile split */
+   0x00801b10, /*  3: depth 2D thin, 512 B tile split */
+   0x00802310, /*  4: depth 2D thin, 1 KiB tile split */
+   0x00800308, /*  5: depth 1D thin */
+   0x00801318, /*  6: depth 2D thin PRT, 256 B tile split */
+   0x00802318, /*  7: depth 2D thin PRT, 1 KiB tile split */
+   0x00000304, /*  8: display linear aligned */
+   0x00000308, /*  9: display 1D thin */
+   0x02000310, /* 10: display 2D thin */
+   0x02000294, /* 11: display thin PRT */
+   0x02000318, /* 12: display 2D thin PRT */
+   0x00400308, /* 13: thin 1D thin */
+   0x02400310, /* 14: thin 2D thin */
+   0x024002b0, /* 15: thin 3D thin */
+   0x02400294, /* 16: thin thin PRT */
+   0x02400318, /* 17: thin 2D thin PRT */
+   0x02400330, /* 18: thin 3D thin PRT */
+   0x0100030c, /* 19: thick 1D thick */
+   0x0100031c, /* 20: thick 2D thick */
+   0x010002b4, /* 21: thick 3D thick */
+   0x010002a4, /* 22: thick thick PRT */
+   0x01000328, /* 23: thick 2D thick PRT */
+   0x010002bc, /* 24: thick 3D thick PRT */
+   0x01000320, /* 25: thick 2D xthick */
+   0x010002b8, /* 26: thick 3D xthick */
+   0x00000000, /* 27-30: the rotated modes Linux has; the console has none */
+   0x00000000,
+   0x00000000,
+   0x00000000,
+   0x00000000, /* 31: linear general */
+};
+
+static const uint32_t radv_ps4_gb_macrotile_mode[16] = {
+   0x000000e8, /*  0: bank width 1, height 4, aspect 4, 16 banks */
+   0x000000d4, /*  1: height 2, aspect 2, 16 banks */
+   0x000000d0, /*  2: height 1, aspect 2, 16 banks */
+   0x000000d0, /*  3 */
+   0x00000080, /*  4: 8 banks */
+   0x00000040, /*  5: 4 banks */
+   0x00000000, /*  6: 2 banks */
+   0x00000000, /*  7 */
+   0x000000ec, /*  8: height 8, aspect 4, 16 banks */
+   0x000000e8, /*  9 */
+   0x000000d4, /* 10 */
+   0x000000d0, /* 11 */
+   0x00000080, /* 12 */
+   0x00000040, /* 13 */
+   0x00000000, /* 14 */
