diff --git a/src/util/futex.c b/src/util/futex.c
index df3e949..ccb5871 100644
--- a/src/util/futex.c
+++ b/src/util/futex.c
@@ -63,6 +63,7 @@ int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
 #include <fcntl.h>
 #include <sys/types.h>
 #include <sys/umtx.h>
+#include <time.h>
 
 int futex_wake(uint32_t *addr, int32_t count)
 {
@@ -70,6 +71,34 @@ int futex_wake(uint32_t *addr, int32_t count)
    return _umtx_op(addr, UMTX_OP_WAKE, (uint32_t)count, NULL, NULL) == -1 ? errno : 0;
 }
 
+#if defined(__ORBIS__)
+
+/* The PS4 runs a FreeBSD 9 kernel, whose UMTX_OP_WAIT_UINT takes a relative timeout. */
+int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
+{
+   struct timespec relative, now;
+
+   assert(value == (int)(uint32_t)value); /* Check that bits weren't discarded */
+
+   if (timeout != NULL) {
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      relative.tv_sec = timeout->tv_sec - now.tv_sec;
+      relative.tv_nsec = timeout->tv_nsec - now.tv_nsec;
+      if (relative.tv_nsec < 0) {
+         relative.tv_sec--;
+         relative.tv_nsec += 1000000000;
+      }
+      if (relative.tv_sec < 0) {
+         errno = ETIMEDOUT;
+         return -1;
+      }
+   }
+
+   return _umtx_op(addr, UMTX_OP_WAIT_UINT, (uint32_t)value, NULL, timeout ? &relative : NULL);
+}
+
+#else
+
 int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
 {
    void *uaddr = NULL, *uaddr2 = NULL;
@@ -89,6 +118,8 @@ int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
    return _umtx_op(addr, UMTX_OP_WAIT_UINT, (uint32_t)value, uaddr, uaddr2) == -1 ? errno : 0;
 }
 
+#endif /* __ORBIS__ */
+
 #elif defined(__OpenBSD__)
 
 #include <sys/futex.h>
diff --git a/src/util/memstream.c b/src/util/memstream.c
index bd909b7..dbcb88f 100644
--- a/src/util/memstream.c
+++ b/src/util/memstream.c
@@ -63,6 +63,17 @@ u_memstream_open(struct u_memstream *mem, char **bufp, size_t *sizep)
    }
 
    return success;
+#elif defined(U_MEMSTREAM_TMPFILE)
+   FILE *const f = tmpfile();
+   if (!f)
+      return false;
+
+   *bufp = NULL;
+   *sizep = 0;
+   mem->f = f;
+   mem->bufp = bufp;
+   mem->sizep = sizep;
+   return true;
 #else
    FILE *const f = open_memstream(bufp, sizep);
    mem->f = f;
@@ -70,7 +81,7 @@ u_memstream_open(struct u_memstream *mem, char **bufp, size_t *sizep)
 #endif
 }
 
-#ifdef _WIN32
+#ifdef U_MEMSTREAM_TMPFILE
 static void
 u_memstream_update_buffer(struct u_memstream *mem)
 {
@@ -84,18 +95,22 @@ u_memstream_update_buffer(struct u_memstream *mem)
       fseek(f, 0, SEEK_SET);
       fread(*mem->bufp, 1, size, f);
       (*mem->bufp)[size] = '\0';
+   } else if (*mem->bufp == NULL) {
+      *mem->bufp = calloc(1, 1);
    }
    *mem->sizep = size;
 }
-#endif /* _WIN32 */
+#endif /* U_MEMSTREAM_TMPFILE */
 
 void
 u_memstream_close(struct u_memstream *mem)
 {
    FILE *const f = mem->f;
 
-#ifdef _WIN32
+#ifdef U_MEMSTREAM_TMPFILE
    u_memstream_update_buffer(mem);
+#endif
+#ifdef _WIN32
    remove(mem->temp);
 #endif
 
@@ -105,10 +120,10 @@ u_memstream_close(struct u_memstream *mem)
 int
 u_memstream_flush(struct u_memstream *mem)
 {
-#ifndef _WIN32
+#ifndef U_MEMSTREAM_TMPFILE
    return fflush(mem->f);
 #else
    u_memstream_update_buffer(mem);
    return 0;
-#endif /* _WIN32 */
+#endif /* U_MEMSTREAM_TMPFILE */
 }
