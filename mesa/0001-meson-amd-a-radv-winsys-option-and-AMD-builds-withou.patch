From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?John=20T=C3=B6rnblom?= <john.tornblom@gmail.com>
Date: Sat, 17 Oct 2026 15:34:58 +0000
Subject: [PATCH 01/13] meson, amd: a radv-winsys option, and AMD builds
 without DRM

-Dradv-winsys selects the kernel interface RADV allocates memory and
submits through: amdgpu (Linux DRM, the default) or ps4 (the PlayStation
4's Gnm driver, which a later patch adds).

The PS4 has no DRM and its libc no libdrm, so the ps4 console build does
not look for either. AMD_NO_DRM marks the code the Windows port already
keeps away from DRM -- the DRM fourcc and tiling definitions, the
drmGetCap/drmGetDevice2 stubs in ac_gpu_info.c, ac_linux_drm.c, the DRM
node bookkeeping of the physical device, the umr ring dump -- and
headless swapchains use CPU images without libdrm. A Linux host build of
the PS4 winsys keeps DRM for the rest of Mesa.

Co-authored-by: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01R3DbSodVLhQVcvZSazbPue
---
 meson.build                            | 24 +++++++++++++++++++++++-
 meson.options                          | 10 ++++++++++
 src/amd/common/ac_drm_fourcc.h         |  9 +++++++--
 src/amd/common/ac_gpu_info.c           |  7 ++++++-
 src/amd/common/ac_linux_drm.h          | 10 +++++-----
 src/amd/common/ac_surface.c            |  2 +-
 src/amd/common/meson.build             |  2 +-
 src/amd/vulkan/radv_physical_device.c  | 12 ++++++------
 src/amd/vulkan/radv_physical_device.h  |  4 ++--
 src/amd/vulkan/tools/radv_debug_hang.c |  2 +-
 src/vulkan/wsi/wsi_common_headless.c   |  8 ++++++++
 11 files changed, 70 insertions(+), 20 deletions(-)

diff --git a/meson.build b/meson.build
index d6e3a8b..104ca03 100644
--- a/meson.build
+++ b/meson.build
@@ -339,6 +339,13 @@ if freedreno_kmds.length() != 0 and freedreno_kmds != [ 'msm' ] and with_freedre
   endif
 endif
 
+# RADV on the PlayStation 4 reaches the GPU through Gnm, beside a FreeBSD-based
+# libc that has no DRM, so nothing may look for libdrm there. (A Linux host
+# build of the same winsys keeps DRM for the rest of Mesa.)
+if _vulkan_drivers.contains('amd') and get_option('radv-winsys') == 'ps4' and host_machine.system() != 'linux'
+  system_has_kms_drm = false
+endif
+
 # This has to be below the freedreno_kmds check since that can change system_has_kms_drm
 with_gallium_kmsro = with_gallium_drm or (system_has_kms_drm and with_gallium_zink)
 
@@ -488,6 +495,21 @@ with_platform_haiku = _platforms.contains('haiku')
 with_platform_windows = _platforms.contains('windows')
 with_platform_macos = _platforms.contains('macos')
 
+# RADV on the PlayStation 4: no DRM device, no libdrm, a winsys of its own
+# (src/amd/vulkan/winsys/ps4). AMD_NO_DRM marks the code the Windows port
+# already keeps away from DRM, which the PS4 build has to skip the same way.
+with_radv_ps4 = with_amd_vk and get_option('radv-winsys') == 'ps4'
+amd_no_drm = with_platform_windows or with_radv_ps4
+if amd_no_drm
+  pre_args += '-DAMD_NO_DRM'
+endif
+if with_radv_ps4
+  pre_args += '-DRADV_PS4'
+endif
+# The console build, as opposed to a Linux host build of the PS4 winsys, which
+# models the console on a PC.
+with_radv_ps4_console = with_radv_ps4 and host_machine.system() != 'linux'
+
 with_gfxstream_emulated_android = with_gfxstream_vk and with_platform_android and host_machine.system() == 'linux'
 if with_gfxstream_emulated_android
   # When building the android_stub with a non-Bionic sysroot/target, we to have
@@ -1897,7 +1919,7 @@ _drm_ver = '2.4.109'
 
 _libdrm_checks = [
   ['intel', with_gallium_i915],
-  ['amdgpu', (with_amd_vk and not with_platform_windows) or with_gallium_radeonsi],
+  ['amdgpu', (with_amd_vk and not amd_no_drm) or with_gallium_radeonsi],
 ]
 
 # Loop over the enables versions and get the highest libdrm requirement for all
diff --git a/meson.options b/meson.options
index 93a60e3..9f84266 100644
--- a/meson.options
+++ b/meson.options
@@ -751,6 +751,16 @@ option(
   description : 'build gallium d3d12 with graphics pipeline support.',
 )
 
+option(
+  'radv-winsys',
+  type : 'combo',
+  value : 'amdgpu',
+  choices : ['amdgpu', 'ps4'],
+  description : 'The kernel interface RADV allocates memory and submits ' +
+                'through: amdgpu (Linux DRM) or ps4 (the PlayStation 4 ' +
+                'Gnm driver, reached through its exported functions).'
+)
+
 option(
   'radv-build-id',
   type : 'string',
diff --git a/src/amd/common/ac_drm_fourcc.h b/src/amd/common/ac_drm_fourcc.h
index 9ef1406..7367885 100644
--- a/src/amd/common/ac_drm_fourcc.h
+++ b/src/amd/common/ac_drm_fourcc.h
@@ -7,14 +7,19 @@
 #ifndef AC_DRM_FOURCC_H
 #define AC_DRM_FOURCC_H
 
-#ifdef _WIN32
+#if defined(_WIN32) || defined(AMD_NO_DRM)
 #include <stdint.h>
+/* Linux headers define __u64; elsewhere it is this. */
+#if defined(__linux__)
+#include <linux/types.h>
+#else
 typedef uint64_t __u64;
+#endif
 #define DRM_FORMAT_MOD_VENDOR_NONE    0
 #define DRM_FORMAT_MOD_VENDOR_AMD     0x02
 #define DRM_FORMAT_RESERVED	      ((1ULL << 56) - 1)
 #define fourcc_mod_code(vendor, val) \
-	((((__u64)DRM_FORMAT_MOD_VENDOR_## vendor) << 56) | ((val) & 0x00ffffffffffffffULL))
+	((((uint64_t)DRM_FORMAT_MOD_VENDOR_## vendor) << 56) | ((val) & 0x00ffffffffffffffULL))
 #define DRM_FORMAT_MOD_INVALID	fourcc_mod_code(NONE, DRM_FORMAT_RESERVED)
 #define DRM_FORMAT_MOD_LINEAR	fourcc_mod_code(NONE, 0)
 #define AMD_FMT_MOD fourcc_mod_code(AMD, 0)
