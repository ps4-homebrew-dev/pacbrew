export PS4_HOMEBREW_SDK="${PS4_HOMEBREW_SDK:-/opt/ps4-homebrew-sdk}"

prepare() {
    cd "${srcdir}/mesa-${pkgver}"

    local p
    for p in "${srcdir}"/[0-9][0-9][0-9][0-9]-*.patch; do
	echo "Applying $(basename "$p")"
	patch -Np1 -i "$p"
    done
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd mesa-${pkgver}

    # RADV names its shader cache after this id: it changes with Mesa's
    # version and with the patches.
    local build_id
    build_id=$(cat <(echo "${pkgver}") "${srcdir}"/[0-9][0-9][0-9][0-9]-*.patch \
		   | sha1sum | cut -d' ' -f1)

    # Vulkan (RADV), presenting with VK_KHR_display on VideoOut, and OpenGL
    # (ES) through EGL on zink, which draws with that RADV and presents to
    # the same display (the videoout platform).
    ${MESON} setup builddir \
	     -Ddefault_library=shared \
	     -Dbuildtype=debugoptimized \
	     -Db_ndebug=true \
	     -Dradv-build-id=${build_id} \
	     -Dradv-winsys=ps4 \
	     -Dvulkan-drivers=amd \
	     -Dvulkan-layers= \
	     -Dgallium-drivers=zink \
	     -Dplatforms=videoout \
	     -Degl-native-platform=videoout \
	     -Degl=enabled \
	     -Dopengl=true \
	     -Dgles2=enabled \
	     -Dgles1=disabled \
	     -Dglx=disabled \
	     -Dgbm=disabled \
	     -Dglvnd=disabled \
	     -Dmesa-clc=auto \
	     -Dllvm=disabled \
	     -Dzstd=disabled \
	     -Dzlib=enabled \
	     -Dshader-cache=enabled \
	     -Dvalgrind=disabled \
	     -Dlibunwind=disabled \
	     -Dexpat=disabled \
	     -Dxmlconfig=disabled \
	     -Dvideo-codecs= \
	     -Dbuild-tests=false

    ${MESON} compile -C builddir
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd mesa-${pkgver}

    ${MESON} install -C builddir --destdir "${pkgdir}/${SYSROOT}"
}
