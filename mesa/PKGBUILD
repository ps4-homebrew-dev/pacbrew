pkgname=ps4-homebrew-mesa
pkgver=26.2.0
pkgrel=11
pkgdesc="Open-source Vulkan and OpenGL drivers for the PS4 (RADV, VK_KHR_display on VideoOut; zink, EGL, OpenGL and OpenGL ES on it)"
url="https://www.mesa3d.org/"
arch=('any')
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
options=(!strip !libtool staticlibs)
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-libcxx' 'ps4-homebrew-zlib')

source=("https://mesa.freedesktop.org/archive/mesa-${pkgver}.tar.xz"
	"0001-build-add-Dradv-winsys-ps4-and-build-the-AMD-code-wi.patch"
	"0002-util-vulkan-support-the-PS4-s-libc-and-FreeBSD-9-ker.patch"
	"0003-util-disk_cache-shader-cache-support-for-the-PS4.patch"
	"0004-radv-handle-winsyses-without-some-amdgpu-capabilitie.patch"
	"0005-ac-radv-work-around-PS4-GPU-and-firmware-differences.patch"
	"0006-radv-let-the-winsys-split-long-command-streams.patch"
	"0007-radv-add-a-PS4-winsys.patch"
	"0008-vulkan-wsi-VK_KHR_display-on-the-PS4-s-VideoOut.patch"
	"0009-zink-support-VK_KHR_display-surfaces.patch"
	"0010-zink-destroy-the-resource-object-s-copy-lock.patch"
	"0011-egl-add-the-videoout-platform.patch"
	"0012-glapi-a-libGL-without-GLX-for-the-videoout-platform.patch")

