prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
    
    cd "${srcdir}/mesa-${pkgver}"

    local p
    for p in "${srcdir}"/[0-9][0-9][0-9][0-9]-*.patch; do
	echo "Applying $(basename "$p")"
	patch -Np1 -i "$p"
    done
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd mesa-${pkgver}

    local build_id
    build_id=$(cat <(echo "${pkgver}") "${srcdir}"/[0-9][0-9][0-9][0-9]-*.patch \
		   | sha1sum | cut -d' ' -f1)

    # Vulkan only, without a WSI, until the VideoOut WSI (the PS5's 0011)
    # and zink/EGL are brought to the PS4. Unlike the PS5's, this build
    # needs no host mesa_clc: nothing in it is written in OpenCL C.
    ${MESON} setup builddir \
	     -Ddefault_library=shared \
	     -Dbuildtype=debugoptimized \
	     -Db_ndebug=true \
	     -Dradv-build-id=${build_id} \
	     -Dradv-winsys=ps4 \
	     -Dvulkan-drivers=amd \
	     -Dvulkan-layers= \
	     -Dgallium-drivers= \
	     -Dplatforms= \
	     -Degl=disabled \
	     -Dopengl=false \
	     -Dgles2=disabled \
	     -Dgles1=disabled \
	     -Dglx=disabled \
	     -Dgbm=disabled \
	     -Dmesa-clc=auto \
	     -Dllvm=disabled \
	     -Dzstd=disabled \
	     -Dzlib=enabled \
	     -Dshader-cache=enabled \
	     -Dvalgrind=disabled \
	     -Dlibunwind=disabled \
	     -Dexpat=disabled \
	     -Dxmlconfig=disabled \
	     -Dvideo-codecs= \
	     -Dbuild-tests=false

    ${MESON} compile -C builddir
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd mesa-${pkgver}

    ${MESON} install -C builddir --destdir "${pkgdir}/${SYSROOT}"
}
