pkgname=ps4-homebrew-mesa
pkgver=26.2.0
pkgrel=8
pkgdesc="Open-source Vulkan and OpenGL drivers for the PS4 (RADV, VK_KHR_display on VideoOut; zink, EGL and OpenGL ES on it)"
url="https://www.mesa3d.org/"
arch=('any')
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
options=(!strip !libtool staticlibs)
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-libcxx' 'ps4-homebrew-zlib')

source=("https://mesa.freedesktop.org/archive/mesa-${pkgver}.tar.xz"
	"0001-meson-amd-a-radv-winsys-option-and-AMD-builds-withou.patch"
