	"0003-util-disk_cache-a-shader-cache-in-a-PS4-title-s-fold.patch"
	"0004-ac-leave-the-raster-config-to-the-kernel-where-it-se.patch"
	"0005-amd-addrlib-no-AVX2-swizzlers-in-the-PS4-console-bui.patch"
	"0006-radv-report-only-what-the-winsys-can-do.patch"
	"0007-radv-a-compute-and-transfer-queue-family-on-the-grap.patch"
	"0008-radv-let-the-winsys-split-a-long-command-stream.patch"
	"0009-radv-pipeline-representations-that-were-not-recorded.patch"
	"0010-radv-vulkan-util-RADV-is-the-PS4-s-libvulkan.so.1.patch"
	"0011-radv-a-PS4-winsys-on-Gnm.patch"
