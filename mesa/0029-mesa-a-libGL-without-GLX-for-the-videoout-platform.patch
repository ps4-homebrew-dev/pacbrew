From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?John=20T=C3=B6rnblom?= <john.tornblom@gmail.com>
Date: Fri, 23 Oct 2026 15:44:50 +0000
Subject: [PATCH 29/30] mesa: a libGL without GLX for the videoout platform

Desktop GL software expects a libGL.so.1: it links the GL entry points
from it, or opens it and asks glXGetProcAddressARB for them, as glad's
built-in loader (RmlUi's GL3 renderer) and GLEW do, and CMake's
FindOpenGL and meson's dependency('gl') look for it. Mesa builds libGL
only with GLX, which the PS4 does not have, so such programs failed to
load OpenGL at all.

On the videoout platform without GLX, Mesa now builds a libGL.so.1 of
libglapi_bridge's entry points -- those of GLX's libGL, dispatching to
the context made current through EGL, through calls on the PS4 ("glapi:
the current dispatch and context through calls on the PS4") -- and
glXGetProcAddress and glXGetProcAddressARB, which are eglGetProcAddress.
gl.pc names it. Nothing else of GLX is provided: a program still makes
its context through EGL, or SDL.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Bb93U7uY5qVNuEcHDggEfE
---
 src/mesa/glapi/libgl-egl/libgl_egl.c | 37 ++++++++++++++++++++++++++++
 src/mesa/glapi/libgl-egl/meson.build | 24 ++++++++++++++++++
 src/meson.build                      |  6 +++++
 3 files changed, 67 insertions(+)
 create mode 100644 src/mesa/glapi/libgl-egl/libgl_egl.c
 create mode 100644 src/mesa/glapi/libgl-egl/meson.build

diff --git a/src/mesa/glapi/libgl-egl/libgl_egl.c b/src/mesa/glapi/libgl-egl/libgl_egl.c
new file mode 100644
index 0000000..730ba1c
--- /dev/null
+++ b/src/mesa/glapi/libgl-egl/libgl_egl.c
@@ -0,0 +1,37 @@
+/*
+ * Copyright © 2026 John Törnblom
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+/* libGL.so.1 on an EGL platform without GLX (the PS4's videoout).
+ *
+ * Desktop GL software expects a libGL: it links the GL entry points from it,
+ * or opens it and asks glXGetProcAddressARB for them, as glad's loader and
+ * GLEW do. There is no window system and so no GLX here, but the entry points
+ * are libglapi_bridge's, as in GLX's libGL, dispatching to the context the
+ * program made current through EGL, and glXGetProcAddress(ARB) is
+ * eglGetProcAddress. Nothing else of GLX is provided.
+ */
+
+#include "util/macros.h"
+
+typedef void (*libgl_proc)(void);
+
+/* EGL/egl.h and GL/glx.h are left out: neither's platform types are needed
+ * here, and GLX's would need X11's. */
+libgl_proc eglGetProcAddress(const char *procname);
+PUBLIC libgl_proc glXGetProcAddressARB(const unsigned char *name);
+PUBLIC libgl_proc glXGetProcAddress(const unsigned char *name);
+
+PUBLIC libgl_proc
+glXGetProcAddressARB(const unsigned char *name)
+{
+   return eglGetProcAddress((const char *)name);
+}
+
+PUBLIC libgl_proc
+glXGetProcAddress(const unsigned char *name)
+{
+   return eglGetProcAddress((const char *)name);
+}
diff --git a/src/mesa/glapi/libgl-egl/meson.build b/src/mesa/glapi/libgl-egl/meson.build
new file mode 100644
index 0000000..f19f165
--- /dev/null
+++ b/src/mesa/glapi/libgl-egl/meson.build
@@ -0,0 +1,24 @@
+# Copyright © 2026 John Törnblom
+# SPDX-License-Identifier: MIT
+
+# libGL.so.1 without GLX, for EGL platforms that have no window system
+# (videoout): the GL entry points and glXGetProcAddress(ARB) over EGL.
+libgl = shared_library(
+  'GL',
+  ['libgl_egl.c'],
+  link_whole : [libglapi_bridge],
+  link_with : [shared_glapi_lib, libegl],
+  link_args : [ld_args_gc_sections],
+  include_directories : [inc_include, inc_src],
+  dependencies : [dep_thread, dep_m, dep_dl],
+  version : '1.2.0',
+  install : true,
+)
+
+pkg.generate(
+  name : 'gl',
+  description : 'Mesa OpenGL Library (GL entry points over EGL, without GLX)',
+  version : meson.project_version(),
+  libraries : libgl,
+  libraries_private : gl_priv_libs,
+)
diff --git a/src/meson.build b/src/meson.build
index c36f44b..63428d1 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -160,6 +160,12 @@ endif
 if with_egl
   subdir('egl')
 endif
+# Without GLX, an EGL platform with no window system (videoout) still gives
+# desktop GL software its libGL: the entry points, and glXGetProcAddress(ARB)
+# over EGL.
+if with_platform_videoout and with_opengl and with_egl and with_glx == 'disabled' and not with_glvnd
+  subdir('mesa/glapi/libgl-egl')
+endif
 if with_gallium
   if with_glx == 'dri' or with_platform_x11
     subdir('gallium/targets/dril')
