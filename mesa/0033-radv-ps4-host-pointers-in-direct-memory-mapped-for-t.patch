    return radv_ps4_neo;
 }
 
+bool
+radv_ps4_memory_gpu_mapped(const void *address, uint64_t bytes)
+{
+   /* Walk the mappings the range spans: each must give the GPU read and
+    * write access. */
+   const uint8_t *at = address;
+   const uint8_t *const end = at + bytes;
+   if ((uint64_t)(uintptr_t)address >= RADV_PS4_GPU_ADDRESS_LIMIT ||
+       bytes > RADV_PS4_GPU_ADDRESS_LIMIT - (uint64_t)(uintptr_t)address)
+      return false;
+   while (at < end) {
+      struct ps4_kernel_virtual_query_info query;
+      if (sceKernelVirtualQuery(at, 0, &query, sizeof(query)) != 0)
+         return false;
+      if ((query.protection & (PS4_KERNEL_PROT_GPU_READ | PS4_KERNEL_PROT_GPU_WRITE)) !=
+             (PS4_KERNEL_PROT_GPU_READ | PS4_KERNEL_PROT_GPU_WRITE) ||
+          (const uint8_t *)query.start > at || (const uint8_t *)query.end <= at)
+         return false;
+      at = query.end;
+   }
+   return true;
+}
+
 uint64_t
 radv_ps4_memory_pool_bytes(void)
 {
@@ -391,6 +414,15 @@ radv_ps4_platform_is_neo(void)
    return false;
 }
 
+bool
+radv_ps4_memory_gpu_mapped(const void *address, uint64_t bytes)
+{
+   /* The model runs no GPU work: any memory will do. */
+   (void)address;
+   (void)bytes;
+   return true;
+}
+
 uint64_t
 radv_ps4_memory_pool_bytes(void)
 {
