 uint64_t radv_ps4_allocated_bytes;
 
@@ -90,6 +91,11 @@ radv_ps4_buffer_destroy(struct radeon_winsys *rws, struct radeon_winsys_bo *base
    struct radv_ps4_bo *const bo = radv_ps4_bo(base);
    if (!bo)
       return;
+   if (bo->imported) {
+      /* The memory stays the application's. */
+      free(bo);
+      return;
+   }
    p_atomic_add(&radv_ps4_allocated_bytes, -(int64_t)bo->memory.bytes);
    if (bo->base.initial_domain & RADEON_DOMAIN_VRAM)
       p_atomic_add(&ws->allocated_vram, -(int64_t)bo->memory.bytes);
@@ -134,13 +140,31 @@ static VkResult
 radv_ps4_buffer_from_ptr(struct radeon_winsys *rws, void *pointer, uint64_t size, unsigned priority,
                          struct radeon_winsys_bo **out_bo)
 {
-   (void)rws;
-   (void)pointer;
-   (void)size;
    (void)priority;
-   /* Only direct memory is the GPU's to reach (radeon_info.has_userptr). */
+   struct radv_ps4_winsys *const ws = radv_ps4_winsys(rws);
    *out_bo = NULL;
-   return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+
+   /* Memory the application owns, at the address the CPU uses: only direct
+    * memory mapped for the GPU, which the GPU reaches at that address. The
+    * PS4 grants no GPU access to other memory. */
+   const uint64_t va = (uint64_t)(uintptr_t)pointer;
+   if (!size || va % RADV_PS4_PAGE_BYTES || size % RADV_PS4_PAGE_BYTES || !radv_ps4_memory_gpu_mapped(pointer, size))
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+
+   struct radv_ps4_bo *const bo = calloc(1, sizeof(*bo));
+   if (!bo)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   bo->ws = ws;
+   bo->imported = true;
+   bo->memory = (struct radv_ps4_memory){.cpu = pointer, .bytes = size, .physical = -1, .fd = -1};
+   bo->base.va = va;
+   bo->base.size = size;
+   bo->base.is_local = false;
+   bo->base.use_global_list = true;
+   bo->base.initial_domain = RADEON_DOMAIN_GTT;
+   bo->base.obj_id = p_atomic_inc_return(&radv_ps4_next_obj_id);
+   *out_bo = &bo->base;
+   return VK_SUCCESS;
 }
 
 static VkResult
