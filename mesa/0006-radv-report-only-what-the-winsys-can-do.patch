+      .dynamicGeneratedPipelineLayout = pdev->info.has_gpu_written_ibs,
 
       /* VK_KHR_maintenance8 */
       .maintenance8 = true,
@@ -1655,7 +1655,7 @@ radv_physical_device_get_features(const struct radv_physical_device *pdev, struc
 
       /* VK_EXT_descriptor_heap */
