diff --git a/src/amd/common/ac_gpu_info.c b/src/amd/common/ac_gpu_info.c
index 837af8c..b9ca325 100644
--- a/src/amd/common/ac_gpu_info.c
+++ b/src/amd/common/ac_gpu_info.c
@@ -1062,6 +1062,8 @@ void ac_fill_feature_info(struct radeon_info *info, const struct drm_amdgpu_info
    info->r600_has_virtual_memory = true;
 
    info->has_userptr = !info->is_virtio;
+   info->has_gpu_written_ibs = true;
+   info->has_replayable_va = true;
    info->has_syncobj = true;
    info->has_fence_to_handle = true;
 
@@ -2059,6 +2061,8 @@ void ac_print_gpu_info(FILE *f, const struct radeon_info *info, int fd)
    fprintf(f, "Kernel & winsys capabilities:\n");
    fprintf(f, "    drm = %i.%i.%i\n", info->drm_major, info->drm_minor, info->drm_patchlevel);
    fprintf(f, "    has_userptr = %i\n", info->has_userptr);
+   fprintf(f, "    has_gpu_written_ibs = %i\n", info->has_gpu_written_ibs);
+   fprintf(f, "    has_replayable_va = %i\n", info->has_replayable_va);
    fprintf(f, "    has_timeline_syncobj = %u\n", info->has_timeline_syncobj);
    fprintf(f, "    has_vm_always_valid = %u\n", info->has_vm_always_valid);
    fprintf(f, "    has_eqaa_surface_allocator = %u\n", info->has_eqaa_surface_allocator);
diff --git a/src/amd/common/ac_gpu_info.h b/src/amd/common/ac_gpu_info.h
index 0f7ea3f..d94fcc7 100644
--- a/src/amd/common/ac_gpu_info.h
+++ b/src/amd/common/ac_gpu_info.h
@@ -371,6 +371,13 @@ struct radeon_info {
    bool is_amdgpu;
    bool is_virtio;
    bool has_userptr;
+   /* Whether the CP runs a command buffer the GPU wrote, chained with
+    * INDIRECT_BUFFER: device-generated commands need it. */
+   bool has_gpu_written_ibs;
+   /* Whether a buffer can be placed at the GPU address an earlier allocation
+    * was given (RADEON_FLAG_REPLAYABLE with a replay address): every capture
+    * and replay feature needs it. */
+   bool has_replayable_va;
    bool has_syncobj;
    bool has_timeline_syncobj;
    bool has_fence_to_handle;
diff --git a/src/amd/vulkan/radv_formats.c b/src/amd/vulkan/radv_formats.c
index 3b49974..09a4455 100644
--- a/src/amd/vulkan/radv_formats.c
+++ b/src/amd/vulkan/radv_formats.c
@@ -1199,6 +1199,8 @@ get_external_image_format_properties(struct radv_physical_device *pdev,
          break;
       FALLTHROUGH;
    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT:
+      if (!pdev->has_external_fd)
+         break;
       flags = VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT | VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT;
       if (handleType == VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT &&
           pImageFormatInfo->tiling != VK_IMAGE_TILING_LINEAR)
@@ -1567,12 +1569,15 @@ radv_GetPhysicalDeviceExternalBufferProperties(VkPhysicalDevice physicalDevice,
                                                const VkPhysicalDeviceExternalBufferInfo *pExternalBufferInfo,
                                                VkExternalBufferProperties *pExternalBufferProperties)
 {
+   VK_FROM_HANDLE(radv_physical_device, pdev, physicalDevice);
    VkExternalMemoryFeatureFlagBits flags = 0;
    VkExternalMemoryHandleTypeFlags export_flags = 0;
    VkExternalMemoryHandleTypeFlags compat_flags = 0;
    switch (pExternalBufferInfo->handleType) {
    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT:
    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT:
+      if (!pdev->has_external_fd)
+         break;
       flags = VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT | VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT;
       compat_flags = export_flags =
          VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT | VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
