@@ -2091,7 +2091,7 @@ radv_get_physical_device_properties(struct radv_physical_device *pdev)
       .maxDiscardRectangles = MAX_DISCARD_RECTANGLES,
 
       /* VK_EXT_external_memory_host */
-      .minImportedHostPointerAlignment = 4096,
