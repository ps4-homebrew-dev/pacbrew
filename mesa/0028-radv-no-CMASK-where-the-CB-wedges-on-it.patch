From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?John=20T=C3=B6rnblom?= <john.tornblom@gmail.com>
Date: Wed, 21 Oct 2026 20:59:58 +0000
Subject: [PATCH 28/28] radv: no CMASK where the CB wedges on it

On the PS4 the GPU stops on a colour surface with CMASK:

- "radv: no CMASK fast clear for a console display surface" found the
  swapchain image's CMASK wedging the frame body, on a clear and on a
  draw, and took CMASK off scanout surfaces only;
- the orbis-ports mesa-ps4 port found a 1024x1024 colour target with
  CMASK dying where the same surface without it, and surfaces below
  RADV's CMASK area threshold, passed (with SET_PREDICATION already
  out of the way);
- a libmpv player on zink hung the GPU on its very first submission,
  the one that initialises the CMASK of every new render target: zink
  creates GL textures as colour attachments, so the 1920x1080 video
  planes and render targets all had CMASK, where a Vulkan program that
  only draws to the swapchain has none.

radeon_info.has_cmask says whether the CB may use CMASK: set for amdgpu,
cleared by the PS4 winsys. Without it no image gets single-sample CMASK
(no fast colour clears; GFX6-7 have no DCC, and HTILE is unaffected),
and there is no FMASK, which needs CMASK, so MSAA is uncompressed. The
GNM renderers known to work on the console use neither.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Bb93U7uY5qVNuEcHDggEfE
---
 src/amd/common/ac_gpu_info.c                | 2 ++
 src/amd/common/ac_gpu_info.h                | 3 +++
 src/amd/vulkan/radv_image.c                 | 2 +-
 src/amd/vulkan/radv_physical_device.c       | 4 +++-
 src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c | 3 +++
 5 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/amd/common/ac_gpu_info.c b/src/amd/common/ac_gpu_info.c
index 522c864..7a2fa7f 100644
--- a/src/amd/common/ac_gpu_info.c
+++ b/src/amd/common/ac_gpu_info.c
@@ -1067,6 +1067,7 @@ void ac_fill_feature_info(struct radeon_info *info, const struct drm_amdgpu_info
    info->has_replayable_va = true;
    info->has_set_predication = true;
    info->has_draw_indirect_multi = true;
+   info->has_cmask = true;
    info->has_syncobj = true;
    info->has_fence_to_handle = true;
 
@@ -2068,6 +2069,7 @@ void ac_print_gpu_info(FILE *f, const struct radeon_info *info, int fd)
    fprintf(f, "    has_replayable_va = %i\n", info->has_replayable_va);
    fprintf(f, "    has_set_predication = %i\n", info->has_set_predication);
    fprintf(f, "    has_draw_indirect_multi = %i\n", info->has_draw_indirect_multi);
+   fprintf(f, "    has_cmask = %i\n", info->has_cmask);
    fprintf(f, "    has_timeline_syncobj = %u\n", info->has_timeline_syncobj);
    fprintf(f, "    has_vm_always_valid = %u\n", info->has_vm_always_valid);
    fprintf(f, "    has_eqaa_surface_allocator = %u\n", info->has_eqaa_surface_allocator);
diff --git a/src/amd/common/ac_gpu_info.h b/src/amd/common/ac_gpu_info.h
index 942e140..db3f71c 100644
--- a/src/amd/common/ac_gpu_info.h
+++ b/src/amd/common/ac_gpu_info.h
@@ -390,6 +390,9 @@ struct radeon_info {
     * indirect draws, or a count read from memory, in one packet. The PS4's
     * hangs on it. */
    bool has_draw_indirect_multi;
+   /* GFX6-10: whether the CB may use CMASK, and FMASK with it: fast color
+    * clears and MSAA compression. The PS4's wedges on a CMASK surface. */
+   bool has_cmask;
    bool has_syncobj;
    bool has_timeline_syncobj;
    bool has_fence_to_handle;
diff --git a/src/amd/vulkan/radv_image.c b/src/amd/vulkan/radv_image.c
index 3b5fcf0..19c1bcf 100644
--- a/src/amd/vulkan/radv_image.c
+++ b/src/amd/vulkan/radv_image.c
@@ -848,7 +848,7 @@ radv_image_alloc_single_sample_cmask(const struct radv_device *device, const str
    if (!surf->cmask_size || surf->cmask_offset || surf->bpe > 8 || image->vk.mip_levels > 1 ||
        image->vk.extent.depth > 1 || radv_image_has_dcc(image) || !radv_image_use_fast_clear_for_image(device, image) ||
        (image->vk.create_flags & VK_IMAGE_CREATE_2_SPARSE_BINDING_BIT_KHR) ||
-       (image->vk.usage & VK_IMAGE_USAGE_2_HOST_TRANSFER_BIT_KHR) ||
+       (image->vk.usage & VK_IMAGE_USAGE_2_HOST_TRANSFER_BIT_KHR) || !pdev->info.has_cmask ||
        /* A console display scans out raw pixels, and there is no kernel or
         * compositor to resolve compression on a flip: a scanout surface gets
         * no CMASK, so neither a CMASK fast clear nor the compressed rendering
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index fa9d8cf..be8e59c 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -2721,7 +2721,9 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
 
    pdev->dcc_msaa_allowed = (instance->perftest_flags & RADV_PERFTEST_DCC_MSAA);
 
-   pdev->use_fmask = pdev->info.compiler_info.has_fmask && !(instance->debug_flags & RADV_DEBUG_NO_FMASK);
+   /* FMASK compression needs CMASK. */
+   pdev->use_fmask = pdev->info.compiler_info.has_fmask && pdev->info.has_cmask &&
+                     !(instance->debug_flags & RADV_DEBUG_NO_FMASK);
 
    pdev->force_64_byte_sampled_image = !pdev->use_fmask && instance->drirc.debug.force_64_byte_sampled_image;
 
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
index f479e03..bfc5713 100644
--- a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
@@ -376,6 +376,9 @@ radv_ps4_describe_gpu(struct radeon_info *info, bool compiler_compat_mode)
     * DRAW_(INDEX_)INDIRECT_MULTI. */
    info->has_set_predication = false;
    info->has_draw_indirect_multi = false;
+   /* The CB wedges on a surface with CMASK: no fast color clears, and MSAA
+    * without FMASK. */
+   info->has_cmask = false;
    /* One pool of memory the CPU and the GPU share, which RADV presents as an
     * integrated GPU's. */
    info->has_dedicated_vram = false;
