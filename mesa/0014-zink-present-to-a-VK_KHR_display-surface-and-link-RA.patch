+/**
+ * A display surface (VK_KHR_display), for a loader with no window system
+ * (EGL's videoout platform). Its sType is VK_STRUCTURE_TYPE_DISPLAY_SURFACE_
+ * CREATE_INFO_KHR, but it is not a VkDisplaySurfaceCreateInfoKHR, which does
+ * not fit the storage: the loader names the display and zink, which can ask
+ * Vulkan, picks its plane and mode. window is the loader's handle for the
+ * surface; drawables with the same one share a swapchain.
+ */
+struct kopper_display_surface_create_info {
+   VkStructureType sType;
+   const void *pNext;
+   uintptr_t window;
+   uint32_t display_index;
+};
