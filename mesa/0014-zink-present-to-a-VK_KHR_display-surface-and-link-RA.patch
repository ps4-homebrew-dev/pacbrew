+      break;
+   }
 #endif
    default:
       UNREACHABLE("unsupported!");
@@ -313,6 +486,7 @@ kopper_CreateSwapchain(struct zink_screen *screen, struct kopper_displaytarget *
    switch (cdt->type) {
    case KOPPER_X11:
    case KOPPER_WIN32:
+   case KOPPER_DISPLAY:
       /* With Xcb, minImageExtent, maxImageExtent, and currentExtent must always equal the window size.
        * ...
        * Due to above restrictions, it is only possible to create a new swapchain on this
@@ -444,6 +618,7 @@ zink_kopper_displaytarget_create(struct zink_screen *screen, unsigned tex_usage,
             break;
          case KOPPER_WAYLAND:
          case KOPPER_WIN32:
+         case KOPPER_DISPLAY:
             _mesa_hash_table_init(&screen->dts, screen, _mesa_hash_pointer, _mesa_key_pointer_equal);
             break;
          default:
@@ -515,6 +690,14 @@ zink_kopper_displaytarget_create(struct zink_screen *screen, unsigned tex_usage,
       _mesa_hash_table_insert(&screen->dts, win32->hwnd, cdt);
       break;
    }
+#endif
+#ifdef VK_USE_PLATFORM_DISPLAY_KHR
+   case KOPPER_DISPLAY: {
+      const struct kopper_display_surface_create_info *dsci =
+         (const struct kopper_display_surface_create_info *)&cdt->info.bos;
+      _mesa_hash_table_insert(&screen->dts, (void *)dsci->window, cdt);
+      break;
+   }
 #endif
    default:
       UNREACHABLE("unsupported!");
