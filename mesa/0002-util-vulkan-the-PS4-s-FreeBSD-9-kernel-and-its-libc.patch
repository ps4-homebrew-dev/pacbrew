diff --git a/src/util/futex.c b/src/util/futex.c
index df3e949..c1bf144 100644
--- a/src/util/futex.c
+++ b/src/util/futex.c
@@ -63,6 +63,7 @@ int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
 #include <fcntl.h>
 #include <sys/types.h>
 #include <sys/umtx.h>
+#include <time.h>
 
 int futex_wake(uint32_t *addr, int32_t count)
 {
@@ -70,6 +71,36 @@ int futex_wake(uint32_t *addr, int32_t count)
    return _umtx_op(addr, UMTX_OP_WAKE, (uint32_t)count, NULL, NULL) == -1 ? errno : 0;
 }
 
+#if defined(__ORBIS__)
+
+/* The PS4's kernel is FreeBSD 9's, whose UMTX_OP_WAIT_UINT takes a relative
+ * timeout as a struct timespec (struct _umtx_time came with FreeBSD 10).
+ * Like Linux's, it fails with -1 and errno, as the callers expect. */
+int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
+{
+   struct timespec relative, now;
+
+   assert(value == (int)(uint32_t)value); /* Check that bits weren't discarded */
+
+   if (timeout != NULL) {
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      relative.tv_sec = timeout->tv_sec - now.tv_sec;
+      relative.tv_nsec = timeout->tv_nsec - now.tv_nsec;
+      if (relative.tv_nsec < 0) {
+         relative.tv_sec--;
+         relative.tv_nsec += 1000000000;
+      }
+      if (relative.tv_sec < 0) {
+         errno = ETIMEDOUT;
+         return -1;
+      }
+   }
+
+   return _umtx_op(addr, UMTX_OP_WAIT_UINT, (uint32_t)value, NULL, timeout ? &relative : NULL);
+}
+
+#else
+
 int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
 {
    void *uaddr = NULL, *uaddr2 = NULL;
@@ -89,6 +120,8 @@ int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
    return _umtx_op(addr, UMTX_OP_WAIT_UINT, (uint32_t)value, uaddr, uaddr2) == -1 ? errno : 0;
 }
 
+#endif /* __ORBIS__ */
+
 #elif defined(__OpenBSD__)
 
 #include <sys/futex.h>
diff --git a/src/util/memstream.c b/src/util/memstream.c
index bd909b7..743b4be 100644
--- a/src/util/memstream.c
+++ b/src/util/memstream.c
@@ -63,6 +63,17 @@ u_memstream_open(struct u_memstream *mem, char **bufp, size_t *sizep)
    }
 
    return success;
+#elif defined(U_MEMSTREAM_TMPFILE)
+   FILE *const f = tmpfile();
+   if (!f)
+      return false;
+
+   *bufp = NULL;
+   *sizep = 0;
+   mem->f = f;
+   mem->bufp = bufp;
+   mem->sizep = sizep;
+   return true;
 #else
    FILE *const f = open_memstream(bufp, sizep);
    mem->f = f;
@@ -70,7 +81,7 @@ u_memstream_open(struct u_memstream *mem, char **bufp, size_t *sizep)
 #endif
 }
 
-#ifdef _WIN32
+#ifdef U_MEMSTREAM_TMPFILE
 static void
 u_memstream_update_buffer(struct u_memstream *mem)
 {
@@ -84,18 +95,23 @@ u_memstream_update_buffer(struct u_memstream *mem)
       fseek(f, 0, SEEK_SET);
       fread(*mem->bufp, 1, size, f);
       (*mem->bufp)[size] = '\0';
+   } else if (*mem->bufp == NULL) {
+      /* As open_memstream, an empty stream is an empty string. */
+      *mem->bufp = calloc(1, 1);
    }
    *mem->sizep = size;
 }
-#endif /* _WIN32 */
+#endif /* U_MEMSTREAM_TMPFILE */
 
 void
 u_memstream_close(struct u_memstream *mem)
 {
    FILE *const f = mem->f;
 
-#ifdef _WIN32
+#ifdef U_MEMSTREAM_TMPFILE
    u_memstream_update_buffer(mem);
+#endif
+#ifdef _WIN32
    remove(mem->temp);
 #endif
 
@@ -105,10 +121,10 @@ u_memstream_close(struct u_memstream *mem)
 int
 u_memstream_flush(struct u_memstream *mem)
 {
-#ifndef _WIN32
+#ifndef U_MEMSTREAM_TMPFILE
    return fflush(mem->f);
 #else
    u_memstream_update_buffer(mem);
    return 0;
-#endif /* _WIN32 */
+#endif /* U_MEMSTREAM_TMPFILE */
 }
diff --git a/src/util/memstream.h b/src/util/memstream.h
index 42f374c..9a9d70e 100644
--- a/src/util/memstream.h
+++ b/src/util/memstream.h
@@ -43,12 +43,20 @@
 extern "C" {
 #endif
 
+/* Without open_memstream (Windows, the PlayStation 4's libc), the stream is a
+ * temporary file, read back into the buffer at flush and close. */
+#if defined(_WIN32) || !defined(HAVE_OPEN_MEMSTREAM)
+#define U_MEMSTREAM_TMPFILE 1
+#endif
+
 struct u_memstream
 {
    FILE *f;
-#ifdef _WIN32
+#ifdef U_MEMSTREAM_TMPFILE
    char **bufp;
    size_t *sizep;
+#endif
+#ifdef _WIN32
    char temp[PATH_MAX];
 #endif
 };
diff --git a/src/util/os_file.c b/src/util/os_file.c
index 7d99383..ab45fcc 100644
--- a/src/util/os_file.c
+++ b/src/util/os_file.c
@@ -214,7 +214,7 @@ os_read_file(const char *filename, size_t *size)
 #include <sys/epoll.h>
 #endif
 
-#if DETECT_OS_DRAGONFLY || DETECT_OS_FREEBSD
+#if (DETECT_OS_DRAGONFLY || DETECT_OS_FREEBSD) && !defined(__ORBIS__)
 
 #include "macros.h" /* ARRAY_SIZE */
 
@@ -257,7 +257,7 @@ os_same_file_description(int fd1, int fd2)
 
 #ifdef SYS_kcmp
    return syscall(SYS_kcmp, pid, pid, KCMP_FILE, fd1, fd2);
-#elif DETECT_OS_DRAGONFLY || DETECT_OS_FREEBSD
+#elif (DETECT_OS_DRAGONFLY || DETECT_OS_FREEBSD) && !defined(__ORBIS__)
    int mib[] = { CTL_KERN, KERN_FILE };
    size_t len;
    if (sysctl(mib, ARRAY_SIZE(mib), NULL, &len, NULL, 0))
diff --git a/src/vulkan/runtime/vk_device.c b/src/vulkan/runtime/vk_device.c
index 1b422dc..67cc61c 100644
--- a/src/vulkan/runtime/vk_device.c
+++ b/src/vulkan/runtime/vk_device.c
@@ -877,13 +877,15 @@ vk_device_get_timestamp(struct vk_device *device, VkTimeDomainKHR domain,
       clockid = CLOCK_MONOTONIC;
       break;
    case VK_TIME_DOMAIN_CLOCK_MONOTONIC_RAW_KHR:
-      /* The "RAW" clocks on Linux are called "FAST" on FreeBSD */
+      /* The domain is defined as clock_gettime(CLOCK_MONOTONIC_RAW). FreeBSD's
+       * CLOCK_MONOTONIC_FAST is not that clock but CLOCK_MONOTONIC at tick
+       * granularity, which reads behind a precise reading taken before it (a
+       * FreeBSD-based console: dEQP-VK.pipeline.*.timestamp.calibrated.
+       * host_domain_test), so without CLOCK_MONOTONIC_RAW the domain is not
+       * offered. */
 #if defined(CLOCK_MONOTONIC_RAW)
       clockid = CLOCK_MONOTONIC_RAW;
       break;
-#elif defined(CLOCK_MONOTONIC_FAST)
-      clockid = CLOCK_MONOTONIC_FAST;
-      break;
 #else
       FALLTHROUGH;
 #endif
