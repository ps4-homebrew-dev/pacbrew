@@ -50,6 +50,14 @@
  * to the largest size it takes (sceGnmSetGsRingSizes, 4 to 8 MiB). */
 #define RADV_PS4_GS_RING_BYTES (UINT32_C(8) << 20)
 
+/* Tessellation's rings as the VGT uses them: VGT_HS_OFFCHIP_PARAM and
+ * VGT_TF_MEMORY_BASE are the system's too. The off-chip ring has 256
+ * workgroups' buffers (sceGnmGetOffChipTessellationBufferSize: 8 MiB, 32 KiB a
+ * workgroup), and the factor ring is at the system's address, where the
+ * platform maps this much memory (radv_ps4_tess_factor_ring_va). */
+#define RADV_PS4_TESS_OFFCHIP_WORKGROUPS 256
+#define RADV_PS4_TESS_FACTOR_RING_BYTES (UINT32_C(2) << 20)
+
 enum radv_ps4_memory_type {
    /* CPU write-combined: what the GPU reads fastest, and what the CPU should
     * only write. */
@@ -86,6 +94,11 @@ bool radv_ps4_platform_is_neo(void);
 /* The high word of the window's addresses. */
 uint32_t radv_ps4_address32_hi(void);
 
+/* The address of the tessellation factor ring the VGT reads, backed with
+ * RADV_PS4_TESS_FACTOR_RING_BYTES of memory; 0 where it could not be (and on
+ * the host, which runs no GPU). */
+uint64_t radv_ps4_tess_factor_ring_va(void);
+
 /* Why this thread's last radv_ps4_memory_alloc failed, or "". */
 const char *radv_ps4_memory_error(void);
 
diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
index b0dbffc..f479e03 100644
--- a/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_winsys.c
@@ -354,6 +354,19 @@ radv_ps4_describe_gpu(struct radeon_info *info, bool compiler_compat_mode)
    /* The VGT wraps the GS rings at the sizes the platform gave the system
     * (sceGnmSetGsRingSizes). */
    info->fixed_gs_ring_size = RADV_PS4_GS_RING_BYTES;
+   /* Tessellation's rings as the VGT uses them (radv_ps4_platform.h): RADV's
+    * count of off-chip buffers, 4 per CU, came to 72 here, and the hardware
+    * used all 256 of the system's -- measured in the orbis-ports mesa-ps4
+    * port with a poisoned ring, whose high-water mark was buffer 255 -- and
+    * wrote past the ring. The factor ring is the system's, and RADV's rings
+    * hold the off-chip one alone. */
+   info->hs_offchip_param = (info->hs_offchip_param & C_03093C_OFFCHIP_BUFFERING_GFX7) |
+                            S_03093C_OFFCHIP_BUFFERING_GFX7(RADV_PS4_TESS_OFFCHIP_WORKGROUPS);
+   info->tess_offchip_ring_size = RADV_PS4_TESS_OFFCHIP_WORKGROUPS * info->hs_offchip_workgroup_dw_size * 4;
+   info->fixed_tess_factor_ring_va = radv_ps4_tess_factor_ring_va();
+   info->fixed_tess_factor_ring_size = info->fixed_tess_factor_ring_va ? RADV_PS4_TESS_FACTOR_RING_BYTES : 0;
+   info->total_tess_ring_size =
+      info->tess_offchip_ring_size + (info->fixed_tess_factor_ring_va ? 0 : info->tess_factor_ring_size);
 
    /* What the platform, not the chip, rules out. */
    /* Nothing RADV records runs as an INDIRECT_BUFFER, so the command buffers
