diff --git a/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c
index 1c1af89..890c58a 100644
--- a/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c
+++ b/src/amd/vulkan/winsys/ps4/radv_ps4_platform.c
@@ -144,6 +144,10 @@ radv_ps4_submit_times(uint64_t times[2])
    (PS4_KERNEL_PROT_CPU_READ | PS4_KERNEL_PROT_CPU_WRITE | PS4_KERNEL_PROT_GPU_READ | PS4_KERNEL_PROT_GPU_WRITE)
 
 static bool radv_ps4_neo;
+static uint64_t radv_ps4_tess_factor_ring;
+
+static void radv_ps4_cpu_drop_lines(const void *address, uint64_t bytes);
+static void radv_ps4_tess_factor_ring_map(void);
 
 /* Whether a window of bytes at window holds 32-bit pointers: within one
  * 4 GiB block (at a multiple of its size, a power of two of at most 4 GiB)
@@ -231,9 +235,55 @@ radv_ps4_platform_once(void)
    const int gs_rings = sceGnmSetGsRingSizes(RADV_PS4_GS_RING_BYTES, RADV_PS4_GS_RING_BYTES);
    if (gs_rings)
       fprintf(stderr, "radv/ps4: sceGnmSetGsRingSizes failed: 0x%08x\n", (unsigned)gs_rings);
+
+   radv_ps4_tess_factor_ring_map();
    return true;
 }
 
+/* Backs the tessellation factor ring the VGT reads with memory. The VGT reads
+ * factors at the system's VGT_TF_MEMORY_BASE, which RADV's write does not
+ * change: the orbis-ports mesa-ps4 port found every tessellated draw dying on
+ * a texture-cache read at that address (0xff0000000 + 0x10000), and with
+ * memory there and the HS writing its factors there, 44 of 44 dEQP-VK
+ * tessellation cases passing. The address is mapped only if it is free. */
+static void
+radv_ps4_tess_factor_ring_map(void)
+{
+   const uint64_t at = sceGnmGetTheTessellationFactorRingBufferBaseAddress();
+   const uint64_t bytes = RADV_PS4_TESS_FACTOR_RING_BYTES;
+   if (!at || at % RADV_PS4_PAGE_BYTES || at + bytes > RADV_PS4_GPU_ADDRESS_LIMIT) {
+      fprintf(stderr, "radv/ps4: no tessellation factor ring: the system names 0x%" PRIx64 "\n", at);
+      return;
+   }
+   int64_t physical = 0;
+   if (sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), bytes, RADV_PS4_LARGE_BYTES,
+                                     PS4_KERNEL_WC_GARLIC, &physical)) {
+      fprintf(stderr, "radv/ps4: no memory for the tessellation factor ring\n");
+      return;
+   }
+   void *address = (void *)(uintptr_t)at;
+   const int err = sceKernelMapDirectMemory(&address, bytes, RADV_PS4_PROT_CPU_GPU_RW, 0, physical,
+                                            RADV_PS4_PAGE_BYTES);
+   if (err || (uint64_t)(uintptr_t)address != at) {
+      if (!err)
+         sceKernelMunmap(address, bytes);
+      sceKernelReleaseDirectMemory(physical, bytes);
+      fprintf(stderr, "radv/ps4: the tessellation factor ring's address 0x%" PRIx64 " is taken (0x%08x)\n", at,
+              (unsigned)err);
+      return;
+   }
+   radv_ps4_cpu_drop_lines(address, bytes);
+   memset(address, 0, bytes);
+   radv_ps4_cpu_flush(address, bytes);
+   radv_ps4_tess_factor_ring = at;
+}
+
+uint64_t
+radv_ps4_tess_factor_ring_va(void)
+{
+   return radv_ps4_tess_factor_ring;
+}
+
 bool
 radv_ps4_platform_runs_gpu(void)
 {
@@ -495,6 +545,13 @@ radv_ps4_platform_runs_gpu(void)
    return false;
 }
 
+uint64_t
+radv_ps4_tess_factor_ring_va(void)
+{
+   /* The model runs no GPU, and has no system ring to stand in for. */
+   return 0;
+}
