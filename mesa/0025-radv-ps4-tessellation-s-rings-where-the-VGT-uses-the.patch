 int32_t sceGnmSetGsRingSizes(uint32_t esgs_ring_bytes, uint32_t gsvs_ring_bytes);
+/* The address of the ring the VGT reads tessellation factors from
+ * (VGT_TF_MEMORY_BASE, the system's). A title backs it with memory of its own
+ * before it tessellates. */
+uint64_t sceGnmGetTheTessellationFactorRingBufferBaseAddress(void);
 
