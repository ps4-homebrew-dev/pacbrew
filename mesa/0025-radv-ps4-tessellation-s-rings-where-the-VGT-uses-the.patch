                        uint32_t esgs_ring_size, struct radeon_winsys_bo *esgs_ring_bo, uint32_t gsvs_ring_size,
@@ -304,8 +312,14 @@ radv_fill_shader_rings(struct radv_device *device, uint32_t *desc, struct radeon
    desc += 8;
 
    if (tess_rings_bo) {
-      radv_set_ring_buffer(pdev, tess_rings_bo, pdev->info.tess_offchip_ring_size, pdev->info.tess_factor_ring_size,
-                           false, false, true, 0, 0, &desc[0]);
+      if (pdev->info.fixed_tess_factor_ring_va) {
+         /* The factor ring the VGT reads, the system's. */
+         radv_set_ring_buffer_va(pdev, pdev->info.fixed_tess_factor_ring_va, pdev->info.fixed_tess_factor_ring_size,
+                                 false, false, true, 0, 0, &desc[0]);
+      } else {
