diff --git a/meson.build b/meson.build
index 65c8063..b58150c 100644
--- a/meson.build
+++ b/meson.build
@@ -509,6 +509,10 @@ endif
 # The console build, as opposed to a Linux host build of the PS4 winsys, which
 # models the console on a PC.
 with_radv_ps4_console = with_radv_ps4 and host_machine.system() != 'linux'
+# The system modules RADV and its WSI call. The shared library links their
+# stubs (it is linked with -Wl,--no-undefined), and pkg-config hands them to
+# the program too, so that its crt initializes them through libSceSysmodule.
+ps4_sysmodule_libs = with_radv_ps4_console ? ['-lSceGnmDriver', '-lSceVideoOut'] : []
 
 with_gfxstream_emulated_android = with_gfxstream_vk and with_platform_android and host_machine.system() == 'linux'
 if with_gfxstream_emulated_android
diff --git a/src/amd/vulkan/meson.build b/src/amd/vulkan/meson.build
index 3969ca0..df5765a 100644
--- a/src/amd/vulkan/meson.build
+++ b/src/amd/vulkan/meson.build
@@ -266,6 +266,14 @@ if with_platform_android
 endif
 
 radv_build_id = get_option('radv-build-id')
+# RADV names its shader cache after the build id of the binary it is in, found
+# through dl_iterate_phdr, which the console does not have; without a name RADV
+# has no device. So the console build is given its build id.
+if radv_build_id == '' and with_radv_ps4_console
+  error('The PS4 build needs -Dradv-build-id=<hex>, a hex string that changes ' +
+        'whenever the driver does (e.g. a SHA-1 of the Mesa version and the ' +
+        'patches): the console has no dl_iterate_phdr to identify the driver binary.')
+endif
 if radv_build_id != ''
   radv_flags += '-DRADV_BUILD_ID_OVERRIDE="' + radv_build_id + '"'
 endif
@@ -275,34 +283,76 @@ if radv_u_trace
   radv_flags += '-DRADV_U_TRACE=1'
 endif
 
-libvulkan_radeon = shared_library(
-  'vulkan_radeon',
-  [libradv_files, radv_entrypoints, radv_drirc, sha1_h, radix_sort_spv, bvh_spv, radv_annotate_layer],
-  vs_module_defs : vulkan_api_def,
