pkgname=ps4-homebrew-libfribidi
pkgver=1.0.15
pkgrel=1
pkgdesc='Free Implementation of the Unicode Bidirectional Algorithm'
arch=('any')
url="https://github.com/fribidi/fribidi"
license=('LGPL2.1')
options=(!strip !libtool staticlibs)
source=("https://github.com/fribidi/fribidi/releases/download/v$pkgver/fribidi-$pkgver.tar.xz")
sha256sums=('0bbc7ff633bfa208ae32d7e369cf5a7d20d5d2557a0b067c9aa98bcbf9967587')
makedepends=('ps4-homebrew-sdk')
groups=('ps4-homebrew-dev')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd fribidi-$pkgver

    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--enable-static --disable-shared
    ${MAKE}
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd fribidi-$pkgver

    export DESTDIR="${pkgdir}/${SYSROOT}"
    make install
}
