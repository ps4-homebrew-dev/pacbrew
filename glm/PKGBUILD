pkgname=ps4-homebrew-glm
pkgver=1.0.1
pkgrel=1
pkgdesc="C++ mathematics library for 3D software based on the OpenGL Shading Language (GLSL) specification"
arch=('any')
license=('MIT')
url="http://glm.g-truc.net"
options=(!strip !libtool staticlibs)
source=("https://github.com/g-truc/glm/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('9f3174561fd26904b23f0db5e560971cbf9b3cbda0b280f04d5c379d03bf234c')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-libcxx')
groups=('ps4-homebrew-dev')


prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd glm-$pkgver

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
	     -DGLM_BUILD_TESTS=NO \
	     -B build \
             -S .
    ${MAKE} -C build
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd glm-$pkgver

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} -C build install
}
