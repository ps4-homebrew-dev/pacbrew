pkgname=ps4-homebrew-vulkan-headers
pkgver=1.3.302
pkgrel=1
pkgdesc='Vulkan header files and API registry'
arch=('any')
url='https://github.com/KhronosGroup/Vulkan-Headers'
license=('Apache-2.0 OR MIT')
options=(!strip libtool staticlibs)
source=("https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('996c3f4220971e3b3cd6b8933e9e81f0bc82b6d2d6449b6f02c66946d65bf944')
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd Vulkan-Headers-$pkgver

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
	     -DVULKAN_HEADERS_ENABLE_MODULE=OFF \
	     -DVULKAN_HEADERS_ENABLE_TESTS=OFF \
	     -B build \
	     -S .
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd Vulkan-Headers-$pkgver

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} -C build install
}
