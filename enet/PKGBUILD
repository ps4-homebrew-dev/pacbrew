pkgname=ps4-homebrew-enet
pkgver=1.3.18
pkgrel=1
pkgdesc='A relatively thin, simple and robust network communication layer on top of UDP'
arch=('any')
url='http://enet.bespin.org/'
license=('custom')
options=(!strip !libtool staticlibs)
source=("http://enet.bespin.org/download/enet-${pkgver}.tar.gz")
sha256sums=('2a8a0c5360d68bb4fcd11f2e4c47c69976e8d2c85b109dd7d60b1181a4f85d36')

groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk')


prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd enet-${pkgver}

    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--disable-shared --enable-static 
    ${MAKE}
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd enet-${pkgver}

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} install
}
