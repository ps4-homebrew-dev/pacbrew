pkgname=ps4-homebrew-sdl2_image
pkgver=2.8.2
pkgrel=1
pkgdesc='SDL2 image loading library.'
arch=('any')
url='https://libsdl.org/projects/SDL_image'
license=('zlib')
options=(!strip !libtool staticlibs)
source=("https://github.com/libsdl-org/SDL_image/releases/download/release-${pkgver}/SDL2_image-${pkgver}.tar.gz")
sha256sums=('8f486bbfbcf8464dd58c9e5d93394ab0255ce68b51c5a966a918244820a76ddc')
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-openlibm')
depends=('ps4-homebrew-sdl2'
	 'ps4-homebrew-libpng'
	 'ps4-homebrew-libjpeg-turbo'
	 'ps4-homebrew-libwebp')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd SDL2_image-$pkgver

    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--enable-static --disable-shared
    ${MAKE}
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd SDL2_image-$pkgver

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} install

    # Autotools builds with --disable-shared only define SDL2_image::SDL2_image-static.
    # Provide SDL2_image::SDL2_image too, like SDL2's own config does for static-only builds.
    cat >> "${DESTDIR}/usr/lib/cmake/SDL2_image/sdl2_image-config.cmake" <<'CMAKE_EOF'

if(TARGET SDL2_image::SDL2_image-static AND NOT TARGET SDL2_image::SDL2_image)
  add_library(SDL2_image::SDL2_image ALIAS SDL2_image::SDL2_image-static)
endif()
CMAKE_EOF
}
