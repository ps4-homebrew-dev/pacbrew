pkgname=ps4-homebrew-giflib
pkgver=5.2.2
pkgrel=1
pkgdesc='Library for reading and writing gif images'
url='http://giflib.sourceforge.net/'
arch=('any')
license=('MIT')
source=("https://downloads.sourceforge.net/project/giflib/giflib-5.x/giflib-${pkgver}.tar.gz")
sha256sums=('be7ffbd057cadebe2aa144542fd90c6838c6a083b5e8a9048b8ee3b66b29d5fb')
groups=('ps4-homebrew-dev')
options=(!strip !libtool staticlibs)
makedepends=('ps4-homebrew-sdk')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd giflib-${pkgver}

    ${MAKE} libgif.a
}


package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd giflib-${pkgver}

    export DESTDIR="${pkgdir}/${SYSROOT}/${PREFIX}"
    install -d "${DESTDIR}/lib"
    install -d "${DESTDIR}/include"
    install -m 644 libgif.a "${DESTDIR}/lib"
    install -m 644 gif_lib.h "${DESTDIR}/include"
}
