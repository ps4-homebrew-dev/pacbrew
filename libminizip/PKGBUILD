pkgname=ps4-homebrew-libminizip
pkgver=1.4
pkgrel=1
pkgdesc='Deflate compression method library'
arch=('any')
url='http://www.zlib.net/'
license=('zlib')
options=(!strip !libtool staticlibs)
source=("https://github.com/madler/zlib/releases/download/v$pkgver/zlib-$pkgver.tar.gz")
sha256sums=('02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584')
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-zlib')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
    cd zlib-$pkgver/contrib/minizip
    sed -i 's|ioapi.h|ioapi.h ints.h|g' Makefile.am
    autoreconf --force --verbose --install
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd zlib-$pkgver/contrib/minizip

    ./configure --prefix="${PREFIX}" --host=x86_64
    ${MAKE}
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd zlib-$pkgver/contrib/minizip

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} install
}
