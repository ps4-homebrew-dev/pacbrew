pkgname=ps4-homebrew-lz4
pkgver=1.10.0
pkgrel=1
pkgdesc='Extremely fast compression algorithm'
arch=('any')
url='https://lz4.github.io/lz4/'
license=('GPL-2.0-or-later')
source=("https://github.com/lz4/lz4/releases/download/v$pkgver/lz4-$pkgver.tar.gz")
sha256sums=('537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b')
options=(!strip !libtool staticlibs)
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd lz4-$pkgver

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
	     -DLZ4_BUILD_CLI=NO \
	     -B build \
             -S build/cmake
    ${MAKE} -C build
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd lz4-$pkgver

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} -C build install
}
