pkgname=ps4-homebrew-libdeflate
pkgver=1.19
pkgrel=1
pkgdesc='Heavily optimized library for DEFLATE/zlib/gzip compression and decompression'
arch=('any')
url='https://github.com/ebiggers/libdeflate'
license=('MIT')
options=(!strip !libtool staticlibs)
source=("https://github.com/ebiggers/libdeflate/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
groups=('ps4-homebrew-dev')
makedepends=('ps4-homebrew-sdk')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd libdeflate-$pkgver

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
	     -DLIBDEFLATE_BUILD_STATIC_LIB=YES \
	     -DLIBDEFLATE_BUILD_SHARED_LIB=NO \
	     -B build \
             -S .
    ${MAKE} -C build
}


package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd libdeflate-$pkgver


    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} -C build install
}
