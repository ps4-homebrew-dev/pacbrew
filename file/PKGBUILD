pkgname=ps4-homebrew-file
pkgver=5.46
pkgrel=1
pkgdesc='File type identification utility'
arch=('any')
license=('custom')
url='https://www.darwinsys.com/file/'
options=(!strip !libtool staticlibs)
source=("https://astron.com/pub/file/file-$pkgver.tar.gz")
sha256sums=('c9cc77c7c560c543135edc555af609d5619dbef011997e988ce40a3d75d86088')
makedepends=('ps4-homebrew-sdk' 'ps4-homebrew-openlibm')
depends=('ps4-homebrew-zlib' 'ps4-homebrew-xz' 'ps4-homebrew-bzip2')
groups=('ps4-homebrew-dev')

prepare() {
    if [ -z "${PS4_HOMEBREW_SDK}" ]; then
	export PS4_HOMEBREW_SDK=/opt/ps4-homebrew-sdk
    fi
}

build() {
    cd file-$pkgver

    # When cross-compiling, build system needs the same version of file as the target
    ./configure --prefix="$PWD/host"
    make install V=1
    export FILE_COMPILE=$PWD/host/bin/file
    make distclean

    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--enable-static --disable-shared
    ${MAKE} V=1
}

package() {
    source "${PS4_HOMEBREW_SDK}/toolchain/orbis.sh"
    cd file-$pkgver

    export DESTDIR="${pkgdir}/${SYSROOT}"
    ${MAKE} install
}
